@using SAVI.Core.Enums

<div class="savi-core-container core-state-@VoiceState.ToString().ToLowerInvariant() @(ReducedMotion ? "savi-reduced-motion" : "")">
    <svg class="savi-core-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <!-- Cyan Glow Filter -->
            <filter id="core-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="3" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
            </filter>
            <!-- Radial Gradient Core -->
            <radialGradient id="core-gradient" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#00f0ff" stop-opacity="0.8" />
                <stop offset="60%" stop-color="#0066cc" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#070b14" stop-opacity="0" />
            </radialGradient>
        </defs>

        <!-- Outer Decorative Telemetry Ring -->
        <circle cx="100" cy="100" r="92" fill="none" stroke="rgba(0, 240, 255, 0.15)" stroke-width="1" stroke-dasharray="4 8" />

        <!-- Outer Rotating Ring with Notches -->
        <g class="core-ring-outer">
            <circle cx="100" cy="100" r="82" fill="none" stroke="#00f0ff" stroke-width="1.5" stroke-dasharray="60 30 10 30 90 20" filter="url(#core-glow)" />
            <circle cx="100" cy="18" r="3" fill="#00f0ff" />
            <circle cx="100" cy="182" r="3" fill="#00f0ff" />
        </g>

        <!-- Middle Counter-Rotating Ring -->
        <g class="core-ring-inner">
            <circle cx="100" cy="100" r="62" fill="none" stroke="#0099ff" stroke-width="2" stroke-dasharray="40 15 20 15" />
            <line x1="38" y1="100" x2="48" y2="100" stroke="#00f0ff" stroke-width="2" />
            <line x1="152" y1="100" x2="162" y2="100" stroke="#00f0ff" stroke-width="2" />
        </g>

        <!-- Innermost Data Ring -->
        <circle cx="100" cy="100" r="44" fill="none" stroke="rgba(0, 240, 255, 0.4)" stroke-width="1" stroke-dasharray="2 6" />

        <!-- Central Core Pulsing Orb -->
        <circle class="core-center-pulse" cx="100" cy="100" r="30" fill="url(#core-gradient)" stroke="#00f0ff" stroke-width="1.5" filter="url(#core-glow)" />

        <!-- Center SAVI Emblem Text -->
        <text x="100" y="104" text-anchor="middle" fill="#ffffff" font-size="11" font-weight="700" letter-spacing="2" font-family="'JetBrains Mono', monospace">SAVI</text>
    </svg>

    <div class="savi-glow-text" style="font-size: 0.85rem; margin-top: 10px; letter-spacing: 1.5px; text-transform: uppercase;">
        @GetStatusCaption()
    </div>
</div>

@code {
    [Parameter]
    public VoiceState VoiceState { get; set; } = VoiceState.Idle;

    [Parameter]
    public bool ReducedMotion { get; set; } = false;

    private string GetStatusCaption() => VoiceState switch
    {
        VoiceState.Idle => "System Online • Standing By",
        VoiceState.Listening => "Listening • Continuous Audio Active",
        VoiceState.DetectingSpeech => "Speech Detected • Transcribing",
        VoiceState.Processing => "Processing Intent • Reasoning",
        VoiceState.Searching => "Querying Knowledge Base",
        VoiceState.Executing => "Executing Tool Pipeline",
        VoiceState.Speaking => "Speaking • Transmitting",
        VoiceState.Interrupted => "Interrupted • Listening Resumed",
        VoiceState.Stopping => "Stopping Voice Session",
        VoiceState.Error => "Attention • Diagnostics Logged",
        _ => "SAVI Core Active"
    };
}
