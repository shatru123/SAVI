using SAVI.Core.Models;
using SAVI.Core.Enums;

@if (ApprovalRequest != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 9999;">
        <div class="savi-glass-panel savi-hud-bracket" style="width: 520px; max-width: 90%; padding: 24px; border-color: var(--savi-warning);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
                <span style="color: var(--savi-warning); font-size: 1.4rem;">⚠</span>
                <span class="savi-glow-text" style="font-size: 1.1rem; color: var(--savi-warning);">
                    PERMISSION CONFIRMATION REQUIRED
                </span>
            </div>

            <div style="font-size: 0.9rem; margin-bottom: 16px; line-height: 1.5; color: var(--savi-text-primary);">
                @ApprovalRequest.Description
            </div>

            <div style="font-size: 0.75rem; color: var(--savi-text-secondary); margin-bottom: 24px; padding: 10px; background: rgba(0,0,0,0.3); border-radius: 4px;">
                <strong>Classification:</strong> @ApprovalRequest.PermissionLevel.ToString().ToUpperInvariant()<br/>
                <strong>Tool:</strong> @ApprovalRequest.ToolName<br/>
                <strong>Action ID:</strong> @ApprovalRequest.ActionId[..8]...
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button class="savi-btn" style="border-color: var(--savi-text-dim); color: var(--savi-text-secondary);" @onclick="() => OnDecision.InvokeAsync(false)">
                    Cancel
                </button>
                <button class="savi-btn @(ApprovalRequest.PermissionLevel == PermissionLevel.Dangerous ? "savi-btn-danger" : "")" @onclick="() => OnDecision.InvokeAsync(true)">
                    Approve Execution
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public ActionApprovalRequest? ApprovalRequest { get; set; }

    [Parameter]
    public EventCallback<bool> OnDecision { get; set; }
}
