<div class="savi-glass-panel savi-hud-bracket" style="padding: 16px; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 8px; margin-bottom: 12px;">
        <span class="savi-glow-text" style="font-size: 0.85rem; letter-spacing: 1px;">SAVI ACTIVITY TELEMETRY</span>
        <button class="savi-btn" style="padding: 2px 8px; font-size: 0.75rem;" @onclick="OnClose">Close</button>
    </div>

    <div style="flex: 1; overflow-y: auto; font-size: 0.8rem; display: flex; flex-direction: column; gap: 8px;">
        @if (Logs.Count == 0)
        {
            <div style="color: var(--savi-text-dim); text-align: center; margin-top: 20px;">
                Awaiting agent pipeline execution...
            </div>
        }
        else
        {
            @foreach (var log in Logs)
            {
                <div style="padding: 6px 10px; background: rgba(0, 240, 255, 0.03); border-left: 2px solid var(--savi-cyan); border-radius: 2px;">
                    @log
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<string> Logs { get; set; } = Array.Empty<string>();

    [Parameter]
    public EventCallback OnClose { get; set; }
}
