@using SAVI.Application.Interfaces
@inject NavigationManager Navigation

@if (IsOpen)
{
    <div class="savi-drawer-backdrop active" style="z-index: 2500; display: flex; align-items: center; justify-content: center; padding: 16px;" @onclick="OnClose">
        <div class="savi-glass-panel savi-hud-bracket" style="max-width: 440px; width: 100%; padding: 32px 24px; text-align: center; box-sizing: border-box; box-shadow: 0 12px 48px rgba(0, 0, 0, 0.7), inset 0 0 16px rgba(0, 240, 255, 0.08);" @onclick:stopPropagation="true">
            <!-- Reactor Logo -->
            <div style="margin-bottom: 14px;">
                <SaviLogo Size="36" Animated="true" />
            </div>

            <!-- SAVI Title -->
            <div class="savi-glow-text" style="font-size: 1.1rem; font-weight: 800; letter-spacing: 3px; margin-bottom: 8px;">
                SAVI
            </div>

            <!-- Feature Title -->
            <h2 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0 0 10px 0; letter-spacing: 1px;">
                @Title
            </h2>

            <!-- Contextual Explanation -->
            <p style="font-size: 0.82rem; color: var(--savi-text-secondary); line-height: 1.5; margin: 0 0 24px 0; font-family: var(--savi-font);">
                @Message
            </p>

            <!-- Action Buttons -->
            <div style="display: flex; gap: 10px; margin-bottom: 16px;">
                <a href="@GetLoginUrl()" class="savi-btn savi-btn-primary" style="flex: 1; text-decoration: none; text-align: center; font-size: 0.8rem; font-weight: 700; letter-spacing: 1px;">
                    LOG IN
                </a>
                <a href="@GetRegisterUrl()" class="savi-btn" style="flex: 1; text-decoration: none; text-align: center; font-size: 0.8rem; font-weight: 700; letter-spacing: 1px; border-color: var(--savi-cyan); color: var(--savi-cyan);">
                    CREATE ACCOUNT
                </a>
            </div>

            <!-- Maybe Later -->
            <button @onclick="OnClose" style="background: none; border: none; color: var(--savi-text-dim); font-size: 0.75rem; font-family: var(--savi-font); cursor: pointer; text-decoration: underline;">
                Maybe later
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Personal AI Capabilities";
    [Parameter] public string Message { get; set; } = "Sign in to unlock personalized memory, autonomous agent tasks, and persistent voice history.";
    [Parameter] public string? ReturnUrl { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }

    private string GetLoginUrl()
    {
        var target = ReturnUrl ?? Navigation.Uri;
        return $"/login?returnUrl={Uri.EscapeDataString(target)}";
    }

    private string GetRegisterUrl()
    {
        var target = ReturnUrl ?? Navigation.Uri;
        return $"/register?returnUrl={Uri.EscapeDataString(target)}";
    }

    private async Task OnClose()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
        await OnDismiss.InvokeAsync();
    }
}
