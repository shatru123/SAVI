@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="savi-app-shell">
    <!-- Clean Top Header -->
    <header class="savi-app-header" style="height: 50px; background: rgba(7, 11, 20, 0.95); border-bottom: 1px solid var(--savi-border-subtle); display: flex; align-items: center; justify-content: space-between; padding: 0 16px; z-index: 1000; box-sizing: border-box;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <!-- Mobile Hamburger Button -->
            <button class="savi-btn savi-btn-sm savi-mobile-only" style="padding: 4px 8px; line-height: 1;" @onclick="ToggleDrawer" title="Toggle Navigation & Chats">
                ☰
            </button>
            <SaviLogo Size="26" Animated="false" />
            <span class="savi-glow-text" style="font-weight: 800; font-size: 0.95rem; letter-spacing: 1.5px;">SAVI</span>
            <span class="savi-badge" style="color: var(--savi-success); border-color: rgba(0,255,170,0.3); font-size: 0.65rem; padding: 2px 6px;">
                ● ONLINE
            </span>
        </div>

        <!-- Right Header Actions -->
        <div style="display: flex; align-items: center; gap: 10px;">
            <!-- Mobile Voice Quick Action if not already on voice -->
            <div class="savi-mobile-only">
                <a href="voice" class="savi-btn savi-btn-sm savi-btn-primary" style="text-decoration: none; padding: 4px 10px; font-size: 0.74rem;" title="Open Dedicated Voice Mode">
                    🎙️ Voice
                </a>
            </div>

            <!-- Desktop Clean Info -->
            <div class="savi-desktop-only" style="align-items: center; gap: 12px; font-size: 0.75rem; color: var(--savi-text-dim);">
                <a href="voice" class="savi-btn savi-btn-sm savi-btn-primary" style="text-decoration: none; padding: 4px 12px; font-size: 0.76rem;" title="Open Dedicated Voice Screen">
                    🎙️ Voice Screen
                </a>
            </div>
        </div>
    </header>

    <!-- Main Workspace -->
    <div class="savi-workspace" style="display: flex; flex: 1; overflow: hidden; position: relative;">
        <!-- Backdrop Scrim for Mobile Drawer -->
        <div class="savi-drawer-backdrop @(_mainDrawerOpen ? "active" : "")" @onclick="CloseDrawer"></div>

        <!-- Unified Left Sidebar (Static Aside on Desktop >= 992px / Slide-over Drawer on Mobile < 992px) -->
        <aside class="savi-main-sidebar @(_mainDrawerOpen ? "open" : "")" style="width: 280px; min-width: 280px; padding: 10px; height: calc(100vh - 50px); height: calc(100dvh - 50px); box-sizing: border-box;">
            <NavMenu ShowCloseButton="_mainDrawerOpen" OnClose="CloseDrawer" OnNavigate="CloseDrawer" />
        </aside>

        <!-- Main Center Stage -->
        <main class="savi-main-content" style="flex: 1; padding: 12px; height: calc(100vh - 50px); height: calc(100dvh - 50px); box-sizing: border-box; overflow-y: auto;">
            @Body
        </main>
    </div>

    <!-- Pinned Cybernetic Mobile Bottom Navigation Bar (Docked Native App Bar) -->
    <nav class="savi-bottom-nav">
        <NavLink class="savi-bottom-nav-item" href="chat" Match="NavLinkMatch.Prefix">
            <span class="nav-icon">💬</span>
            <span>Chat</span>
        </NavLink>
        <NavLink class="savi-bottom-nav-item savi-bottom-voice-item" href="voice" Match="NavLinkMatch.Prefix">
            <div class="savi-voice-bottom-orb">
                <span class="nav-icon" style="font-size: 1.25rem;">🎙</span>
            </div>
            <span style="font-weight: 700;">Voice</span>
        </NavLink>
        <NavLink class="savi-bottom-nav-item" href="tasks" Match="NavLinkMatch.Prefix">
            <span class="nav-icon">⚙</span>
            <span>Tasks</span>
        </NavLink>
        <button class="savi-bottom-nav-item" style="background: transparent; border: none; cursor: pointer; font-family: var(--savi-font);" @onclick="ToggleDrawer">
            <span class="nav-icon">⋯</span>
            <span>More</span>
        </button>
    </nav>
</div>

@code {
    private bool _mainDrawerOpen = false;

    private void ToggleDrawer()
    {
        _mainDrawerOpen = !_mainDrawerOpen;
    }

    private void CloseDrawer()
    {
        _mainDrawerOpen = false;
    }
}
