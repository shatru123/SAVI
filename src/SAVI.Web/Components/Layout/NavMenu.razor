@inject ISettingsService SettingsService
@inject IJSRuntime JS

<div class="savi-glass-panel savi-hud-bracket" style="padding: 16px; height: 100%; display: flex; flex-direction: column; gap: 14px; box-sizing: border-box;">
    <!-- Logo & Brand -->
    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 14px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <SaviLogo Size="36" Animated="true" />
            <div>
                <div class="savi-glow-text" style="font-weight: 700; font-size: 1.1rem; letter-spacing: 2.5px;">SAVI</div>
                <div style="font-size: 0.65rem; color: var(--savi-text-dim); letter-spacing: 0.6px;">VIRTUAL INTELLIGENCE</div>
            </div>
        </div>
        @if (ShowCloseButton)
        {
            <button class="savi-btn" style="padding: 4px 8px; font-size: 0.85rem; border-radius: 4px; line-height: 1;" @onclick="CloseDrawer" title="Close Menu">✕</button>
        }
    </div>

    <!-- Navigation links -->
    <nav style="display: flex; flex-direction: column; gap: 6px; flex: 1; overflow-y: auto;">
        <NavLink class="savi-nav-item" href="" Match="NavLinkMatch.All" @onclick="HandleNavClick">
            <span class="savi-icon">◈</span> Command Deck
        </NavLink>

        <!-- SAVI Voice Assistant Quick Options Card -->
        <div class="savi-voice-menu-card" style="background: linear-gradient(135deg, rgba(0, 240, 255, 0.08) 0%, rgba(59, 130, 246, 0.05) 100%); border: 1px solid rgba(0, 240, 255, 0.28); border-radius: 8px; padding: 10px; margin: 4px 0; display: flex; flex-direction: column; gap: 8px; box-shadow: 0 0 14px rgba(0, 240, 255, 0.08);">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 0.95rem; color: #00f0ff;">🎙️</span>
                    <span style="font-size: 0.72rem; font-weight: 700; color: #00f0ff; letter-spacing: 0.8px; text-transform: uppercase;">Voice Assistant</span>
                </div>
                <span class="savi-badge" style="color: #00f0ff; border-color: rgba(0, 240, 255, 0.4); background: rgba(0, 240, 255, 0.12); font-size: 0.6rem; padding: 1px 5px;">LIVE</span>
            </div>

            <!-- Dedicated Voice Screen Link -->
            <NavLink class="savi-btn" href="voice" @onclick="HandleNavClick" style="justify-content: center; font-size: 0.76rem; font-weight: 700; padding: 6px 10px; background: rgba(0, 240, 255, 0.18); border-color: rgba(0, 240, 255, 0.5); color: #00f0ff; text-decoration: none; display: flex; align-items: center; gap: 6px; border-radius: 5px;">
                <span>🎙️ Real-Time Voice Screen</span>
            </NavLink>

            <!-- Voice Controls Row -->
            <div style="display: flex; gap: 6px;">
                <button class="savi-btn @(_voiceEnabled ? "active-voice-btn" : "")" style="flex: 1; font-size: 0.72rem; padding: 5px 6px; justify-content: center;" @onclick="ToggleVoiceOutput" title="Toggle voice talk-back (spoken responses)">
                    @(_voiceEnabled ? "🔊 Voice: ON" : "🔇 Voice: OFF")
                </button>
                <button class="savi-btn" style="flex: 1; font-size: 0.72rem; padding: 5px 6px; justify-content: center;" @onclick="TestAudioAsync" title="Test audio volume and unlock mobile audio">
                    @(_isTestingAudio ? "⚡ Testing..." : "🧪 Test Audio")
                </button>
            </div>

            <!-- Acoustic Mode Selector -->
            <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.68rem; color: var(--savi-text-dim); padding: 2px 2px 0;">
                <span>Acoustic Output:</span>
                <button class="savi-btn" style="padding: 2px 8px; font-size: 0.66rem; border-radius: 4px;" @onclick="ToggleAudioMode" title="Toggle between Speaker Mode (echo filter active) and Headphone Mode">
                    @(_audioOutputMode == "speaker" ? "🔊 Speaker" : "🎧 Headphone")
                </button>
            </div>
        </div>

        <NavLink class="savi-nav-item" href="memory" @onclick="HandleNavClick">
            <span class="savi-icon">🧠</span> Long-Term Memory
        </NavLink>
        <NavLink class="savi-nav-item" href="tasks" @onclick="HandleNavClick">
            <span class="savi-icon">⚙</span> Task Matrix
        </NavLink>
        <NavLink class="savi-nav-item" href="providers" @onclick="HandleNavClick">
            <span class="savi-icon">📡</span> Provider Registry
        </NavLink>
        <NavLink class="savi-nav-item" href="diagnostics" @onclick="HandleNavClick">
            <span class="savi-icon">📊</span> Telemetry Diagnostics
        </NavLink>
        <NavLink class="savi-nav-item" href="audit" @onclick="HandleNavClick">
            <span class="savi-icon">🛡</span> Security & Audit
        </NavLink>
        <NavLink class="savi-nav-item" href="settings" @onclick="HandleNavClick">
            <span class="savi-icon">⚙</span> Configuration
        </NavLink>
    </nav>

    <!-- Creator Details & System Status -->
    <div style="border-top: 1px solid var(--savi-border-subtle); padding-top: 10px; display: flex; flex-direction: column; gap: 8px;">
        <div style="font-size: 0.62rem; letter-spacing: 1px; color: var(--savi-text-dim); text-transform: uppercase; display: flex; align-items: center; justify-content: space-between;">
            <span>CREATOR</span>
            <span style="color: var(--savi-success); font-size: 0.6rem;">● ARCHITECT</span>
        </div>

        <div style="background: rgba(0, 240, 255, 0.04); border: 1px solid var(--savi-border-subtle); border-radius: 6px; padding: 8px; display: flex; align-items: center; gap: 8px;">
            <div style="width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, #00f0ff, #7928ca); display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.75rem; color: #fff; box-shadow: 0 0 8px rgba(0, 240, 255, 0.4); flex-shrink: 0;">
                SA
            </div>
            <div style="flex: 1; min-width: 0; line-height: 1.25;">
                <div style="font-size: 0.78rem; font-weight: bold; color: var(--savi-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    Shatrughna Ambhore
                </div>
                <div style="font-size: 0.64rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <a href="mailto:ambhoreshatrughna@gmail.com" style="color: var(--savi-cyan); text-decoration: none;" title="ambhoreshatrughna@gmail.com">
                        ✉ ambhoreshatrughna@gmail.com
                    </a>
                </div>
                <div style="font-size: 0.64rem;">
                    <a href="tel:+919604466334" style="color: var(--savi-text-secondary); text-decoration: none;" title="+91 9604466334">
                        📞 +91 9604466334
                    </a>
                </div>
            </div>
        </div>

        <div style="font-size: 0.68rem; color: var(--savi-text-dim); display: flex; align-items: center; justify-content: space-between;">
            <span style="color: var(--savi-success);">● ZERO-COST CORE</span>
            <span>.NET 10</span>
        </div>
    </div>
</div>

<style>
.savi-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    color: var(--savi-text-secondary);
    text-decoration: none;
    font-size: 0.86rem;
    border-radius: 4px;
    border: 1px solid transparent;
    transition: all 0.2s ease;
}
.savi-nav-item:hover, .savi-nav-item.active {
    color: var(--savi-cyan);
    background: rgba(0, 240, 255, 0.08);
    border-color: var(--savi-border-subtle);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.15);
}
.savi-icon {
    font-size: 1rem;
}
</style>

@code {
    [Parameter]
    public bool ShowCloseButton { get; set; } = false;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private bool _voiceEnabled = true;
    private string _audioOutputMode = "speaker";
    private bool _isTestingAudio = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await SettingsService.GetSettingsAsync();
            _voiceEnabled = settings.VoiceEnabled;
        }
        catch { }
    }

    private async Task ToggleVoiceOutput()
    {
        _voiceEnabled = !_voiceEnabled;
        try
        {
            var settings = await SettingsService.GetSettingsAsync();
            settings.VoiceEnabled = _voiceEnabled;
            await SettingsService.UpdateSettingsAsync(settings);
            if (!_voiceEnabled)
            {
                await JS.InvokeVoidAsync("saviVoice.stopSpeaking");
            }
        }
        catch { }
        StateHasChanged();
    }

    private async Task TestAudioAsync()
    {
        _isTestingAudio = true;
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("saviVoice.testAudio");
        }
        catch { }
        await Task.Delay(1200);
        _isTestingAudio = false;
        StateHasChanged();
    }

    private async Task ToggleAudioMode()
    {
        _audioOutputMode = _audioOutputMode == "speaker" ? "headphone" : "speaker";
        try
        {
            await JS.InvokeVoidAsync("saviVoice.setAudioOutputMode", _audioOutputMode);
        }
        catch { }
        StateHasChanged();
    }

    private async Task CloseDrawer()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleNavClick()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }
}
