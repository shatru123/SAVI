                    <div style="font-weight: bold; color: var(--savi-cyan); margin-bottom: 4px;">Creator &amp; Architect:</div>
                    <div>Shatrughna Ambhore</div>
                    <div><a href="mailto:ambhoreshatrughna@gmail.com" style="color: var(--savi-cyan); text-decoration: none;">✉ ambhoreshatrughna@gmail.com</a></div>
                    <div><a href="tel:+919604466334" style="color: var(--savi-text-secondary); text-decoration: none;">📞 +91 9604466334</a></div>
                </div>
            </div>
        </div>
    </div>
}

<style>
.savi-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    color: var(--savi-text-secondary);
    text-decoration: none;
