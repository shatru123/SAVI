</style>

@code {
    [Parameter]
    public bool ShowCloseButton { get; set; } = false;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private List<ConversationSummaryDto> _conversations = new();
    private List<ConversationSummaryDto> _todayConversations = new();
    private List<ConversationSummaryDto> _yesterdayConversations = new();
    private List<ConversationSummaryDto> _pastWeekConversations = new();
    private List<ConversationSummaryDto> _olderConversations = new();

    private string _searchQuery = string.Empty;
    private string? _currentConvId;
    private bool _showMoreMenu = false;
    private bool _showAboutModal = false;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        ExtractCurrentConvId();
        Navigation.LocationChanged += HandleLocationChanged;
        await LoadConversationsAsync();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ExtractCurrentConvId();
        InvokeAsync(StateHasChanged);
    }

    private void ExtractCurrentConvId()
    {
        var convId = SaviRouteHelper.ExtractConversationId(Navigation.Uri);
        if (!string.IsNullOrWhiteSpace(convId))
        {
            _currentConvId = convId;
        }
    }

    private async Task LoadConversationsAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_searchQuery))
            {
                _conversations = (await ConversationService.GetSummariesAsync()).ToList();
            }
            else
            {
                _conversations = (await ConversationService.SearchAsync(_searchQuery)).ToList();
            }
            GroupConversations();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"NavMenu load error: {ex}");
        }
        StateHasChanged();
    }

    private void GroupConversations()
    {
        var now = DateTimeOffset.UtcNow;
        var today = now.Date;
        var yesterday = today.AddDays(-1);
        var weekAgo = today.AddDays(-7);

        _todayConversations = _conversations.Where(c => c.UpdatedAt.UtcDateTime.Date == today).ToList();
        _yesterdayConversations = _conversations.Where(c => c.UpdatedAt.UtcDateTime.Date == yesterday).ToList();
        _pastWeekConversations = _conversations.Where(c => c.UpdatedAt.UtcDateTime.Date < yesterday && c.UpdatedAt.UtcDateTime.Date >= weekAgo).ToList();
        _olderConversations = _conversations.Where(c => c.UpdatedAt.UtcDateTime.Date < weekAgo).ToList();
    }

    private async Task CreateNewChat()
    {
        try
        {
            var newConv = await ConversationService.GetOrCreateAsync(null);
            _currentConvId = newConv.Id;
            var isVoice = SaviRouteHelper.IsVoiceRoute(Navigation.Uri);
            var target = isVoice ? SaviRouteHelper.BuildVoiceRoute(newConv.Id) : SaviRouteHelper.BuildChatRoute(newConv.Id);
            Navigation.NavigateTo(target);
            await LoadConversationsAsync();
            await HandleNavClick();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Create chat error: {ex}");
        }
    }

    private async Task SelectConversation(string id)
    {
        _currentConvId = id;
        var isVoice = SaviRouteHelper.IsVoiceRoute(Navigation.Uri);
        var target = isVoice ? SaviRouteHelper.BuildVoiceRoute(id) : SaviRouteHelper.BuildChatRoute(id);
        Navigation.NavigateTo(target);
        await HandleNavClick();
    }

    private async Task DeleteConversation(string id)
    {
        try
        {
            await ConversationService.DeleteAsync(id);
            if (_currentConvId == id)
            {
                _currentConvId = null;
                var isVoice = SaviRouteHelper.IsVoiceRoute(Navigation.Uri);
                Navigation.NavigateTo(isVoice ? "/voice" : "/chat");
            }
            await LoadConversationsAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Delete error: {ex}");
        }
    }

    private async Task FilterConversations()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await LoadConversationsAsync();
        }
        catch (OperationCanceledException) { }
    }

    private async Task ClearSearch()
    {
        _searchQuery = string.Empty;
        await LoadConversationsAsync();
    }

    private RenderFragment RenderGroup(string title, List<ConversationSummaryDto> items) => __builder =>
    {
        if (items.Count == 0) return;

        <div style="display: flex; flex-direction: column; gap: 2px;">
            <div class="savi-conv-group-title">@title</div>
            @foreach (var c in items)
            {
                var isCurrent = c.Id == _currentConvId;
                <div class="savi-conv-link @(isCurrent ? "active" : "")" @onclick="() => SelectConversation(c.Id)">
                    <div style="flex: 1; min-width: 0;">
                        <div class="savi-conv-link-title">@c.Title</div>
                        <div class="savi-conv-link-time">@c.UpdatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</div>
                    </div>
                    <button class="savi-conv-del-btn" @onclick="() => DeleteConversation(c.Id)" @onclick:stopPropagation="true" title="Delete conversation">
                        🗑
                    </button>
                </div>
            }
        </div>
    };

    private async Task CloseDrawer()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleNavClick()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        _searchCts?.Dispose();
    }
}
