@using SAVI.Application.DTOs
@using SAVI.Application.Interfaces
@using SAVI.Application.Common
@inject IConversationService ConversationService
@inject ISettingsService SettingsService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="savi-glass-panel savi-hud-bracket savi-sidebar-shell" style="padding: 14px; height: 100%; display: flex; flex-direction: column; gap: 10px; box-sizing: border-box;">
    <!-- Logo & Brand -->
    <div class="savi-sidebar-brand">
        <div style="display: flex; align-items: center; gap: 10px;">
            <SaviLogo Size="30" Animated="true" />
            <div>
                <div class="savi-glow-text" style="font-weight: 800; font-size: 1.05rem; letter-spacing: 2px;">SAVI</div>
                <div style="font-size: 0.62rem; color: var(--savi-text-dim); letter-spacing: 0.5px;">PERSONAL AI ASSISTANT</div>
            </div>
        </div>
        @if (ShowCloseButton)
        {
            <button class="savi-btn savi-btn-sm" style="padding: 2px 8px; line-height: 1;" @onclick="CloseDrawer" title="Close Menu">✕</button>
        }
    </div>

    <!-- + New Chat Action -->
    <button class="savi-btn savi-sidebar-newchat" @onclick="CreateNewChat" title="Start a fresh conversation">
        <span>+ New Chat</span>
    </button>

    <!-- Search Conversations -->
    <div class="savi-sidebar-search">
        <span class="savi-sidebar-search-icon">🔍</span>
        <input type="text" class="savi-sidebar-search-input" placeholder="Search chats..."
               @bind="_searchQuery" @bind:event="oninput" @bind:after="FilterConversations" />
        @if (!string.IsNullOrEmpty(_searchQuery))
        {
            <button class="savi-sidebar-search-clear" @onclick="ClearSearch" title="Clear search">✕</button>
        }
    </div>

    <!-- Conversation History List (Date Grouped) -->
    <div class="savi-conv-list-container">
        @if (_conversations.Count == 0)
        {
            <div style="font-size: 0.74rem; color: var(--savi-text-dim); text-align: center; margin-top: 24px; padding: 0 10px;">
                @(string.IsNullOrWhiteSpace(_searchQuery) ? "No saved conversations yet" : "No matching conversations")
            </div>
        }
        else
        {
            @RenderGroup("Today", _todayConversations)
            @RenderGroup("Yesterday", _yesterdayConversations)
            @RenderGroup("Previous 7 Days", _pastWeekConversations)
            @RenderGroup("Older", _olderConversations)
        }
    </div>

    <!-- Primary Navigation Links -->
    <nav style="display: flex; flex-direction: column; gap: 4px; border-top: 1px solid var(--savi-border-subtle); padding-top: 8px;">
        <NavLink class="savi-nav-item" href="@SaviRouteHelper.BuildChatRoute(_currentConvId)" Match="NavLinkMatch.Prefix" @onclick="HandleNavClick">
            <span class="savi-icon">💬</span>
            <span style="flex: 1;">Chat</span>
        </NavLink>
        <NavLink class="savi-nav-item" href="@SaviRouteHelper.BuildVoiceRoute(_currentConvId)" Match="NavLinkMatch.Prefix" @onclick="HandleNavClick">
            <span class="savi-icon">🎙️</span>
            <span style="flex: 1;">Voice</span>
            <span class="savi-badge" style="font-size: 0.58rem; padding: 1px 5px; color: #00f0ff;">LIVE</span>
        </NavLink>
        <NavLink class="savi-nav-item" href="/tasks" @onclick="HandleNavClick">
            <span class="savi-icon">⚙</span>
            <span style="flex: 1;">Tasks</span>
        </NavLink>
        <NavLink class="savi-nav-item" href="/memory" @onclick="HandleNavClick">
            <span class="savi-icon">🧠</span>
            <span style="flex: 1;">Memory</span>
        </NavLink>
        <NavLink class="savi-nav-item" href="/automations" @onclick="HandleNavClick">
            <span class="savi-icon">⚡</span>
            <span style="flex: 1;">Automations</span>
            <span class="savi-badge" style="font-size: 0.58rem; padding: 1px 5px; color: var(--savi-cyan);">AUTO</span>
        </NavLink>

        <!-- Progressive Disclosure for More / System -->
        <div style="position: relative;">
            <button class="savi-nav-item" style="width: 100%; border: none; cursor: pointer; text-align: left; background: transparent; font-family: var(--savi-font);"
                    @onclick="() => _showMoreMenu = !_showMoreMenu">
                <span class="savi-icon">⋯</span>
                <span style="flex: 1;">More</span>
                <span style="font-size: 0.7rem; color: var(--savi-text-dim); transition: transform 0.2s; transform: rotate(@(_showMoreMenu ? "180deg" : "0deg"));">▼</span>
            </button>

            @if (_showMoreMenu)
            {
                <div style="margin-left: 12px; padding-left: 10px; border-left: 1px solid var(--savi-border-subtle); display: flex; flex-direction: column; gap: 3px; margin-top: 2px;">
                    <NavLink class="savi-nav-item" href="/providers" @onclick="HandleNavClick" style="padding: 6px 10px; font-size: 0.8rem;">
                        <span class="savi-icon" style="font-size: 0.85rem;">📡</span> Sources &amp; Providers
                    </NavLink>
                    <NavLink class="savi-nav-item" href="/diagnostics" @onclick="HandleNavClick" style="padding: 6px 10px; font-size: 0.8rem;">
                        <span class="savi-icon" style="font-size: 0.85rem;">📊</span> System Diagnostics
                    </NavLink>
                    <NavLink class="savi-nav-item" href="/audit" @onclick="HandleNavClick" style="padding: 6px 10px; font-size: 0.8rem;">
                        <span class="savi-icon" style="font-size: 0.85rem;">🛡</span> Security &amp; Audit
                    </NavLink>
                    <button class="savi-nav-item" style="padding: 6px 10px; font-size: 0.8rem; background: transparent; border: none; cursor: pointer; text-align: left; font-family: var(--savi-font);"
                            @onclick="() => _showAboutModal = true">
                        <span class="savi-icon" style="font-size: 0.85rem;">ℹ</span> About SAVI
                    </button>
                </div>
            }
        </div>

        <NavLink class="savi-nav-item" href="/settings" @onclick="HandleNavClick">
            <span class="savi-icon">⚙</span>
            <span style="flex: 1;">Settings</span>
        </NavLink>

        <AuthorizeView Roles="Owner">
            <Authorized>
                <div style="border-top: 1px solid var(--savi-border-subtle); margin-top: 4px; padding-top: 4px;">
                    <div style="font-size: 0.62rem; color: var(--savi-cyan); font-family: var(--savi-font-mono); padding: 4px 10px; font-weight: bold; letter-spacing: 1px;">
                        ADMIN CONSOLE
                    </div>
                    <NavLink class="savi-nav-item" href="/admin" Match="NavLinkMatch.All" @onclick="HandleNavClick">
                        <span class="savi-icon">⚡</span>
                        <span style="flex: 1;">Command Console</span>
                    </NavLink>
                    <NavLink class="savi-nav-item" href="/admin/users" Match="NavLinkMatch.Prefix" @onclick="HandleNavClick">
                        <span class="savi-icon">👥</span>
                        <span style="flex: 1;">Operators</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>

    <!-- User Profile & Authentication Footer -->
    <div style="border-top: 1px solid var(--savi-border-subtle); padding-top: 10px; margin-top: auto;">
        <AuthorizeView>
            <Authorized>
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 4px 6px;">
                    <div style="display: flex; align-items: center; gap: 8px; overflow: hidden;">
                        <div style="width: 28px; height: 28px; border-radius: 50%; background: rgba(0, 240, 255, 0.1); border: 1px solid var(--savi-cyan); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold; color: var(--savi-cyan); flex-shrink: 0;">
                            @(context.User.Identity?.Name?.FirstOrDefault() ?? 'U')
                        </div>
                        <div style="overflow: hidden;">
                            <div style="font-size: 0.75rem; font-weight: bold; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @context.User.Identity?.Name
                            </div>
                            <div style="font-size: 0.62rem; color: var(--savi-cyan); font-family: var(--savi-font-mono);">
                                @(context.User.IsInRole("Owner") ? "OWNER" : "OPERATOR")
                            </div>
                        </div>
                    </div>
                    <a href="/api/auth/logout" class="savi-btn savi-btn-sm" style="padding: 3px 8px; font-size: 0.68rem; color: #ff5555; border-color: rgba(255,85,85,0.3); text-decoration: none;" title="Sign out of SAVI">
                        ⏻
                    </a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div style="display: flex; gap: 6px;">
                    <a href="/login" class="savi-btn savi-btn-sm" style="flex: 1; text-align: center; font-size: 0.75rem; text-decoration: none;">
                        Sign In
                    </a>
                    <a href="/register" class="savi-btn savi-btn-sm" style="flex: 1; text-align: center; font-size: 0.75rem; text-decoration: none; border-color: var(--savi-cyan); color: var(--savi-cyan);">
                        Register
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<!-- About SAVI Modal -->
@if (_showAboutModal)
{
    <div class="savi-drawer-backdrop active" @onclick="() => _showAboutModal = false" style="z-index: 2000;">
        <div class="savi-glass-panel" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90%; max-width: 440px; padding: 20px; z-index: 2001;" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 10px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <SaviLogo Size="24" Animated="false" />
                    <span class="savi-glow-text" style="font-weight: 700; font-size: 1rem;">ABOUT SAVI</span>
                </div>
                <button class="savi-btn savi-btn-sm" @onclick="() => _showAboutModal = false">✕</button>
            </div>
            <div style="font-size: 0.82rem; color: var(--savi-text-secondary); line-height: 1.6; display: flex; flex-direction: column; gap: 10px;">
                <div>
                    <strong style="color: var(--savi-text-primary);">Shatru's Adaptive Virtual Intelligence</strong> is a sovereign, zero-cost, local-first personal AI assistant and conversational companion.
                </div>
                <div style="background: rgba(0, 240, 255, 0.05); border: 1px solid var(--savi-border-subtle); border-radius: 6px; padding: 10px; display: flex; flex-direction: column; gap: 4px;">
