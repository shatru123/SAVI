@page "/"
@rendermode InteractiveServer
@inject IAgentOrchestrator Orchestrator
@inject IConversationService ConversationService
@inject ISettingsService SettingsService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>SAVI — Shatru's Adaptive Virtual Intelligence</PageTitle>

<div style="display: flex; height: 100%; gap: 14px; position: relative;">
    <!-- Backdrop for Mobile Conversations Drawer -->
    <div class="savi-drawer-backdrop @(_mobileConvDrawerOpen ? "active" : "")" @onclick="() => _mobileConvDrawerOpen = false"></div>

    <!-- Conversations Sidebar (Static Aside on Desktop / Slide-over Drawer on Mobile) -->
    <div class="savi-glass-panel savi-hud-bracket savi-conv-sidebar @(_mobileConvDrawerOpen ? "open" : "")" style="width: 240px; min-width: 240px; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 6px;">
            <button class="savi-btn" style="flex: 1; justify-content: center; font-size: 0.8rem; padding: 6px 12px;" @onclick="StartNewChat">
                + New Chat
            </button>
            <button class="savi-btn savi-mobile-only" style="padding: 4px 8px; font-size: 0.8rem; line-height: 1;" @onclick="() => _mobileConvDrawerOpen = false" title="Close Chats">
                ✕
            </button>
        </div>

        <!-- Compact Search Input -->
        <div style="position: relative; display: flex; align-items: center;">
            <span style="position: absolute; left: 7px; font-size: 0.68rem; color: var(--savi-text-dim); pointer-events: none; line-height: 1;">🔍</span>
            <input type="text" placeholder="Search..." 
                   style="width: 100%; height: 26px; padding: 2px 22px 2px 24px; border: 1px solid var(--savi-border-subtle); border-radius: 4px; font-size: 0.72rem; background: rgba(11, 19, 34, 0.6); color: var(--savi-text-primary); outline: none; box-sizing: border-box; font-family: var(--savi-font);"
                   @bind="_searchQuery" @bind:event="oninput" @bind:after="FilterConversations" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button style="position: absolute; right: 5px; background: none; border: none; color: var(--savi-text-dim); cursor: pointer; font-size: 0.65rem; padding: 0;" @onclick="ClearSearch" title="Clear search">✕</button>
            }
        </div>

        <div style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; padding-right: 2px;">
            @if (_conversations.Count == 0)
            {
                <div style="font-size: 0.72rem; color: var(--savi-text-dim); text-align: center; margin-top: 20px;">
                    No past conversations
                </div>
            }
            else
            {
                @foreach (var c in _conversations)
                {
                    <div class="conv-item @(c.Id == _currentConversationId ? "active" : "")" @onclick="() => SelectConversation(c.Id)">
                        <div style="flex: 1; min-width: 0;">
                            <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.78rem; font-weight: 500;">
                                @c.Title
                            </div>
                            <div style="font-size: 0.64rem; color: var(--savi-text-dim); margin-top: 2px;">
                                @c.UpdatedAt.ToLocalTime().ToString("MMM dd, HH:mm")
                            </div>
                        </div>
                        <button class="conv-del-btn" title="Delete conversation" @onclick="() => DeleteConversation(c.Id)" @onclick:stopPropagation="true">
                            🗑
                        </button>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Central Stage: Core & Chat Stream -->
    <div class="savi-glass-panel savi-hud-bracket" style="flex: 1; display: flex; flex-direction: column; padding: 14px; min-width: 0;">
        <!-- Top Toolbar -->
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 10px;">
            <div style="display: flex; align-items: center; gap: 8px; min-width: 0; flex: 1;">
                <!-- Mobile Chats Toggle Button -->
                <button class="savi-btn savi-mobile-only" style="padding: 4px 8px; font-size: 0.78rem; border-radius: 4px; flex-shrink: 0;" @onclick="() => _mobileConvDrawerOpen = !_mobileConvDrawerOpen" title="Conversations">
                    💬 Chats
                </button>
                <span class="savi-glow-text" style="font-size: 0.88rem; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@_activeTitle</span>
                @if (_messages.Count > 0)
                {
                    <span class="savi-badge savi-desktop-only" style="font-size: 0.68rem; padding: 2px 6px;">@_messages.Count</span>
                }
            </div>

            <div style="display: flex; align-items: center; gap: 6px; flex-shrink: 0;">
                <!-- Voice Talk-Back Toggle Button -->
                <button class="savi-btn @(_talkBackEnabled ? "active-voice-btn" : "")" style="padding: 4px 10px; font-size: 0.75rem;" @onclick="ToggleTalkBack" title="Toggle Voice Talk-Back (Speech Synthesis)">
                    @(_talkBackEnabled ? "🔊 Voice: ON" : "🔇 Voice: OFF")
                </button>
                @if (!string.IsNullOrEmpty(_currentConversationId))
                {
                    <button class="savi-btn" style="padding: 4px 8px; font-size: 0.75rem; border-color: rgba(255, 0, 85, 0.4); color: #ff6688;" @onclick="() => DeleteConversation(_currentConversationId)" title="Delete active chat">
                        🗑 <span class="savi-desktop-only">Delete Chat</span>
                    </button>
                }
                <button class="savi-btn" style="padding: 4px 10px; font-size: 0.75rem;" @onclick="ToggleActivityDrawer">
                    <span class="savi-desktop-only">Telemetry: </span>@(_showActivity ? "Hide" : "Show")
                </button>
            </div>
        </div>

        <!-- Animated SAVI Core (Shrinks when active chat) -->
        <div style="text-align: center; margin-bottom: @_messages.Count == 0 ? "24px" : "10px";">
            <SaviCore VoiceState="_voiceState" ReducedMotion="_reducedMotion" />
        </div>

        <!-- Messages Stream -->
        <div class="savi-messages-stream" id="messages-container">
            @if (_messages.Count == 0)
            {
                <div style="text-align: center; color: var(--savi-text-secondary); margin-top: 36px; font-size: 0.9rem; max-width: 540px; margin-left: auto; margin-right: auto;">
                    <div class="savi-glow-text" style="font-size: 1.25rem; font-weight: 700; margin-bottom: 8px;">"I'm listening, Shatru."</div>
                    <div style="font-size: 0.85rem; color: var(--savi-text-primary); margin-bottom: 14px;">
                        SAVI Neural Engine is online. Ask anything, write code, research topics, or issue system commands.
                    </div>
                    <div style="display: inline-flex; align-items: center; gap: 8px; padding: 7px 16px; background: rgba(0, 240, 255, 0.09); border: 1px solid var(--savi-border-subtle); border-radius: 20px; font-size: 0.78rem; color: var(--savi-cyan); cursor: pointer; transition: all 0.2s;"
                         @onclick="PlayVoiceGreeting" title="Play SAVI Voice Greeting">
                        <span style="font-size: 1rem;">🔊</span>
                        <span>Tap anywhere or click here to hear SAVI speak</span>
                    </div>
                </div>
            }
            else
            {
                @foreach (var msg in _messages)
                {
                    <div class="savi-message @(msg.Role == MessageRole.User ? "savi-message-user" : "savi-message-assistant")">
                        <div style="font-size: 0.72rem; color: var(--savi-cyan); margin-bottom: 4px; display: flex; justify-content: space-between;">
                            <span>@(msg.Role == MessageRole.User ? "SHATRU" : "SAVI CORE")</span>
                            <span style="color: var(--savi-text-dim);">@msg.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                        </div>

                        <div style="white-space: pre-wrap;">@msg.Content</div>

                        @if (msg.Sources != null && msg.Sources.Count > 0)
                        {
                            <div style="margin-top: 10px; border-top: 1px dashed var(--savi-border-subtle); padding-top: 8px; display: flex; flex-wrap: wrap; gap: 6px;">
                                @foreach (var src in msg.Sources)
                                {
                                    <a href="@src.Url" target="_blank" class="savi-badge" style="text-decoration: none;" title="@src.Snippet">
                                        ✓ @src.SourceName (@(src.ReliabilityScore * 100)%)
                                    </a>
                                }
                            </div>
                        }

                        @if (msg.Role == MessageRole.Assistant && msg.ActivityLogs != null && msg.ActivityLogs.Count > 0)
                        {
                            <details class="savi-workflow-details">
                                <summary class="savi-workflow-summary">
                                    <span>◈ Execution Workflow (@msg.ActivityLogs.Count steps)</span>
                                </summary>
                                <div class="savi-workflow-box">
                                    @foreach (var log in msg.ActivityLogs)
                                    {
                                        <div class="savi-workflow-row">
                                            <span class="savi-workflow-check">✓</span>
                                            <span>@log</span>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                }
            }

            @if (_isProcessing)
            {
                <div class="savi-message savi-message-assistant" style="padding: 10px 14px; max-width: 90%;">
                    <div class="savi-agent-progress-card">
                        <div class="savi-agent-progress-header">
                            <div class="savi-agent-progress-title">
                                <span style="animation: savi-spin-slow 2s linear infinite; display: inline-block;">◈</span>
                                <span>Agentic Task Execution</span>
                            </div>
                            <span class="savi-agent-progress-badge">
                                <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--savi-success); animation: savi-pulse 1.2s infinite; display: inline-block;"></span>
                                ACTIVE
                            </span>
                        </div>
                        <div class="savi-agent-steps-list">
                            <div class="savi-agent-step-item @(_executionStep >= 1 ? (_executionStep == 1 ? "active" : "completed") : "pending")">
                                <span class="step-icon">@(_executionStep > 1 ? "✓" : (_executionStep == 1 ? "◈" : "○"))</span>
                                <span>1. Analyzing prompt intent &amp; task requirements</span>
                            </div>
                            <div class="savi-agent-step-item @(_executionStep >= 2 ? (_executionStep == 2 ? "active" : "completed") : "pending")">
                                <span class="step-icon">@(_executionStep > 2 ? "✓" : (_executionStep == 2 ? "◈" : "○"))</span>
                                <span>2. Routing to optimal AI neural engine &amp; tools</span>
                            </div>
                            <div class="savi-agent-step-item @(_executionStep >= 3 ? (_executionStep == 3 ? "active" : "completed") : "pending")">
                                <span class="step-icon">@(_executionStep > 3 ? "✓" : (_executionStep == 3 ? "◈" : "○"))</span>
                                <span>3. Executing task &amp; synthesizing code/solution</span>
                            </div>
                            <div class="savi-agent-step-item @(_executionStep >= 4 ? (_executionStep == 4 ? "active" : "completed") : "pending")">
                                <span class="step-icon">@(_executionStep > 4 ? "✓" : (_executionStep == 4 ? "◈" : "○"))</span>
                                <span>4. Verifying syntax, safety &amp; confidence boundaries</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Input Deck -->
        <div class="savi-input-deck" style="margin-top: 12px;">
            <input type="text" class="savi-input-field" placeholder="Ask SAVI anything or issue a command..."
                   @bind="_userInput" @bind:event="oninput" @onkeydown="HandleKeyDown" disabled="@_isProcessing" />

            <!-- Microphone Button -->
            <button class="savi-btn savi-btn-voice @(_isListening ? "listening" : "")" 
                    title="@(!_voiceSupported ? "Web Speech recognition not supported in this browser" : (_isListening ? "Listening... Click to stop & send" : "Voice Input (Web Speech API)"))" 
                    @onclick="ToggleVoiceInput">
                @(_isListening ? "⏹" : "🎙")
            </button>

            <!-- Send Button -->
            <button class="savi-btn" @onclick="SendMessage" disabled="@(string.IsNullOrWhiteSpace(_userInput) || _isProcessing)">
                Send ↵
            </button>
        </div>

        <!-- Voice Status & Error Alerts -->
        @if (_isListening)
        {
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.8rem; margin-top: 8px; color: var(--savi-cyan);">
                <span class="core-center-pulse" style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #00f0ff;"></span>
                <span class="savi-glow-text">Listening... Speak now (click ⏹ to finish &amp; send)</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(_voiceError))
        {
            <div style="font-size: 0.82rem; margin-top: 8px; padding: 10px 14px; background: rgba(255, 68, 68, 0.12); border: 1px solid rgba(255, 68, 68, 0.4); border-radius: 6px; color: #ff9999; display: flex; flex-direction: column; gap: 6px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px;">
                    <span style="display: flex; align-items: flex-start; gap: 8px;">
                        <span style="font-size: 1.1rem; line-height: 1;">⚠️</span>
                        <span>@_voiceError</span>
                    </span>
                    <button style="background: none; border: none; color: #ff9999; cursor: pointer; font-size: 1rem; padding: 0 4px;" @onclick="() => _voiceError = null" title="Dismiss">✕</button>
                </div>
                <div style="font-size: 0.76rem; color: var(--savi-text-secondary); margin-left: 26px;">
                    💡 <strong>Quick Fix on macOS</strong>: Open <code>http://localhost:5212</code> in <strong>Apple Safari</strong>. Safari utilizes macOS's built-in on-device dictation engine and works completely offline with zero network dependencies!
                </div>
            </div>
        }
    </div>

    <!-- Telemetry Activity Panel Drawer -->
    @if (_showActivity)
    {
        <div style="width: 280px; min-width: 280px;">
            <ActivityPanel Logs="_activityLogs" OnClose="() => _showActivity = false" />
        </div>
    }
</div>

<!-- Dangerous Action Approval Modal -->
<ActionModal ApprovalRequest="_pendingApproval" OnDecision="HandleActionDecision" />

<style>
.conv-item {
    padding: 6px 8px;
    border-radius: 4px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
}
.conv-item:hover, .conv-item.active {
    background: rgba(0, 240, 255, 0.08);
    border-color: var(--savi-border-subtle);
    color: var(--savi-cyan);
}
.conv-del-btn {
    background: rgba(255, 0, 85, 0.12);
    border: 1px solid rgba(255, 0, 85, 0.25);
    color: #ff6688;
    opacity: 0.85;
    cursor: pointer;
    font-size: 0.82rem;
    padding: 4px 7px;
    border-radius: 4px;
    transition: all 0.15s ease;
    line-height: 1;
    flex-shrink: 0;
}
.conv-item:hover .conv-del-btn, .conv-del-btn:hover, .conv-del-btn:active {
    opacity: 1 !important;
    color: #ffffff !important;
    background: rgba(255, 0, 85, 0.6) !important;
    border-color: #ff0055 !important;
}
</style>

@code {
    private string _userInput = string.Empty;
    private string _searchQuery = string.Empty;
    private string? _currentConversationId;
    private string _activeTitle = "New Conversation";
    private bool _talkBackEnabled = true;
    private int _executionStep = 0;
    private CancellationTokenSource? _stepCts;
    private bool _isProcessing = false;
    private bool _isListening = false;
    private bool _showActivity = false;
    private bool _reducedMotion = false;
    private bool _voiceSupported = true;
    private bool _mobileConvDrawerOpen = false;
    private string? _voiceError;
    private VoiceState _voiceState = VoiceState.Idle;

    private List<ConversationSummaryDto> _conversations = new();
    private List<MessageDto> _messages = new();
    private List<string> _activityLogs = new();
    private ActionApprovalRequest? _pendingApproval;
    private DotNetObjectReference<Home>? _dotNetRef;

    private async Task ToggleTalkBack()
    {
        _talkBackEnabled = !_talkBackEnabled;
        if (!_talkBackEnabled)
        {
            try
            {
                await JS.InvokeVoidAsync("saviVoice.stopSpeaking");
            }
            catch { }
            _voiceState = VoiceState.Idle;
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetSettingsAsync();
        _reducedMotion = settings.ReducedMotion;
        await LoadConversations();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                _voiceSupported = await JS.InvokeAsync<bool>("saviVoice.init", _dotNetRef);
                var greeting = "Hello Shatru! I am SAVI, your Smart Adaptive Virtual Intelligence, developed by Shatrughna Ambhore. All neural systems are online and ready. How can I help you today?";
                await JS.InvokeVoidAsync("saviVoice.autoSpeakGreeting", greeting);
            }
            catch
            {
                _voiceSupported = false;
            }
            StateHasChanged();
        }
    }

    private async Task PlayVoiceGreeting()
    {
        var greeting = "Hello Shatru! I am SAVI, your Smart Adaptive Virtual Intelligence, developed by Shatrughna Ambhore. All neural systems are online and ready. How can I help you today?";
        await JS.InvokeVoidAsync("saviVoice.speak", greeting);
    }

    private async Task LoadConversations()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _conversations = (await ConversationService.GetSummariesAsync()).ToList();
        }
        else
        {
            _conversations = (await ConversationService.SearchAsync(_searchQuery)).ToList();
        }

        if (_conversations.Count > 0)
        {
            if (_currentConversationId == null || !_conversations.Any(c => c.Id == _currentConversationId))
            {
                await SelectConversation(_conversations[0].Id);
            }
        }
        else
        {
            _currentConversationId = null;
            _messages.Clear();
            _activeTitle = "New Conversation";
        }
        StateHasChanged();
    }

    private async Task DeleteConversation(string id)
    {
        await ConversationService.DeleteAsync(id);
        if (_currentConversationId == id)
        {
            _currentConversationId = null;
        }
        await LoadConversations();
    }

    private async Task ClearSearch()
    {
        _searchQuery = string.Empty;
        await LoadConversations();
    }

    private async Task SelectConversation(string id)
    {
        _mobileConvDrawerOpen = false;
        _currentConversationId = id;
        var detail = await ConversationService.GetByIdAsync(id);
        if (detail != null)
        {
            _activeTitle = detail.Title;
            _messages = detail.Messages.ToList();
        }
        StateHasChanged();
    }

    private async Task StartNewChat()
    {
        _mobileConvDrawerOpen = false;
        var newConv = await ConversationService.GetOrCreateAsync(null);
        _currentConversationId = newConv.Id;
        _activeTitle = newConv.Title;
        _messages.Clear();
        await LoadConversations();
    }

    private async Task FilterConversations()
    {
        await LoadConversations();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !string.IsNullOrWhiteSpace(_userInput) && !_isProcessing)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || _isProcessing) return;

        var prompt = _userInput.Trim();
        _userInput = string.Empty;
        _isProcessing = true;
        _executionStep = 1;
        _voiceState = VoiceState.Processing;

        // Immediate user message in UI
        _messages.Add(new MessageDto
        {
            Id = Guid.NewGuid().ToString(),
            Role = MessageRole.User,
            Content = prompt,
            Timestamp = DateTimeOffset.UtcNow
        });

        StateHasChanged();

        // Launch background agentic step progress simulator while orchestrator runs
        _stepCts?.Cancel();
        _stepCts = new CancellationTokenSource();
        var stepToken = _stepCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(500, stepToken);
                _executionStep = 2;
                await InvokeAsync(StateHasChanged);

                await Task.Delay(800, stepToken);
                _executionStep = 3;
                await InvokeAsync(StateHasChanged);

                await Task.Delay(1100, stepToken);
                _executionStep = 4;
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) { }
        }, stepToken);

        try
        {
            var req = new AgentRequest
            {
                Message = prompt,
                ConversationId = _currentConversationId ?? string.Empty,
                VoiceActive = _talkBackEnabled || _isListening
            };

            var res = await Orchestrator.ProcessAsync(req);

            _stepCts.Cancel();
            _executionStep = 4;
            _currentConversationId = res.ConversationId;
            _activityLogs = res.ActivityLogs.ToList();

            if (res.RequiresApproval && res.PendingApprovalAction != null)
            {
                _pendingApproval = res.PendingApprovalAction;
            }

            _messages.Add(new MessageDto
            {
                Id = Guid.NewGuid().ToString(),
                Role = MessageRole.Assistant,
                Content = res.Message,
                Timestamp = DateTimeOffset.UtcNow,
                Sources = res.Sources,
                ActivityLogs = res.ActivityLogs.ToList()
            });

            // If talk-back is enabled, speak the answer aloud
            if (_talkBackEnabled)
            {
                _voiceState = VoiceState.Speaking;
                try
                {
                    await JS.InvokeVoidAsync("saviVoice.speak", res.Message);
                }
                catch { }
            }
            else
            {
                _voiceState = VoiceState.Idle;
            }

            await LoadConversations();
        }
        catch (Exception ex)
        {
            _stepCts.Cancel();
            _messages.Add(new MessageDto
            {
                Id = Guid.NewGuid().ToString(),
                Role = MessageRole.Assistant,
                Content = $"I encountered an unexpected issue: {ex.Message}. I've logged the technical details.",
                Timestamp = DateTimeOffset.UtcNow
            });
            _voiceState = VoiceState.Error;
        }
        finally
        {
            _isProcessing = false;
            _executionStep = 0;
            if (_voiceState != VoiceState.Speaking)
            {
                _voiceState = VoiceState.Idle;
            }
            StateHasChanged();
        }
    }

    private async Task ToggleVoiceInput()
    {
        _voiceError = null;
        try
        {
            var listening = await JS.InvokeAsync<bool>("saviVoice.toggleListening");
            _isListening = listening;
            _voiceState = _isListening ? VoiceState.Listening : VoiceState.Idle;
        }
        catch (Exception ex)
        {
            _isListening = false;
            _voiceState = VoiceState.Idle;
            _voiceError = $"Voice input initialization failed: {ex.Message}";
        }
    }

    [JSInvokable]
    public void OnSpeechInterim(string text)
    {
        if (!string.IsNullOrWhiteSpace(text))
        {
            _userInput = text;
            _voiceError = null;
            InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnSpeechRecognized(string transcript)
    {
        if (string.IsNullOrWhiteSpace(transcript)) return;

        _userInput = transcript;
        _isListening = false;
        _voiceState = VoiceState.Processing;
        _voiceError = null;
        StateHasChanged();
        await SendMessage();
    }

    [JSInvokable]
    public void OnVoiceStateChanged(int stateCode)
    {
        _voiceState = (VoiceState)stateCode;
        _isListening = _voiceState == VoiceState.Listening;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnVoiceError(string errorMessage)
    {
        _voiceError = errorMessage;
        _isListening = false;
        _voiceState = VoiceState.Error;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _stepCts?.Cancel();
        _stepCts?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("saviVoice.stopListening");
            await JS.InvokeVoidAsync("saviVoice.stopSpeaking");
        }
        catch { }
        _dotNetRef?.Dispose();
    }

    private void ToggleActivityDrawer()
    {
        _showActivity = !_showActivity;
    }

    private async Task HandleActionDecision(bool approved)
    {
        if (_pendingApproval == null) return;

        var actionId = _pendingApproval.ActionId;
        _pendingApproval = null;
        _isProcessing = true;

        try
        {
            var req = new AgentRequest
            {
                Message = approved ? "User approved the requested action." : "User cancelled the requested action.",
                ConversationId = _currentConversationId ?? string.Empty,
                ApprovedActionId = actionId,
                ActionApproved = approved
            };

            var res = await Orchestrator.ProcessAsync(req);
            _messages.Add(new MessageDto
            {
                Id = Guid.NewGuid().ToString(),
                Role = MessageRole.Assistant,
                Content = res.Message,
                Timestamp = DateTimeOffset.UtcNow,
                Sources = res.Sources,
                ActivityLogs = res.ActivityLogs.ToList()
            });

            if (_talkBackEnabled)
            {
                _voiceState = VoiceState.Speaking;
                try
                {
                    await JS.InvokeVoidAsync("saviVoice.speak", res.Message);
                }
                catch { }
            }
        }
        finally
        {
            _isProcessing = false;
            if (_voiceState != VoiceState.Speaking)
            {
                _voiceState = VoiceState.Idle;
            }
            StateHasChanged();
        }
    }
}
