@page "/"
@page "/chat"
@page "/chat/{ConversationId?}"
@rendermode InteractiveServer
@using SAVI.Core.Enums
@using System.Text.RegularExpressions
@inject IAgentOrchestrator Orchestrator
@inject IConversationService ConversationService
@inject ISettingsService SettingsService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>SAVI — Shatru's Adaptive Virtual Intelligence</PageTitle>

<div class="savi-chat-workspace" style="display: flex; height: 100%; position: relative; width: 100%;">
    <!-- Central Stage: Core & Chat Stream (Occupies 100% of Workspace) -->
    <div class="savi-glass-panel savi-hud-bracket savi-chat-panel" style="flex: 1; display: flex; flex-direction: column; padding: 14px; min-width: 0; height: 100%; box-sizing: border-box;">
        <!-- Top Toolbar (Uncluttered) -->
        <div class="savi-top-toolbar" style="padding-bottom: 8px; margin-bottom: 6px; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 8px; min-width: 0; flex: 1;">
                <span class="savi-glow-text" style="font-size: 0.92rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@_activeTitle</span>
                @if (_messages.Count > 0)
                {
                    <span class="savi-badge" style="font-size: 0.65rem; padding: 1px 6px;">@_messages.Count turns</span>
                }
            </div>

            <div style="display: flex; align-items: center; gap: 8px;">
                <!-- Dedicated Real-Time Voice Screen Button -->
                <button class="savi-btn savi-btn-sm savi-btn-primary" @onclick="NavigateToVoicePage" title="Switch to Dedicated Voice Mode">
                    <span>🎙️ Voice Screen</span>
                </button>

                <!-- Progressive Disclosure Menu -->
                <div class="savi-menu-wrapper">
                    <button class="savi-btn savi-btn-sm savi-btn-subtle" @onclick="() => _showToolbarMenu = !_showToolbarMenu" title="More options">
                        <span>⋮</span>
                    </button>
                    @if (_showToolbarMenu)
                    {
                        <div class="savi-menu-dropdown" @onclick:stopPropagation="true">
                            <!-- Verification Mode -->
                            <button class="savi-menu-item" @onclick="CycleVerificationPolicy">
                                <span>Verification Mode</span>
                                <span class="savi-badge" style="font-size: 0.62rem;">
                                    @(_activePolicy switch
                                    {
                                        VerificationPolicy.Fast => "⚡ Fast",
                                        VerificationPolicy.Verified => "🛡 Verified",
                                        _ => "⚖ Balanced"
                                    })
                                </span>
                            </button>

                            <!-- Voice Talk-Back -->
                            <button class="savi-menu-item" @onclick="ToggleTalkBack">
                                <span>Voice Talk-Back</span>
                                <span style="font-size: 0.72rem; color: @(_talkBackEnabled ? "var(--savi-cyan)" : "var(--savi-text-dim)");">
                                    @(_talkBackEnabled ? "🔊 ON" : "🔇 OFF")
                                </span>
                            </button>

                            <!-- Continuous Voice Mode -->
                            <button class="savi-menu-item" @onclick="ToggleContinuousVoice">
                                <span>Continuous Voice</span>
                                <span style="font-size: 0.72rem; color: @(_continuousVoiceMode ? "#00f0ff" : "var(--savi-text-dim)");">
                                    @(_continuousVoiceMode ? "🎙 LIVE" : "STD")
                                </span>
                            </button>

                            <div class="savi-menu-divider"></div>

                            <!-- Telemetry Activity Drawer -->
                            <button class="savi-menu-item" @onclick="ToggleActivityDrawer">
                                <span>Execution Details</span>
                                <span style="font-size: 0.72rem;">@(_showActivity ? "Hide" : "Show")</span>
                            </button>

                            @if (!string.IsNullOrEmpty(_currentConversationId))
                            {
                                <div class="savi-menu-divider"></div>
                                <button class="savi-menu-item" style="color: #ff6688;" @onclick="DeleteActiveChat">
                                    <span>Delete Chat</span>
                                    <span>🗑</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Messages Stream -->
        <div class="savi-messages-stream" id="messages-container" data-testid="chat-messages" tabindex="0" aria-live="polite">
            @if (_messages.Count == 0)
            {
                <div class="savi-empty-state">
                    <div style="margin-bottom: 4px;">
                        <SaviCore VoiceState="_voiceState" ReducedMotion="_reducedMotion" />
                    </div>
                    <div class="savi-empty-greeting">"I'm listening, Shatru."</div>
                    <div class="savi-empty-subtitle">
                        SAVI Neural Engine is online. Ask anything, write code, research topics, or give a voice command.
                    </div>

                    <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; background: rgba(0, 240, 255, 0.08); border: 1px solid var(--savi-border-subtle); border-radius: 20px; font-size: 0.78rem; color: var(--savi-cyan); cursor: pointer; transition: all 0.2s;"
                         @onclick="PlayVoiceGreeting" title="Play SAVI Voice Greeting">
                        <span style="font-size: 1rem;">🔊</span>
                        <span>Tap anywhere or click here to hear SAVI speak</span>
                    </div>

                    <div class="savi-suggestions-grid">
                        <div class="savi-suggestion-chip" @onclick='() => AskPreset("What is SAVI and what are its core capabilities?")'>
                            <span class="chip-label">Identity &amp; Stack</span>
                            <span>"What is SAVI and how does it work?"</span>
                        </div>
                        <div class="savi-suggestion-chip" @onclick='() => AskPreset("Explain dependency injection lifetimes (transient, scoped, singleton) in ASP.NET Core with code examples.")'>
                            <span class="chip-label">Architecture</span>
                            <span>"Explain dependency injection in .NET"</span>
                        </div>
                        <div class="savi-suggestion-chip" @onclick='() => AskPreset("Write a thread-safe exponential backoff retry handler in C#.")'>
                            <span class="chip-label">Code Synthesis</span>
                            <span>"Write a thread-safe retry handler in C#"</span>
                        </div>
                        <div class="savi-suggestion-chip" @onclick='() => AskPreset("Research recent breakthroughs in room-temperature quantum computing.")'>
                            <span class="chip-label">Deep Research</span>
                            <span>"Research quantum computing breakthroughs"</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @foreach (var msg in _messages)
                {
                    <div class="savi-message @(msg.Role == MessageRole.User ? "savi-message-user" : "savi-message-assistant")">
                        <div style="font-size: 0.72rem; color: var(--savi-cyan); margin-bottom: 4px; display: flex; justify-content: space-between;">
                            <span style="font-weight: 700; letter-spacing: 0.5px;">@(msg.Role == MessageRole.User ? "YOU" : "SAVI")</span>
                            <span style="color: var(--savi-text-dim); font-size: 0.68rem;">@msg.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                        </div>

                        <div class="savi-message-content">@RenderMarkdown(msg.Content)</div>

                        @if (msg.Role == MessageRole.Assistant)
                        {
                            <div class="savi-message-actions">
                                <button class="savi-message-action" @onclick="() => CopyMessage(msg.Content)" title="Copy SAVI's response">Copy</button>
                                @if (msg.Id == _messages.LastOrDefault(m => m.Role == MessageRole.Assistant)?.Id)
                                {
                                    <button class="savi-message-action" @onclick="RetryLastRequest" disabled="@_isProcessing" title="Ask SAVI again">Retry</button>
                                }
                            </div>
                        }

                        @if (msg.Sources != null && msg.Sources.Count > 0)
                        {
                            <div style="margin-top: 10px; border-top: 1px dashed var(--savi-border-subtle); padding-top: 8px; display: flex; flex-wrap: wrap; gap: 6px;">
                                @foreach (var src in msg.Sources)
                                {
                                    <a href="@src.Url" target="_blank" class="savi-badge" style="text-decoration: none;" title="@src.Snippet">
                                        ✓ Source (@(src.ReliabilityScore * 100)%)
                                    </a>
                                }
                            </div>
                        }

                        @if (msg.Role == MessageRole.Assistant && msg.ActivityLogs != null && msg.ActivityLogs.Count > 0)
                        {
                            <details class="savi-workflow-details">
                                <summary class="savi-workflow-summary">
                                    <span>▸ How SAVI handled this (@msg.ActivityLogs.Count steps)</span>
                                </summary>
                                <div class="savi-workflow-box">
                                    @foreach (var log in msg.ActivityLogs)
                                    {
                                        <div class="savi-workflow-row">
                                            <span class="savi-workflow-check">✓</span>
                                            <span>@log</span>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                }
            }

            @if (_isProcessing)
            {
                <div class="savi-message savi-message-assistant" style="padding: 12px 16px;">
                    <div style="font-size: 0.85rem; color: var(--savi-cyan); display: flex; align-items: center; gap: 8px;">
                        <span style="animation: savi-spin-slow 1.5s linear infinite; display: inline-block;">◈</span>
                        <span class="savi-glow-text">Thinking &amp; synthesizing response...</span>
                    </div>
                    <button class="savi-btn savi-btn-sm" style="align-self: flex-start; margin-top: 10px;" @onclick="StopGenerating">Stop generating</button>
                </div>
            }
        </div>

        <!-- Input Deck -->
        <div class="savi-input-deck" style="margin-top: 12px;">
            <input type="text" class="savi-input-field" data-testid="chat-input" inputmode="text" autocomplete="off" autocapitalize="sentences" enterkeyhint="send" aria-label="Message SAVI" placeholder="Ask SAVI anything or issue a command..."
                   @bind="_userInput" @bind:event="oninput" @onkeydown="HandleKeyDown" disabled="@_isProcessing" />

            <!-- Microphone Button -->
            <button class="savi-btn savi-btn-voice @(_isListening ? "listening" : "")" data-testid="chat-voice-toggle" disabled="@(!_voiceSupported)"
                    title="@(!_voiceSupported ? "Web Speech recognition not supported in this browser" : (_isListening ? "Listening... Click to stop & send" : "Voice Input (Web Speech API)"))" 
                    @onclick="ToggleVoiceInput">
                @(_isListening ? "⏹" : "🎙")
            </button>

            <!-- Send Button -->
            <button class="savi-btn savi-btn-primary" data-testid="chat-send" @onclick="SendMessage" disabled="@(string.IsNullOrWhiteSpace(_userInput) || _isProcessing)">
                Send ↵
            </button>
        </div>

        <!-- Voice Status & Error Alerts -->
        @if (_continuousVoiceMode)
        {
            <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.74rem; margin-top: 8px; padding: 5px 12px; background: rgba(0, 240, 255, 0.08); border: 1px solid var(--savi-border-subtle); border-radius: 6px; color: var(--savi-cyan); flex-wrap: wrap; gap: 6px;">
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    <span class="core-center-pulse" style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #00f0ff;"></span>
                    <span class="savi-glow-text" style="font-weight: 700; letter-spacing: 0.5px;">LIVE FULL-DUPLEX VOICE</span>
                    <span style="color: var(--savi-text-dim);">• Continuous</span>
                    <button class="savi-btn savi-btn-sm" style="padding: 2px 7px; font-size: 0.68rem; border-radius: 4px;" @onclick="ToggleAudioOutputMode" title="Toggle Speaker Mode (echo rejection active) vs Headphone Mode">
                        @(_audioOutputMode == "speaker" ? "🔊 Speaker" : "🎧 Headphone")
                    </button>
                    @if (_falseSelfDetectionCount > 0)
                    {
                        <span class="savi-badge" style="background: rgba(0, 240, 255, 0.15); border: 1px solid var(--savi-cyan); color: var(--savi-cyan); font-size: 0.66rem; padding: 2px 6px;" title="SAVI self-echo transcripts suppressed">
                            🛡 Echo Filter: @_falseSelfDetectionCount
                        </span>
                    }
                </div>
                <div style="font-size: 0.68rem; color: var(--savi-text-secondary); display: flex; gap: 10px;">
                    <span>[Space] Push-to-Talk</span>
                    <span>[Esc] Silence</span>
                </div>
            </div>
        }
        @if (!_voiceSupported)
        {
            <div class="savi-voice-fallback" role="status">
                Voice input is not available in this browser. Text chat remains fully available.
            </div>
        }
        @if (_wasInterrupted)
        {
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.78rem; margin-top: 6px; padding: 4px 10px; background: rgba(255, 170, 0, 0.12); border: 1px solid rgba(255, 170, 0, 0.4); border-radius: 5px; color: #ffbb33;">
                <span>⚡</span>
                <span>Interrupted — SAVI stopped speaking. Listening for your correction...</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(_liveInterimTranscript))
        {
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.82rem; margin-top: 6px; padding: 6px 12px; background: rgba(0, 255, 136, 0.09); border: 1px solid rgba(0, 255, 136, 0.35); border-radius: 6px; color: #aaffcc;">
                <span style="animation: savi-pulse 1s infinite; display: inline-block;">🎙</span>
                <span style="font-style: italic;">"@_liveInterimTranscript"</span>
            </div>
        }
        else if (_isListening && !_continuousVoiceMode)
        {
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.8rem; margin-top: 8px; color: var(--savi-cyan);">
                <span class="core-center-pulse" style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #00f0ff;"></span>
                <span class="savi-glow-text">Listening... Speak now (click ⏹ to finish &amp; send)</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(_voiceError))
        {
            <div style="font-size: 0.82rem; margin-top: 8px; padding: 10px 14px; background: rgba(255, 68, 68, 0.12); border: 1px solid rgba(255, 68, 68, 0.4); border-radius: 6px; color: #ff9999; display: flex; flex-direction: column; gap: 6px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px;">
                    <span style="display: flex; align-items: flex-start; gap: 8px;">
                        <span style="font-size: 1.1rem; line-height: 1;">⚠️</span>
                        <span>@_voiceError</span>
                    </span>
                    <button style="background: none; border: none; color: #ff9999; cursor: pointer; font-size: 1rem; padding: 0 4px;" @onclick="() => _voiceError = null" title="Dismiss">✕</button>
                </div>
                <div style="font-size: 0.76rem; color: var(--savi-text-secondary); margin-left: 26px;">
                    💡 <strong>Quick Fix on macOS</strong>: Open <code>http://localhost:5212</code> in <strong>Apple Safari</strong>. Safari utilizes macOS's built-in on-device dictation engine and works completely offline with zero network dependencies!
                </div>
            </div>
        }
    </div>

    <!-- Telemetry Activity Panel Drawer -->
    @if (_showActivity)
    {
        <div style="width: 280px; min-width: 280px;">
            <ActivityPanel Logs="_activityLogs" OnClose="() => _showActivity = false" />
        </div>
    }
</div>

<!-- Dangerous Action Approval Modal -->
<ActionModal ApprovalRequest="_pendingApproval" OnDecision="HandleActionDecision" />

<!-- Immersive Dedicated Voice Screen Overlay -->
@if (_isVoiceOverlayOpen)
{
    <VoiceOverlay
        VoiceState="_voiceState"
        IsListening="_isListening"
        IsMuted="_isMicMuted"
        AudioOutputMode="@_audioOutputMode"
        FalseSelfDetectionCount="@_falseSelfDetectionCount"
        HardwareAecStatus="@GetAudioCapabilityStatus(_hardwareAec)"
        UserTranscript="@(!string.IsNullOrWhiteSpace(_liveInterimTranscript) ? _liveInterimTranscript : (_messages.LastOrDefault(m => m.Role == MessageRole.User)?.Content ?? ""))"
        AssistantTranscript="@(_messages.LastOrDefault(m => m.Role == MessageRole.Assistant)?.Content ?? "")"
        AudioStopLatencyMs="_lastAudioStopLatencyMs"
        OnClose="CloseVoiceOverlay"
        OnToggleMute="ToggleVoiceMute"
        OnTogglePause="ToggleVoicePause"
        OnInterrupt="InterruptVoicePlayback"
        OnToggleAudioMode="ToggleAudioOutputMode" />
}

<style>
.savi-top-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--savi-border-subtle);
    padding-bottom: 10px;
    gap: 8px;
    flex-wrap: wrap;
}
.savi-top-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    max-width: 100%;
}
@@media (max-width: 768px) {
    .savi-top-toolbar {
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
    }
    .savi-top-actions {
        display: flex;
        overflow-x: auto;
        flex-wrap: nowrap;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 4px;
        scrollbar-width: none;
        max-width: 100%;
        width: 100%;
    }
    .savi-top-actions::-webkit-scrollbar {
        display: none;
    }
    .savi-top-actions .savi-btn {
        flex-shrink: 0;
        font-size: 0.72rem;
        padding: 4px 8px;
        white-space: nowrap;
        min-width: 44px;
        min-height: 44px;
    }
}
.conv-item {
    padding: 6px 8px;
    border-radius: 4px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
}
.conv-item:hover, .conv-item.active {
    background: rgba(0, 240, 255, 0.08);
    border-color: var(--savi-border-subtle);
    color: var(--savi-cyan);
}
.conv-del-btn {
    min-width: 44px;
    min-height: 44px;
    background: rgba(255, 0, 85, 0.12);
    border: 1px solid rgba(255, 0, 85, 0.25);
    color: #ff6688;
    opacity: 0.85;
    cursor: pointer;
    font-size: 0.82rem;
    padding: 4px 7px;
    border-radius: 4px;
    transition: all 0.15s ease;
    line-height: 1;
    flex-shrink: 0;
}
.conv-item:hover .conv-del-btn, .conv-del-btn:hover, .conv-del-btn:active {
    opacity: 1 !important;
    color: #ffffff !important;
    background: rgba(255, 0, 85, 0.6) !important;
    border-color: #ff0055 !important;
}
</style>

@code {
    [Parameter]
    public string? ConversationId { get; set; }

    private string _userInput = string.Empty;
    private string _searchQuery = string.Empty;
    private string? _currentConversationId;
    private string _activeTitle = "New Conversation";
    private bool _talkBackEnabled = true;
    private bool _continuousVoiceMode = false;
    private bool _wasInterrupted = false;
    private string _liveInterimTranscript = string.Empty;
    private int _executionStep = 0;
    private bool _isProcessing = false;
    private bool _isListening = false;
    private bool _showActivity = false;
    private bool _reducedMotion = false;
    private bool _voiceSupported = true;
    private bool _voiceJsReady = false;
    private bool _showToolbarMenu = false;
    private string? _voiceError;
    private VoiceState _voiceState = VoiceState.Idle;
    private VerificationPolicy _activePolicy = VerificationPolicy.Balanced;
    private CancellationTokenSource? _searchCts;
    private CancellationTokenSource? _processingCts;
    private string? _activeTurnId;
    private string? _voiceSessionId;
    private string? _voiceGenerationId;
    private string _audioOutputMode = "speaker";
    private int _falseSelfDetectionCount = 0;
    private bool _hardwareAec;
    private bool _hardwareNs;
    private bool _hardwareAgc;
    private bool _audioSettingsReported;
    private string? _lastSuppressedEcho;

    private bool _isVoiceOverlayOpen = false;
    private bool _isMicMuted = false;
    private double _lastAudioStopLatencyMs = 0;

    private List<ConversationSummaryDto> _conversations = new();
    private List<MessageDto> _messages = new();
    private List<string> _activityLogs = new();
    private ActionApprovalRequest? _pendingApproval;
    private DotNetObjectReference<Home>? _dotNetRef;

    private async Task AskPreset(string text)
    {
        if (_isProcessing) return;
        _userInput = text;
        await SendMessage();
    }

    private async Task DeleteActiveChat()
    {
        _showToolbarMenu = false;
        if (string.IsNullOrEmpty(_currentConversationId)) return;
        await DeleteConversation(_currentConversationId);
    }

    private async Task ToggleAudioOutputMode()
    {
        _audioOutputMode = _audioOutputMode == "speaker" ? "headphone" : "speaker";
        try
        {
            await JS.InvokeVoidAsync("saviVoice.setAudioOutputMode", _audioOutputMode);
        }
        catch { }
        StateHasChanged();
    }

    private void NavigateToVoicePage()
    {
        Navigation.NavigateTo(string.IsNullOrEmpty(_currentConversationId) ? "/voice" : $"/voice/{_currentConversationId}");
    }

    private async Task OpenVoiceOverlay()
    {
        _isVoiceOverlayOpen = true;
        _talkBackEnabled = true;
        _wasInterrupted = false;
        if (!_continuousVoiceMode)
        {
            await ToggleContinuousVoice();
        }
        else if (!_isListening)
        {
            try
            {
                await JS.InvokeVoidAsync("saviVoice.startListening");
                _isListening = true;
                _voiceState = VoiceState.Listening;
            }
            catch { }
        }
        StateHasChanged();
    }

    private void CloseVoiceOverlay()
    {
        _isVoiceOverlayOpen = false;
        StateHasChanged();
    }

    private async Task ToggleVoiceMute()
    {
        _isMicMuted = !_isMicMuted;
        try
        {
            if (_isMicMuted)
            {
                await JS.InvokeVoidAsync("saviVoice.stopListening");
                _isListening = false;
            }
            else
            {
                await JS.InvokeVoidAsync("saviVoice.startListening");
                _isListening = true;
                _voiceState = VoiceState.Listening;
            }
        }
        catch { }
        StateHasChanged();
    }

    private async Task ToggleVoicePause()
    {
        try
        {
            if (_isListening)
            {
                await JS.InvokeVoidAsync("saviVoice.stopListening");
                _isListening = false;
                _voiceState = VoiceState.Idle;
            }
            else
            {
                await JS.InvokeVoidAsync("saviVoice.startListening");
                _isListening = true;
                _voiceState = VoiceState.Listening;
            }
        }
        catch { }
        StateHasChanged();
    }

    private async Task InterruptVoicePlayback()
    {
        try
        {
            await JS.InvokeVoidAsync("saviVoice.interruptSpeaking");
        }
        catch { }
    }

    private async Task ToggleContinuousVoice()
    {
        _continuousVoiceMode = !_continuousVoiceMode;
        _talkBackEnabled = true;
        _wasInterrupted = false;
        try
        {
            var started = await JS.InvokeAsync<bool>("saviVoice.setContinuousMode", _continuousVoiceMode);
            if (_continuousVoiceMode && !started)
            {
                _continuousVoiceMode = false;
                _isListening = false;
                _voiceState = VoiceState.Error;
            }
            else
            {
                _isListening = _continuousVoiceMode;
                _voiceState = _continuousVoiceMode ? VoiceState.Listening : VoiceState.Idle;
            }
        }
        catch (Exception ex)
        {
            _continuousVoiceMode = false;
            Console.Error.WriteLine($"SAVI continuous voice mode error: {ex}");
            _voiceError = "Continuous voice mode could not start. Check microphone permission and try again.";
        }
        StateHasChanged();
    }

    private void CycleVerificationPolicy()
    {
        _activePolicy = _activePolicy switch
        {
            VerificationPolicy.Balanced => VerificationPolicy.Verified,
            VerificationPolicy.Verified => VerificationPolicy.Fast,
            _ => VerificationPolicy.Balanced
        };
        StateHasChanged();
    }

    private async Task ToggleTalkBack()
    {
        _talkBackEnabled = !_talkBackEnabled;
        if (!_talkBackEnabled)
        {
            try
            {
                await JS.InvokeVoidAsync("saviVoice.stopSpeaking");
            }
            catch { }
            _voiceState = VoiceState.Idle;
        }
        try
        {
            var settings = await SettingsService.GetSettingsAsync();
            settings.VoiceEnabled = _talkBackEnabled;
            await SettingsService.UpdateSettingsAsync(settings);
        }
        catch { }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetSettingsAsync();
        _reducedMotion = settings.ReducedMotion;
        _talkBackEnabled = settings.VoiceEnabled;
        await LoadConversations();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ConversationId) && ConversationId != _currentConversationId)
        {
            await SelectConversation(ConversationId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                _voiceSupported = await JS.InvokeAsync<bool>("saviVoice.init", _dotNetRef, _currentConversationId ?? string.Empty);
                _voiceJsReady = true;
            }
            catch
            {
                _voiceSupported = false;
            }
            StateHasChanged();
        }
    }

    private async Task PlayVoiceGreeting()
    {
        var greeting = "Hello Shatru! I am SAVI, your Smart Adaptive Virtual Intelligence, developed by Shatrughna Ambhore. All neural systems are online and ready. How can I help you today?";
        await JS.InvokeVoidAsync("saviVoice.speak", greeting, 1.0, "greeting");
    }

    private async Task LoadConversations()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _conversations = (await ConversationService.GetSummariesAsync()).ToList();
        }
        else
        {
            _conversations = (await ConversationService.SearchAsync(_searchQuery)).ToList();
        }

        if (_conversations.Count > 0)
        {
            if (_currentConversationId == null || !_conversations.Any(c => c.Id == _currentConversationId))
            {
                await SelectConversation(_conversations[0].Id);
            }
        }
        else
        {
            _currentConversationId = null;
            _messages.Clear();
            _activeTitle = "New Conversation";
        }
        StateHasChanged();
    }

    private async Task DeleteConversation(string id)
    {
        await ConversationService.DeleteAsync(id);
        if (_currentConversationId == id)
        {
            _currentConversationId = null;
        }
        await LoadConversations();
    }

    private async Task ClearSearch()
    {
        _searchQuery = string.Empty;
        await LoadConversations();
    }

    private async Task SelectConversation(string id)
    {
        _currentConversationId = id;
        if (!Navigation.Uri.EndsWith($"/chat/{id}", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo($"/chat/{id}", replace: true);
        }
        if (_voiceJsReady)
        {
            await JS.InvokeVoidAsync("saviVoice.setConversationId", id);
        }
        var detail = await ConversationService.GetByIdAsync(id);
        if (detail != null)
        {
            _activeTitle = detail.Title;
            _messages = detail.Messages.ToList();
        }
        StateHasChanged();
    }

    private async Task StartNewChat()
    {
        var newConv = await ConversationService.GetOrCreateAsync(null);
        _currentConversationId = newConv.Id;
        Navigation.NavigateTo($"/chat/{_currentConversationId}", replace: true);
        if (_voiceJsReady)
        {
            await JS.InvokeVoidAsync("saviVoice.setConversationId", _currentConversationId);
        }
        _activeTitle = newConv.Title;
        _messages.Clear();
        await LoadConversations();
    }

    private async Task FilterConversations()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(250, token);
            await LoadConversations();
        }
        catch (OperationCanceledException) { }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !string.IsNullOrWhiteSpace(_userInput) && !_isProcessing)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || _isProcessing) return;

        var prompt = _userInput.Trim();
        _userInput = string.Empty;
        var turnId = "turn_" + Guid.NewGuid().ToString("N");
        await CancelCurrentTurnAndReplaceAsync(prompt, turnId);
    }

    private async Task CancelCurrentTurnAndReplaceAsync(string prompt, string turnId)
    {
        if (string.IsNullOrWhiteSpace(prompt)) return;

        _activeTurnId = turnId;

        // Asynchronous non-blocking cancellation of previous turn
        var oldCts = _processingCts;
        _processingCts = new CancellationTokenSource();
        var currentToken = _processingCts.Token;

        try
        {
            oldCts?.Cancel();
            oldCts?.Dispose();
        }
        catch { }

        await ExecuteTurnAsync(prompt, turnId, currentToken);
    }

    private async Task ExecuteTurnAsync(string prompt, string turnId, CancellationToken currentToken)
    {
        _isProcessing = true;
        _executionStep = 1;
        _voiceState = VoiceState.Processing;
        _wasInterrupted = false;

        // Immediate user message in UI
        _messages.Add(new MessageDto
        {
            Id = Guid.NewGuid().ToString(),
            Role = MessageRole.User,
            Content = prompt,
            Timestamp = DateTimeOffset.UtcNow
        });

        StateHasChanged();

        try
        {
            var req = new AgentRequest
            {
                Message = prompt,
                ConversationId = _currentConversationId ?? string.Empty,
                VoiceActive = _talkBackEnabled || _isListening || _continuousVoiceMode,
                VerificationPolicyOverride = _activePolicy,
                OnStepProgress = (step, label) =>
                {
                    if (currentToken.IsCancellationRequested || _activeTurnId != turnId) return;
                    _executionStep = step;
                    InvokeAsync(StateHasChanged);
                }
            };

            try { await JS.InvokeVoidAsync("saviVoice.markProcessing", turnId, _voiceGenerationId); } catch { }

            var res = await Orchestrator.ProcessAsync(req, currentToken);

            // STALE RESULT RULE: If this turn was superseded by a newer turn, discard the stale result!
            if (currentToken.IsCancellationRequested || _activeTurnId != turnId) return;

            _executionStep = 4;
            _currentConversationId = res.ConversationId;
            await JS.InvokeVoidAsync("saviVoice.setConversationId", _currentConversationId);
            _activityLogs = res.ActivityLogs.ToList();

            if (res.RequiresApproval && res.PendingApprovalAction != null)
            {
                _pendingApproval = res.PendingApprovalAction;
            }

            _messages.Add(new MessageDto
            {
                Id = Guid.NewGuid().ToString(),
                Role = MessageRole.Assistant,
                Content = res.Message,
                Timestamp = DateTimeOffset.UtcNow,
                Sources = res.Sources,
                ActivityLogs = res.ActivityLogs.ToList()
            });

            // If talk-back is enabled, speak the answer aloud (using concise voice-friendly phrasing)
            if (_talkBackEnabled && !_wasInterrupted && !currentToken.IsCancellationRequested && _activeTurnId == turnId)
            {
                _voiceState = VoiceState.Speaking;
                var spokenText = !string.IsNullOrWhiteSpace(res.VoiceFriendlyMessage)
                    ? res.VoiceFriendlyMessage
                    : res.Message;

                try
                {
                    await JS.InvokeVoidAsync("saviVoice.speak", spokenText, 1.0, turnId, _voiceGenerationId);
                }
                catch { }
            }
            else if (_continuousVoiceMode)
            {
                _voiceState = VoiceState.Listening;
            }
            else
            {
                _voiceState = VoiceState.Idle;
            }

            await LoadConversations();
        }
        catch (OperationCanceledException)
        {
            _wasInterrupted = true;
            if (_voiceState != VoiceState.Processing && _activeTurnId == turnId)
            {
                _voiceState = _continuousVoiceMode ? VoiceState.Listening : VoiceState.Idle;
            }
        }
        catch (Exception ex)
        {
            if (!currentToken.IsCancellationRequested && _activeTurnId == turnId)
            {
                Console.Error.WriteLine($"SAVI turn error: {ex}");
                _messages.Add(new MessageDto
                {
                    Id = Guid.NewGuid().ToString(),
                    Role = MessageRole.Assistant,
                    Content = "I ran into a problem while processing that request. Please try again.",
                    Timestamp = DateTimeOffset.UtcNow
                });
                _voiceState = VoiceState.Error;
            }
        }
        finally
        {
            // Only reset if this turn is still the active one
            if (_activeTurnId == turnId)
            {
                _isProcessing = false;
                _executionStep = 0;
                if (_voiceState != VoiceState.Speaking && _voiceState != VoiceState.Listening && _voiceState != VoiceState.Interrupted)
                {
                    _voiceState = _continuousVoiceMode ? VoiceState.Listening : VoiceState.Idle;
                }
                StateHasChanged();
            }
        }
    }

    private async Task ToggleVoiceInput()
    {
        _voiceError = null;
        try
        {
            var listening = await JS.InvokeAsync<bool>("saviVoice.toggleListening");
            _isListening = listening;
            _voiceState = _isListening ? VoiceState.Listening : VoiceState.Idle;
        }
        catch (Exception ex)
        {
            _isListening = false;
            _voiceState = VoiceState.Idle;
            Console.Error.WriteLine($"SAVI voice input error: {ex}");
            _voiceError = "Voice input could not start. Check microphone permission or continue in text chat.";
        }
    }

    [JSInvokable]
    public void OnVadSpeechStarted(double timestampMs, string? turnId = null, string? generationId = null, string? sessionId = null)
    {
        if (!AcceptVoiceCallback(turnId, generationId, sessionId)) return;
        _voiceState = VoiceState.UserSpeaking;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnUserInterrupted(double audioStopLatencyMs = 0, string? turnId = null, string? generationId = null, string? sessionId = null)
    {
        if (!AcceptVoiceCallback(turnId, generationId, sessionId)) return;
        _wasInterrupted = true;
        if (audioStopLatencyMs > 0)
        {
            _lastAudioStopLatencyMs = audioStopLatencyMs;
        }
        if (_voiceState == VoiceState.Speaking)
        {
            _voiceState = VoiceState.Interrupted;
        }
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnSpeechInterim(string text, string? turnId = null, string? generationId = null, string? sessionId = null)
    {
        if (!AcceptVoiceCallback(turnId, generationId, sessionId)) return;
        if (!string.IsNullOrWhiteSpace(text))
        {
            _liveInterimTranscript = text;
            _voiceState = VoiceState.DetectingSpeech;
            _voiceError = null;
            InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnSpeechRecognized(string transcript, string? turnId = null, string? generationId = null, string? sessionId = null)
    {
        if (string.IsNullOrWhiteSpace(transcript)) return;
        if (!AcceptVoiceCallback(turnId, generationId, sessionId)) return;

        _liveInterimTranscript = string.Empty;
        _userInput = string.Empty;
        if (!_continuousVoiceMode)
        {
            _isListening = false;
        }
        _voiceError = null;

        var assignedTurnId = turnId ?? ("turn_" + Guid.NewGuid().ToString("N"));
        await CancelCurrentTurnAndReplaceAsync(transcript.Trim(), assignedTurnId);
    }

    [JSInvokable]
    public void OnVoiceStateChanged(int stateCode, string? turnId = null, string? generationId = null, string? sessionId = null)
    {
        if (!AcceptVoiceCallback(turnId, generationId, sessionId)) return;
        if (!Enum.IsDefined(typeof(VoiceState), stateCode)) return;
        _voiceState = (VoiceState)stateCode;
        _isListening = _voiceState == VoiceState.Listening;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnVoiceError(string errorMessage)
    {
        _voiceError = errorMessage;
        _isListening = false;
        _voiceState = VoiceState.Error;
        InvokeAsync(StateHasChanged);
    }

    private bool AcceptVoiceCallback(string? turnId, string? generationId, string? sessionId)
    {
        if (!string.IsNullOrWhiteSpace(sessionId))
        {
            if (_voiceSessionId != null && !string.Equals(_voiceSessionId, sessionId, StringComparison.Ordinal)) return false;
            _voiceSessionId = sessionId;
        }

        if (!string.IsNullOrWhiteSpace(generationId))
        {
            _voiceGenerationId = generationId;
        }

        return true;
    }

    [JSInvokable]
    public void OnAudioSettingsDetected(bool aec, bool ns, bool agc, int sampleRate)
    {
        _hardwareAec = aec;
        _hardwareNs = ns;
        _hardwareAgc = agc;
        _audioSettingsReported = true;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnSelfEchoSuppressed(string echoedText, int count)
    {
        _falseSelfDetectionCount = count;
        _lastSuppressedEcho = echoedText;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("saviVoice.shutdown");
        }
        catch { }
        _dotNetRef?.Dispose();
    }

    private async Task StopGenerating()
    {
        try { _processingCts?.Cancel(); } catch { }
        _isProcessing = false;
        _voiceState = _continuousVoiceMode ? VoiceState.Listening : VoiceState.Idle;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RetryLastRequest()
    {
        var assistantIndex = _messages.FindLastIndex(message => message.Role == MessageRole.Assistant);
        if (assistantIndex < 0) return;
        var previousUser = _messages.Take(assistantIndex).LastOrDefault(message => message.Role == MessageRole.User);
        if (previousUser == null || string.IsNullOrWhiteSpace(previousUser.Content)) return;
        await CancelCurrentTurnAndReplaceAsync(previousUser.Content, "turn_" + Guid.NewGuid().ToString("N"));
    }

    private async Task CopyMessage(string content)
    {
        try { await JS.InvokeVoidAsync("saviBrowser.copyText", content); } catch { }
    }

    private string GetAudioCapabilityStatus(bool enabled) =>
        !_audioSettingsReported ? "Unsupported" : enabled ? "Enabled" : "Disabled";

    private static Microsoft.AspNetCore.Components.MarkupString RenderMarkdown(string? markdown)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(markdown ?? string.Empty);
        var codeBlocks = new List<string>();
        encoded = Regex.Replace(encoded, @"```[^\r\n]*\r?\n([\s\S]*?)```", match =>
        {
            var code = match.Groups[1].Value.Replace("\r\n", "\n").Replace("\n", "&#10;");
            var token = $"@@SAVI_CODE_{codeBlocks.Count}@@";
            codeBlocks.Add($"<pre class=\"savi-code-block\"><code>{code}</code></pre>");
            return token;
        });
        encoded = Regex.Replace(encoded, @"^### (.+)$", "<h4>$1</h4>", RegexOptions.Multiline);
        encoded = Regex.Replace(encoded, @"^## (.+)$", "<h3>$1</h3>", RegexOptions.Multiline);
        encoded = Regex.Replace(encoded, @"^# (.+)$", "<h2>$1</h2>", RegexOptions.Multiline);
        encoded = Regex.Replace(encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        encoded = Regex.Replace(encoded, @"`([^`]+)`", "<code>$1</code>");
        encoded = Regex.Replace(encoded, @"\[([^\]]+)\]\((https?://[^\s)]+)\)", "<a href=\"$2\" target=\"_blank\" rel=\"noopener noreferrer\">$1</a>");
        encoded = Regex.Replace(encoded, @"^\s*[-*•]\s+(.+)$", "<span class=\"savi-md-bullet\">• $1</span>", RegexOptions.Multiline);
        encoded = encoded.Replace("\r\n", "\n").Replace("\n", "<br />");
        for (var i = 0; i < codeBlocks.Count; i++) encoded = encoded.Replace($"@@SAVI_CODE_{i}@@", codeBlocks[i], StringComparison.Ordinal);
        return new Microsoft.AspNetCore.Components.MarkupString(encoded);
    }

    private void ToggleActivityDrawer()
    {
        _showActivity = !_showActivity;
    }

    private async Task HandleActionDecision(bool approved)
    {
        if (_pendingApproval == null) return;

        var actionId = _pendingApproval.ActionId;
        _pendingApproval = null;
        _isProcessing = true;

        try
        {
            var req = new AgentRequest
            {
                Message = approved ? "User approved the requested action." : "User cancelled the requested action.",
                ConversationId = _currentConversationId ?? string.Empty,
                ApprovedActionId = actionId,
                ActionApproved = approved
            };

            var res = await Orchestrator.ProcessAsync(req);
            _messages.Add(new MessageDto
            {
                Id = Guid.NewGuid().ToString(),
                Role = MessageRole.Assistant,
                Content = res.Message,
                Timestamp = DateTimeOffset.UtcNow,
                Sources = res.Sources,
                ActivityLogs = res.ActivityLogs.ToList()
            });

            if (_talkBackEnabled)
            {
                _voiceState = VoiceState.Speaking;
                try
                {
                    await JS.InvokeVoidAsync("saviVoice.speak", res.Message);
                }
                catch { }
            }
        }
        finally
        {
            _isProcessing = false;
            if (_voiceState != VoiceState.Speaking)
            {
                _voiceState = VoiceState.Idle;
            }
            StateHasChanged();
        }
    }
}
