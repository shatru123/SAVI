@page "/voice"
@page "/voice/{ConversationId?}"
@using SAVI.Core.Enums
@using SAVI.Application.DTOs
@using SAVI.Core.Interfaces
@inject IAgentOrchestrator Orchestrator
@inject IConversationService ConversationService
@inject ISettingsService SettingsService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IWebHostEnvironment HostEnvironment
@implements IAsyncDisposable

<PageTitle>SAVI — Real-Time Voice Conversation</PageTitle>

<div class="savi-voice-timeline-shell @(_voiceState == VoiceState.Interrupted ? "savi-interrupted-pulse" : "")" role="region" aria-label="SAVI Real-Time Voice Conversation">
    <!-- Clean Top Header -->
    <header class="voice-page-header" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; border-bottom: 1px solid rgba(0, 240, 255, 0.12); background: rgba(3, 7, 18, 0.6); flex-shrink: 0;">
        <div style="display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1;">
            <span class="voice-live-dot @(_voiceState == VoiceState.Listening || _voiceState == VoiceState.DetectingSpeech || _voiceState == VoiceState.Speaking || _voiceState == VoiceState.UserSpeaking ? "live-active" : "")"></span>
            <div style="display: flex; flex-direction: column; min-width: 0;">
                <span style="font-family: var(--savi-font); font-weight: 800; font-size: 0.88rem; letter-spacing: 1.5px; color: var(--savi-cyan);">SAVI NEURAL VOICE</span>
                <span style="font-size: 0.68rem; color: var(--savi-text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 280px;">@_activeTitle</span>
            </div>
            <span class="voice-brand-badge savi-desktop-only">REAL-TIME CONVERSATION</span>
        </div>

        <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
            <!-- Acoustic Mode Pill -->
            <button class="telemetry-pill" style="cursor: pointer; background: rgba(0, 240, 255, 0.1); border-color: rgba(0, 240, 255, 0.3); color: #00f0ff;" @onclick="ToggleAudioOutputMode" title="Toggle Speaker Mode (echo filter active) vs Headphone Mode">
                @(_audioOutputMode == "speaker" ? "🔊 Speaker" : "🎧 Headphone")
            </button>

            <!-- Advanced Voice Settings Toggle -->
            <button class="savi-btn savi-btn-sm savi-btn-subtle" @onclick="() => _showSettingsModal = !_showSettingsModal" title="Voice Settings & Diagnostics">
                <span>⚙</span>
            </button>

            <!-- Back to Chat -->
            <button class="voice-back-btn" @onclick="NavigateBackToChat" title="Return to Text Chat Screen">
                <span class="back-icon">💬</span>
                <span class="back-label savi-desktop-only">Back to Chat</span>
            </button>
        </div>
    </header>

    <!-- Main Content Area: Timeline (65-75%) + Voice Controls/Orb (25-35%) -->
    <div style="display: flex; flex-direction: column; flex: 1; min-height: 0; position: relative; overflow: hidden;">
        <!-- Persistent Conversation Timeline -->
        <section class="savi-voice-timeline" id="voice-timeline-container" tabindex="0" aria-live="polite" @onscroll="HandleTimelineScroll">
            @if (_messages.Count == 0 && string.IsNullOrWhiteSpace(_liveInterimTranscript) && !_showGotItBanner)
            {
                <div style="text-align: center; color: var(--savi-text-dim); margin: auto; padding: 24px; max-width: 440px;">
                    <div style="font-size: 1.15rem; color: var(--savi-text-primary); font-weight: 700; margin-bottom: 6px;">
                        "I'm listening, Shatru."
                    </div>
                    <div style="font-size: 0.82rem; color: var(--savi-text-secondary); line-height: 1.5;">
                        Speak naturally. Your questions and SAVI's spoken responses will remain right here in this timeline.
                    </div>
                </div>
            }
            else
            {
                @foreach (var msg in _messages)
                {
                    <div class="savi-voice-turn @(msg.Role == MessageRole.User ? "savi-voice-turn-user" : "savi-voice-turn-assistant")">
                        <div class="savi-voice-turn-header">
                            <span>@(msg.Role == MessageRole.User ? "YOU" : "SAVI")</span>
                            <span style="color: var(--savi-text-dim); font-size: 0.65rem; font-weight: normal;">
                                @msg.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                            </span>
                        </div>
                        <div style="font-size: 0.94rem; line-height: 1.5; word-break: break-word;">
                            @msg.Content
                        </div>
                    </div>
                }
            }

            <!-- Live Speech Card (Actively Transcribing) -->
            @if (!string.IsNullOrWhiteSpace(_liveInterimTranscript))
            {
                <div class="savi-voice-live-turn" aria-live="assertive">
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; font-size: 0.72rem; color: #00f0ff; font-weight: 700;">
                        <span style="display: flex; align-items: center; gap: 6px;">
                            <span style="animation: savi-pulse 0.8s infinite; display: inline-block;">🎙️</span>
                            <span>YOU · LIVE</span>
                        </span>
                        <span style="font-size: 0.68rem; color: #aaffcc;">HEARING YOU...</span>
                    </div>
                    <div style="font-size: 0.96rem; font-style: italic; color: #ffffff;">
                        "@_liveInterimTranscript"
                    </div>
                </div>
            }

            <!-- GOT IT Confirmation (Brief 600ms banner) -->
            @if (_showGotItBanner)
            {
                <div class="savi-voice-turn savi-voice-turn-user" style="border-color: var(--savi-success);">
                    <div class="savi-voice-turn-header" style="color: var(--savi-success);">
                        <span class="savi-got-it-banner">✓ GOT IT</span>
                        <span style="color: var(--savi-text-dim); font-size: 0.65rem;">Now</span>
                    </div>
                    <div style="font-size: 0.94rem; color: #fff;">
                        @_lastConfirmedUserSpeech
                    </div>
                </div>
            }

            <!-- Thinking Indicator (Question stays visible above!) -->
            @if (_voiceState == VoiceState.Processing)
            {
                <div class="savi-voice-thinking-indicator">
                    <span style="animation: savi-spin-slow 1.5s linear infinite; display: inline-block;">◈</span>
                    <span>THINKING &amp; REASONING...</span>
                </div>
            }

            <!-- Speaking Indicator -->
            @if (_voiceState == VoiceState.Speaking)
            {
                <div class="savi-voice-speaking-indicator">
                    <span class="core-center-pulse" style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #22c55e;"></span>
                    <span>SAVI IS SPEAKING...</span>
                </div>
            }
        </section>

        <!-- Floating "↓ New activity" Auto-Scroll Button -->
        @if (_hasNewUnreadActivity)
        {
            <button class="savi-scroll-bottom-btn" @onclick="ScrollToBottomExplicit" title="Jump to latest turn">
                <span>↓ New activity</span>
            </button>
        }

        <!-- Compact Orb & State Pill Stage -->
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 10px 16px 6px; background: rgba(3, 7, 18, 0.4); border-top: 1px solid rgba(0, 240, 255, 0.1); flex-shrink: 0; gap: 8px;">
            <!-- Scaled Reactive Orb SVG -->
            <div class="voice-orb-container state-@_voiceState.ToString().ToLowerInvariant()" style="width: 130px; height: 130px;">
                <div class="voice-audio-ripple ring-1"></div>
                <div class="voice-audio-ripple ring-2"></div>
                <div class="voice-audio-ripple ring-3"></div>

                <div class="voice-orb-svg-wrapper" style="width: 105px; height: 105px;">
                    <svg class="voice-reactor-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <filter id="voice-glow-page" x="-20%" y="-20%" width="140%" height="140%">
                                <feGaussianBlur stdDeviation="4" result="blur" />
                                <feComposite in="SourceGraphic" in2="blur" operator="over" />
                            </filter>
                            <radialGradient id="voice-reactor-grad-page" cx="50%" cy="50%" r="50%">
                                <stop offset="0%" stop-color="#00f0ff" stop-opacity="0.9" />
                                <stop offset="60%" stop-color="#0066cc" stop-opacity="0.5" />
                                <stop offset="100%" stop-color="#050b14" stop-opacity="0.1" />
                            </radialGradient>
                        </defs>

                        <circle cx="100" cy="100" r="90" fill="none" stroke="rgba(0, 240, 255, 0.2)" stroke-width="1.5" stroke-dasharray="6 8" />
                        <g class="voice-rotating-ring">
                            <circle cx="100" cy="100" r="80" fill="none" stroke="#00f0ff" stroke-width="2" stroke-dasharray="50 30 20 30 80 20" filter="url(#voice-glow-page)" />
                            <circle cx="100" cy="20" r="4" fill="#00f0ff" />
                            <circle cx="100" cy="180" r="4" fill="#00f0ff" />
                        </g>
                        <g class="voice-counter-ring">
                            <circle cx="100" cy="100" r="62" fill="none" stroke="#0099ff" stroke-width="2" stroke-dasharray="35 15 25 15" />
                        </g>
                        <circle class="voice-center-orb" cx="100" cy="100" r="38" fill="url(#voice-reactor-grad-page)" stroke="#00f0ff" stroke-width="2" filter="url(#voice-glow-page)" />
                        <text x="100" y="105" text-anchor="middle" fill="#ffffff" font-size="13" font-weight="800" letter-spacing="3" font-family="'JetBrains Mono', monospace">SAVI</text>
                    </svg>
                </div>
            </div>

            <!-- Authoritative State Status Pill -->
            <div class="voice-state-pill pill-@GetVisualStatePillClass()">
                <span class="pill-dot @GetVisualStateDotClass()"></span>
                <span>@GetVisualStateText()</span>
            </div>

            @if (!string.IsNullOrEmpty(_voiceError))
            {
                <div class="voice-error-banner" style="max-width: 600px;">
                    <span>⚠️ @_voiceError</span>
                    <button class="voice-error-dismiss" @onclick="() => _voiceError = null">✕</button>
                </div>
            }
        </div>
    </div>

    <!-- Bottom Controls Toolbar -->
    <footer class="voice-page-footer" style="padding: 12px 18px calc(14px + var(--savi-safe-bottom)); background: rgba(3, 7, 18, 0.9); border-top: 1px solid rgba(0, 240, 255, 0.12); flex-shrink: 0;">
        <div class="voice-controls-bar">
            <!-- Mute / Unmute Button -->
            <button class="voice-ctl-btn @(_isMicMuted ? "btn-danger" : "btn-subtle")" @onclick="ToggleVoiceMute" title="Mute / Unmute Microphone">
                <span class="ctl-icon">@(_isMicMuted ? "🔇" : "🎙️")</span>
                <span class="ctl-label">@(_isMicMuted ? "Unmute Mic" : "Mute Mic")</span>
            </button>

            <!-- Instant Barge-In Stop Button (Active while speaking or thinking) -->
            @if (_voiceState == VoiceState.Speaking || _voiceState == VoiceState.Processing)
            {
                <button class="voice-ctl-btn btn-danger-accent barge-in-btn" @onclick="InterruptSpeaking" title="Barge-in / Stop Audio Immediately (Esc)">
                    <span class="ctl-icon">⏹</span>
                    <span class="ctl-label">Stop Speaking</span>
                </button>
            }

            <!-- Pause / Resume Session -->
            <button class="voice-ctl-btn @(!_isListening ? "btn-warning" : "btn-subtle")" @onclick="ToggleVoicePause" title="Pause / Resume Continuous Listening">
                <span class="ctl-icon">@(!_isListening ? "▶️" : "⏸")</span>
                <span class="ctl-label">@(!_isListening ? "Resume" : "Pause")</span>
            </button>

            <!-- Output Mode Toggle -->
            <button class="voice-ctl-btn btn-subtle" @onclick="ToggleAudioOutputMode" title="Toggle between Speaker and Headphone mode">
                <span class="ctl-icon">@(_audioOutputMode == "speaker" ? "🔊" : "🎧")</span>
                <span class="ctl-label">@(_audioOutputMode == "speaker" ? "Speaker" : "Headphone")</span>
            </button>

            <!-- Return to Chat Button -->
            <button class="voice-ctl-btn btn-exit-primary" @onclick="NavigateBackToChat" title="Return to text conversation">
                <span class="ctl-icon">💬</span>
                <span class="ctl-label">Chat</span>
            </button>
        </div>
    </footer>
</div>

<!-- Voice Settings & Telemetry Modal -->
@if (_showSettingsModal)
{
    <div class="savi-drawer-backdrop active" @onclick="() => _showSettingsModal = false" style="z-index: 2000;">
        <div class="savi-glass-panel" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90%; max-width: 480px; padding: 22px; z-index: 2001;" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 10px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 1.1rem; color: var(--savi-cyan);">⚙</span>
                    <span class="savi-glow-text" style="font-weight: 700; font-size: 1rem;">VOICE SETTINGS &amp; TELEMETRY</span>
                </div>
                <button class="savi-btn savi-btn-sm" @onclick="() => _showSettingsModal = false">✕</button>
            </div>

            <div style="display: flex; flex-direction: column; gap: 14px; font-size: 0.84rem; color: var(--savi-text-secondary);">
                <!-- Output Mode -->
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-weight: 600; color: var(--savi-text-primary);">Acoustic Mode</div>
                        <div style="font-size: 0.72rem; color: var(--savi-text-dim);">Speaker mode activates real-time acoustic self-echo rejection</div>
                    </div>
                    <button class="savi-btn savi-btn-sm" @onclick="ToggleAudioOutputMode">
                        @(_audioOutputMode == "speaker" ? "🔊 Speaker" : "🎧 Headphone")
                    </button>
                </div>

                <!-- Telemetry Stats -->
                <div style="background: rgba(0, 240, 255, 0.05); border: 1px solid var(--savi-border-subtle); border-radius: 6px; padding: 12px; display: flex; flex-direction: column; gap: 6px; font-family: var(--savi-font); font-size: 0.74rem;">
                    <div>AEC Hardware: <strong style="color: #00f0ff;">@GetAudioCapabilityStatus(_hardwareAec)</strong></div>
                    <div>Noise Suppression: <strong style="color: #00f0ff;">@GetAudioCapabilityStatus(_hardwareNs)</strong></div>
                    <div>Echo Suppressions: <strong style="color: #00f0ff;">@_falseSelfDetectionCount</strong></div>
                    @if (_lastAudioStopLatencyMs > 0)
                    {
                        <div>Last Barge-in Latency: <strong style="color: #fbbf24;">@(Math.Round(_lastAudioStopLatencyMs)) ms</strong></div>
                    }
                </div>

                <button class="savi-btn savi-btn-sm savi-btn-subtle" @onclick="RefreshDiagnostics">
                    ⟳ Reload Diagnostics
                </button>
                @if (_showDiagnostics)
                {
                    <pre style="max-height: 140px; overflow: auto; background: rgba(0,0,0,0.5); padding: 8px; border-radius: 4px; font-size: 0.7rem; color: #a5f3fc;">@_browserDiagnosticsJson</pre>
                }
            </div>
        </div>
    </div>
}

<style>
    .savi-voice-page-root {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        min-height: calc(100vh - 80px);
        min-height: calc(100lvh - 80px);
        min-height: calc(100svh - 80px);
        min-height: calc(100dvh - 80px);
        background: radial-gradient(circle at 50% 35%, rgba(10, 26, 47, 0.95) 0%, rgba(3, 7, 18, 0.99) 100%);
        border: 1px solid var(--savi-border-subtle);
        border-radius: 12px;
        color: #f8fafc;
        overflow: hidden;
        position: relative;
    }

    .savi-interrupted-pulse {
        animation: saviInterruptedFlash 0.3s ease-out;
    }

    @@keyframes saviInterruptedFlash {
        0% { background: radial-gradient(circle at 50% 35%, rgba(245, 158, 11, 0.25) 0%, rgba(3, 7, 18, 0.99) 100%); }
        100% { background: radial-gradient(circle at 50% 35%, rgba(10, 26, 47, 0.95) 0%, rgba(3, 7, 18, 0.99) 100%); }
    }

    /* Top HUD */
    .voice-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 24px;
        border-bottom: 1px solid rgba(0, 240, 255, 0.12);
        background: rgba(3, 7, 18, 0.4);
    }

    .voice-page-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .voice-live-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #64748b;
        transition: all 0.3s ease;
    }

    .voice-live-dot.live-active {
        background: #00f0ff;
        box-shadow: 0 0 12px #00f0ff, 0 0 20px rgba(0, 240, 255, 0.5);
        animation: pulseDot 1.5s infinite alternate;
    }

    @@keyframes pulseDot {
        0% { transform: scale(0.9); opacity: 0.8; }
        100% { transform: scale(1.2); opacity: 1; }
    }

    .voice-brand-title {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 800;
        letter-spacing: 2px;
        font-size: 0.95rem;
        color: #f8fafc;
    }

    .voice-conv-title {
        font-size: 0.68rem;
        color: var(--savi-text-dim);
    }

    .voice-brand-badge {
        font-size: 0.65rem;
        padding: 3px 8px;
        border-radius: 9999px;
        background: rgba(0, 240, 255, 0.12);
        color: #00f0ff;
        border: 1px solid rgba(0, 240, 255, 0.3);
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: 1px;
    }

    .voice-telemetry-hud {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .telemetry-pill {
        font-size: 0.72rem;
        font-family: 'JetBrains Mono', monospace;
        padding: 4px 10px;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #94a3b8;
    }

    .barge-in-pill {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border-color: rgba(245, 158, 11, 0.4);
        font-weight: 600;
    }

    .voice-back-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #f1f5f9;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.82rem;
        font-weight: 600;
        transition: all 0.2s;
    }

    .voice-back-btn:hover {
        background: rgba(0, 240, 255, 0.15);
        border-color: rgba(0, 240, 255, 0.4);
        color: #00f0ff;
    }

    /* Center Stage */
    .voice-page-center {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px 24px;
        gap: 20px;
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
    }

    /* Reactive Orb */
    .voice-orb-container {
        position: relative;
        width: 230px;
        height: 230px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .voice-orb-svg-wrapper {
        position: relative;
        width: 180px;
        height: 180px;
        z-index: 2;
    }

    .voice-reactor-svg {
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .voice-rotating-ring {
        transform-origin: 100px 100px;
        animation: rotateClockwise 14s linear infinite;
    }

    .voice-counter-ring {
        transform-origin: 100px 100px;
        animation: rotateCounter 20s linear infinite;
    }

    @@keyframes rotateClockwise {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    @@keyframes rotateCounter {
        from { transform: rotate(0deg); }
        to { transform: rotate(-360deg); }
    }

    /* Audio Ripple Waves */
    .voice-audio-ripple {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 1.5px solid rgba(0, 240, 255, 0.3);
        pointer-events: none;
        transform: scale(calc(1 + var(--savi-audio-level, 0) * 0.4));
        opacity: calc(0.2 + var(--savi-audio-level, 0) * 0.6);
        transition: transform 0.08s ease-out, opacity 0.08s ease-out;
    }

    .voice-audio-ripple.ring-2 {
        inset: -18px;
        border-color: rgba(0, 153, 255, 0.2);
        transform: scale(calc(1 + var(--savi-audio-level, 0) * 0.6));
    }

    .voice-audio-ripple.ring-3 {
        inset: -36px;
        border-color: rgba(0, 240, 255, 0.1);
        transform: scale(calc(1 + var(--savi-audio-level, 0) * 0.8));
    }

    .state-speaking .voice-center-orb {
        animation: pulseCore 1s infinite alternate;
    }

    .state-processing .voice-rotating-ring {
        animation-duration: 3s;
    }

    .state-interrupted .voice-reactor-svg text {
        fill: #f59e0b;
    }

    @@keyframes pulseCore {
        0% { r: 35; }
        100% { r: 42; }
    }

    /* State Pill */
    .voice-state-pill-wrapper {
        display: flex;
        justify-content: center;
    }

    .voice-state-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 18px;
        border-radius: 9999px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .pill-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .pill-listening {
        background: rgba(0, 240, 255, 0.12);
        border: 1px solid rgba(0, 240, 255, 0.4);
        color: #00f0ff;
    }
    .listening-dot { background: #00f0ff; box-shadow: 0 0 8px #00f0ff; }

    .pill-detectingspeech {
        background: rgba(250, 204, 21, 0.15);
        border: 1px solid rgba(250, 204, 21, 0.4);
        color: #facc15;
    }
    .detecting-dot { background: #facc15; box-shadow: 0 0 8px #facc15; }

    .pill-processing {
        background: rgba(168, 85, 247, 0.15);
        border: 1px solid rgba(168, 85, 247, 0.4);
        color: #c084fc;
    }
    .thinking-dot { background: #c084fc; box-shadow: 0 0 8px #c084fc; animation: pulseDot 1s infinite; }

    .pill-speaking {
        background: rgba(34, 197, 94, 0.15);
        border: 1px solid rgba(34, 197, 94, 0.4);
        color: #4ade80;
    }
    .speaking-dot { background: #4ade80; box-shadow: 0 0 8px #4ade80; }

    .pill-interrupted {
        background: rgba(245, 158, 11, 0.2);
        border: 1px solid rgba(245, 158, 11, 0.6);
        color: #fbbf24;
    }
    .interrupted-dot { background: #fbbf24; box-shadow: 0 0 10px #fbbf24; }

    .pill-error {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #f87171;
    }
    .error-dot { background: #f87171; }

    .pill-idle {
        background: rgba(148, 163, 184, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.25);
        color: #94a3b8;
    }
    .idle-dot { background: #94a3b8; }

    /* Dual Transcript Stream */
    .voice-transcript-stream {
        width: 100%;
        display: flex;
