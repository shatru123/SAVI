@code {
    [Parameter]
    public string? ConversationId { get; set; }

    private string _currentConversationId = string.Empty;
    private string _activeTitle = "Voice Conversation";
    private VoiceState _voiceState = VoiceState.Idle;
    private bool _isListening = false;
    private bool _isMicMuted = false;
    private string _audioOutputMode = "speaker";
    private int _falseSelfDetectionCount = 0;
    private bool _hardwareAec;
    private bool _hardwareNs;
    private bool _hardwareAgc;
    private bool _audioSettingsReported;
    private double _lastAudioStopLatencyMs = 0;
    private string? _voiceError;
    private bool _voiceSupported = true;
    private bool _showDiagnostics = false;
    private string _browserDiagnosticsJson = "Diagnostics unavailable.";

    private string _liveInterimTranscript = string.Empty;
    private string _lastUserUtterance = string.Empty;
    private string _lastAssistantResponse = string.Empty;
    private string? _activeTurnId;
    private string? _voiceSessionId;
    private string? _voiceGenerationId;
    private CancellationTokenSource? _processingCts;

    private List<MessageDto> _messages = new();
    private bool _showGotItBanner = false;
    private string _lastConfirmedUserSpeech = string.Empty;
    private bool _showSettingsModal = false;
    private bool _isUserScrolledUp = false;
    private bool _hasNewUnreadActivity = false;
    private string _lastTurnNormalizedText = string.Empty;
    private DateTime _lastTurnTime = DateTime.MinValue;

    private DotNetObjectReference<VoicePage>? _dotNetRef;

    private string DisplayUserTranscript =>
        !string.IsNullOrWhiteSpace(_liveInterimTranscript) ? _liveInterimTranscript : _lastUserUtterance;

    private string DisplayAssistantTranscript => _lastAssistantResponse;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(ConversationId))
        {
            await LoadConversationByIdAsync(ConversationId);
        }
        else
        {
            var summaries = await ConversationService.GetSummariesAsync();
            var latest = summaries.FirstOrDefault();
            if (latest != null)
            {
                await LoadConversationByIdAsync(latest.Id);
            }
            else
            {
                var newConv = await ConversationService.GetOrCreateAsync(null);
                await LoadConversationByIdAsync(newConv.Id);
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ConversationId) && ConversationId != _currentConversationId)
        {
            await LoadConversationByIdAsync(ConversationId);
        }
    }

    private async Task LoadConversationByIdAsync(string id)
    {
        _currentConversationId = id;
        var conv = await ConversationService.GetByIdAsync(id);
        if (conv != null)
        {
            _activeTitle = conv.Title;
            _messages = conv.Messages.ToList();
            var lastUser = conv.Messages.LastOrDefault(m => m.Role == MessageRole.User);
            _lastUserUtterance = lastUser?.Content ?? string.Empty;
            var lastAsst = conv.Messages.LastOrDefault(m => m.Role == MessageRole.Assistant);
            _lastAssistantResponse = lastAsst?.Content ?? string.Empty;
        }
        else
        {
            _activeTitle = "Voice Conversation";
            _messages.Clear();
            _lastUserUtterance = string.Empty;
            _lastAssistantResponse = string.Empty;
        }

        if (_voiceSupported && _dotNetRef != null)
        {
            try
            {
                await JS.InvokeVoidAsync("saviVoice.setConversationId", id);
            }
            catch { }
        }

        await AutoScrollIfNeeded();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                _voiceSupported = await JS.InvokeAsync<bool>("saviVoice.init", _dotNetRef, _currentConversationId ?? string.Empty);
                await JS.InvokeVoidAsync("saviVoice.setConversationId", _currentConversationId);
                if (!_voiceSupported)
                {
                    _voiceError = "Voice recognition is not available in this browser. Press Back to Chat to continue with text.";
                }
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"SAVI voice initialization error: {ex}");
                _voiceError = "Voice initialization could not complete. You can continue this conversation in Chat mode.";
            }
            StateHasChanged();
        }
    }

    private async Task RefreshDiagnostics()
    {
        try
        {
            _browserDiagnosticsJson = await JS.InvokeAsync<string>("saviVoice.getDiagnosticsJson");
            _showDiagnostics = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"SAVI diagnostics error: {ex}");
            _browserDiagnosticsJson = "Diagnostics are unavailable right now.";
            _showDiagnostics = true;
        }
    }

    private void NavigateBackToChat()
    {
        Navigation.NavigateTo($"/chat/{_currentConversationId}");
    }

    private async Task ToggleVoiceMute()
    {
        _isMicMuted = !_isMicMuted;
        try
        {
            if (_isMicMuted)
            {
                await JS.InvokeVoidAsync("saviVoice.setContinuousMode", false);
                _isListening = false;
            }
            else
            {
                await JS.InvokeVoidAsync("saviVoice.setContinuousMode", true);
                _isListening = true;
                _voiceState = VoiceState.Listening;
            }
        }
        catch { }
        StateHasChanged();
    }

    private async Task ToggleVoicePause()
    {
        try
        {
            if (_isListening)
            {
                await JS.InvokeVoidAsync("saviVoice.setContinuousMode", false);
                _isListening = false;
                _voiceState = VoiceState.Paused;
            }
            else
            {
                await JS.InvokeVoidAsync("saviVoice.setContinuousMode", true);
                _isListening = true;
                _voiceState = VoiceState.Listening;
            }
        }
        catch { }
        StateHasChanged();
    }

    private async Task InterruptSpeaking()
    {
        try
        {
            await JS.InvokeVoidAsync("saviVoice.interruptSpeaking");
        }
        catch { }
    }

    private async Task ToggleAudioOutputMode()
    {
        _audioOutputMode = _audioOutputMode == "speaker" ? "headphone" : "speaker";
        try
        {
            await JS.InvokeVoidAsync("saviVoice.setAudioOutputMode", _audioOutputMode);
        }
        catch { }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVadSpeechStarted(double timestampMs, string? turnId = null, string? generationId = null, string? sessionId = null)
    {
        if (!AcceptVoiceCallback(turnId, generationId, sessionId)) return;
        _voiceState = VoiceState.UserSpeaking;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnUserInterrupted(double audioStopLatencyMs = 0, string? turnId = null, string? generationId = null, string? sessionId = null)
    {
        if (!AcceptVoiceCallback(turnId, generationId, sessionId)) return;
        if (audioStopLatencyMs > 0)
        {
            _lastAudioStopLatencyMs = audioStopLatencyMs;
        }
        if (_voiceState == VoiceState.Speaking)
        {
            _voiceState = VoiceState.Interrupted;
        }
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnSpeechInterim(string text, string? turnId = null, string? generationId = null, string? sessionId = null)
    {
        if (!AcceptVoiceCallback(turnId, generationId, sessionId)) return;
        if (!string.IsNullOrWhiteSpace(text))
        {
            _liveInterimTranscript = text;
            _voiceState = VoiceState.DetectingSpeech;
            _voiceError = null;
            _ = AutoScrollIfNeeded();
            InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnSpeechRecognized(string transcript, string? turnId = null, string? generationId = null, string? sessionId = null)
    {
        if (string.IsNullOrWhiteSpace(transcript)) return;
        if (!AcceptVoiceCallback(turnId, generationId, sessionId)) return;

        var cleanText = transcript.Trim();
        var normalized = cleanText.ToLowerInvariant();

        // Turn deduplication: reject if identical phrase arrives within 1200ms
        if (_lastTurnNormalizedText == normalized && (DateTime.UtcNow - _lastTurnTime).TotalMilliseconds < 1200)
        {
            return;
        }

        _lastTurnNormalizedText = normalized;
        _lastTurnTime = DateTime.UtcNow;

        _liveInterimTranscript = string.Empty;
        _lastUserUtterance = cleanText;
        _lastConfirmedUserSpeech = cleanText;
        _voiceError = null;

        // Immediately commit user turn to visible timeline
        var userMsg = new MessageDto
        {
            Role = MessageRole.User,
            Content = cleanText,
            Timestamp = DateTime.UtcNow
        };
        _messages.Add(userMsg);

        // Show brief "✓ GOT IT" confirmation banner
        _showGotItBanner = true;
        await AutoScrollIfNeeded();
        StateHasChanged();

        // After 600ms, hide the banner as processing continues
        _ = Task.Run(async () =>
        {
            await Task.Delay(600);
            _showGotItBanner = false;
            await InvokeAsync(StateHasChanged);
        });

        var assignedTurnId = turnId ?? ("turn_" + Guid.NewGuid().ToString("N"));
        _activeTurnId = assignedTurnId;

        var oldCts = _processingCts;
        _processingCts = new CancellationTokenSource();
        var currentToken = _processingCts.Token;

        try
        {
            oldCts?.Cancel();
            oldCts?.Dispose();
        }
        catch { }

        _voiceState = VoiceState.Processing;
        await AutoScrollIfNeeded();
        StateHasChanged();

        try
        {
            try { await JS.InvokeVoidAsync("saviVoice.markProcessing", assignedTurnId, generationId); } catch { }
            var req = new AgentRequest
            {
                Message = cleanText,
                ConversationId = _currentConversationId,
                VoiceActive = true,
                ClientType = "VoicePage"
            };

            var res = await Orchestrator.ProcessAsync(req, currentToken);

            if (currentToken.IsCancellationRequested || _activeTurnId != assignedTurnId) return;

            var spokenText = !string.IsNullOrWhiteSpace(res.VoiceFriendlyMessage)
                ? res.VoiceFriendlyMessage
                : res.Message;

            _lastAssistantResponse = spokenText;

            // Commit assistant response to timeline
            var asstMsg = new MessageDto
            {
                Role = MessageRole.Assistant,
                Content = spokenText,
                Timestamp = DateTime.UtcNow
            };
            _messages.Add(asstMsg);

            _voiceState = VoiceState.Speaking;
            await AutoScrollIfNeeded();
            StateHasChanged();

            try
            {
                await JS.InvokeVoidAsync("saviVoice.speak", spokenText, 1.0, assignedTurnId, generationId);
            }
            catch { }
        }
        catch (OperationCanceledException)
        {
            if (_activeTurnId == assignedTurnId)
            {
                _voiceState = VoiceState.Listening;
            }
        }
        catch (Exception ex)
        {
            if (!currentToken.IsCancellationRequested && _activeTurnId == assignedTurnId)
            {
                Console.Error.WriteLine($"SAVI voice turn error: {ex}");
                _voiceError = "I ran into a problem while processing that voice request. Please try again.";
                _voiceState = VoiceState.Error;
            }
        }
        finally
        {
            if (_activeTurnId == assignedTurnId && _voiceState != VoiceState.Speaking && _voiceState != VoiceState.Interrupted)
            {
                _voiceState = VoiceState.Listening;
                StateHasChanged();
            }
        }
    }

    [JSInvokable]
    public void OnVoiceStateChanged(int stateCode, string? turnId = null, string? generationId = null, string? sessionId = null)
    {
        if (!AcceptVoiceCallback(turnId, generationId, sessionId)) return;
        if (!Enum.IsDefined(typeof(VoiceState), stateCode)) return;
        _voiceState = (VoiceState)stateCode;
        _isListening = _voiceState == VoiceState.Listening;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnVoiceError(string errorMessage)
    {
        _voiceError = errorMessage;
        _isListening = false;
        _voiceState = VoiceState.Error;
        InvokeAsync(StateHasChanged);
    }

    private bool AcceptVoiceCallback(string? turnId, string? generationId, string? sessionId)
    {
        if (!string.IsNullOrWhiteSpace(sessionId))
        {
            if (_voiceSessionId != null && !string.Equals(_voiceSessionId, sessionId, StringComparison.Ordinal)) return false;
            _voiceSessionId = sessionId;
        }

        if (!string.IsNullOrWhiteSpace(generationId))
        {
            _voiceGenerationId = generationId;
        }

        return true;
    }

    [JSInvokable]
    public void OnAudioSettingsDetected(bool aec, bool ns, bool agc, int sampleRate)
    {
        _hardwareAec = aec;
        _hardwareNs = ns;
        _hardwareAgc = agc;
        _audioSettingsReported = true;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnSelfEchoSuppressed(string echoedText, int count)
    {
        _falseSelfDetectionCount = count;
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleTimelineScroll()
    {
        try
        {
            var isNearBottom = await JS.InvokeAsync<bool>("saviBrowser.isScrolledNearBottom", "voice-timeline-container", 80);
            _isUserScrolledUp = !isNearBottom;
            if (!_isUserScrolledUp)
            {
                _hasNewUnreadActivity = false;
            }
        }
        catch { }
    }

    private async Task ScrollToBottomExplicit()
    {
        _isUserScrolledUp = false;
        _hasNewUnreadActivity = false;
        try
        {
            await JS.InvokeVoidAsync("saviBrowser.scrollToBottom", "voice-timeline-container");
        }
        catch { }
        StateHasChanged();
    }

    private async Task AutoScrollIfNeeded()
    {
        if (_isUserScrolledUp)
        {
            _hasNewUnreadActivity = true;
        }
        else
        {
            _hasNewUnreadActivity = false;
            try
            {
                await JS.InvokeVoidAsync("saviBrowser.scrollToBottom", "voice-timeline-container");
            }
            catch { }
        }
    }

    private string GetVisualStateText() => _voiceState switch
    {
        VoiceState.Listening => "Listening...",
        VoiceState.UserSpeaking => "You're speaking...",
        VoiceState.DetectingSpeech => "Hearing you...",
        VoiceState.Processing => "SAVI is thinking...",
        VoiceState.Speaking => "SAVI is speaking...",
        VoiceState.Interrupted => "Barged in / Interrupted",
        VoiceState.Paused => "Listening Paused",
        VoiceState.Error => "Voice Error",
        _ => "Voice Ready"
    };

    private string GetVisualStatePillClass() => _voiceState switch
    {
        VoiceState.Listening => "listening",
        VoiceState.UserSpeaking or VoiceState.DetectingSpeech => "detectingspeech",
        VoiceState.Processing => "processing",
        VoiceState.Speaking => "speaking",
        VoiceState.Interrupted => "interrupted",
        VoiceState.Error => "error",
        _ => "idle"
    };

    private string GetVisualStateDotClass() => _voiceState switch
    {
        VoiceState.Listening => "listening-dot",
        VoiceState.UserSpeaking or VoiceState.DetectingSpeech => "detecting-dot",
        VoiceState.Processing => "thinking-dot",
        VoiceState.Speaking => "speaking-dot",
        VoiceState.Interrupted => "interrupted-dot",
        VoiceState.Error => "error-dot",
        _ => "idle-dot"
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("saviVoice.shutdown");
        }
        catch { }
        _dotNetRef?.Dispose();
    }

    private string GetAudioCapabilityStatus(bool enabled) =>
        !_audioSettingsReported ? "Unsupported" : enabled ? "Enabled" : "Disabled";
}
