@page "/admin/users/{UserId}"
@attribute [Authorize(Roles = "Owner")]
@inject IAdminService AdminService
@inject NavigationManager Navigation

<PageTitle>SAVI — Operator Profile Inspection</PageTitle>

<div class="savi-glass-panel savi-hud-bracket" style="padding: 24px; min-height: calc(100vh - 80px); box-sizing: border-box;">
    <!-- Header -->
    <div style="border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 18px; margin-bottom: 22px;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <a href="/admin/users" style="font-size: 0.75rem; color: var(--savi-cyan); text-decoration: none; font-family: var(--savi-font);">&larr; Back to Operators</a>
            <span style="color: var(--savi-text-dim); font-size: 0.75rem;">/</span>
            <span style="font-size: 0.75rem; color: var(--savi-text-secondary); font-family: var(--savi-font);">Profile Inspection</span>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
            <div>
                <h1 class="savi-glow-text" style="margin: 0; font-size: 1.45rem; font-weight: 800; letter-spacing: 2px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                    <span>@(Details?.User.DisplayName ?? "Loading...")</span>
                    @if (Details != null)
                    {
                        <span class="savi-badge" style="font-size: 0.65rem; padding: 2px 8px; @(Details.User.Role == "Owner" ? "color: #ffaa00; border-color: rgba(255, 170, 0, 0.4); background: rgba(255, 170, 0, 0.1);" : "color: var(--savi-cyan); border-color: var(--savi-border-subtle);")">
                            @Details.User.Role
                        </span>
                    }
                </h1>
                <div style="font-size: 0.78rem; color: var(--savi-text-secondary); margin-top: 6px; font-family: var(--savi-font);">
                    Email: <span style="color: var(--savi-text-primary);">@(Details?.User.Email ?? "-")</span> | ID: <span style="color: var(--savi-text-dim);">@UserId</span>
                </div>
            </div>

            <!-- Read-Only Banner Badge -->
            <div class="savi-glass-panel" style="padding: 8px 14px; border-color: rgba(255, 170, 0, 0.4); background: rgba(255, 170, 0, 0.08); display: flex; align-items: center; gap: 8px; color: #ffaa00; font-size: 0.75rem; letter-spacing: 0.5px;">
                <span>🔒</span>
                <span style="font-weight: 700;">ADMIN READ-ONLY INSPECTION</span>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div style="text-align: center; padding: 60px 20px; color: var(--savi-cyan); font-family: var(--savi-font);">
            <div style="display: inline-block; width: 28px; height: 28px; border: 2px solid var(--savi-cyan); border-top-color: transparent; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 12px;"></div>
            <div style="font-size: 0.85rem; letter-spacing: 1.5px;">RETRIEVING OPERATOR TELEMETRY...</div>
        </div>
    }
    else if (Details == null)
    {
        <div class="savi-glass-panel" style="padding: 40px; text-align: center; border-color: rgba(255, 0, 85, 0.4); background: rgba(255, 0, 85, 0.05);">
            <p style="color: #ff6688; font-size: 0.88rem; margin-bottom: 12px;">Operator not found.</p>
            <a href="/admin/users" class="savi-btn savi-btn-sm" style="text-decoration: none;">Return to Operator Registry</a>
        </div>
    }
    else
    {
        <!-- Tab Navigation -->
        <div style="display: flex; border-bottom: 1px solid var(--savi-border-subtle); gap: 8px; margin-bottom: 24px; font-size: 0.8rem; font-family: var(--savi-font); overflow-x: auto;">
            <button @onclick="@(() => ActiveTab = "conversations")" 
                    style="padding: 8px 16px; background: none; border: none; cursor: pointer; font-family: var(--savi-font); border-bottom: 2px solid @(ActiveTab == "conversations" ? "var(--savi-cyan)" : "transparent"); color: @(ActiveTab == "conversations" ? "var(--savi-cyan)" : "var(--savi-text-secondary)"); font-weight: @(ActiveTab == "conversations" ? "700" : "normal"); transition: all 0.2s;">
                Conversations (@Details.Conversations.Count)
            </button>
            <button @onclick="@(() => ActiveTab = "memory")" 
                    style="padding: 8px 16px; background: none; border: none; cursor: pointer; font-family: var(--savi-font); border-bottom: 2px solid @(ActiveTab == "memory" ? "var(--savi-cyan)" : "transparent"); color: @(ActiveTab == "memory" ? "var(--savi-cyan)" : "var(--savi-text-secondary)"); font-weight: @(ActiveTab == "memory" ? "700" : "normal"); transition: all 0.2s;">
                Memory Items (@Details.MemoryItems.Count)
            </button>
            <button @onclick="@(() => ActiveTab = "tasks")" 
                    style="padding: 8px 16px; background: none; border: none; cursor: pointer; font-family: var(--savi-font); border-bottom: 2px solid @(ActiveTab == "tasks" ? "var(--savi-cyan)" : "transparent"); color: @(ActiveTab == "tasks" ? "var(--savi-cyan)" : "var(--savi-text-secondary)"); font-weight: @(ActiveTab == "tasks" ? "700" : "normal"); transition: all 0.2s;">
                Tasks (@Details.Tasks.Count)
            </button>
            <button @onclick="@(() => ActiveTab = "audit")" 
                    style="padding: 8px 16px; background: none; border: none; cursor: pointer; font-family: var(--savi-font); border-bottom: 2px solid @(ActiveTab == "audit" ? "var(--savi-cyan)" : "transparent"); color: @(ActiveTab == "audit" ? "var(--savi-cyan)" : "var(--savi-text-secondary)"); font-weight: @(ActiveTab == "audit" ? "700" : "normal"); transition: all 0.2s;">
                Audit History (@Details.RecentAuditLogs.Count)
            </button>
        </div>

        <!-- Conversations Tab -->
        @if (ActiveTab == "conversations")
        {
            @if (Details.Conversations.Count == 0)
            {
                <div class="savi-glass-panel" style="padding: 40px; text-align: center; color: var(--savi-text-dim); font-size: 0.85rem;">
                    No conversations initiated by this operator.
                </div>
            }
            else
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px;">
                    @foreach (var conv in Details.Conversations)
                    {
                        <div class="savi-glass-panel" style="padding: 16px; display: flex; flex-direction: column; justify-content: space-between; border-color: var(--savi-border-subtle); transition: all 0.2s;" onmouseover="this.style.borderColor='var(--savi-border-glow)'" onmouseout="this.style.borderColor='var(--savi-border-subtle)'">
                            <div>
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                    <span style="font-size: 0.7rem; color: var(--savi-text-dim); font-family: var(--savi-font);">@conv.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                    <span class="savi-badge" style="font-size: 0.62rem; padding: 2px 6px;">
                                        @conv.MessageCount turns
                                    </span>
                                </div>
                                <h3 style="margin: 0 0 6px 0; font-size: 0.95rem; font-weight: 700; color: var(--savi-text-primary);">
                                    @conv.Title
                                </h3>
                                @if (!string.IsNullOrEmpty(conv.Summary))
                                {
                                    <p style="font-size: 0.75rem; color: var(--savi-text-secondary); margin: 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@conv.Summary</p>
                                }
                            </div>

                            <div style="margin-top: 14px; padding-top: 10px; border-top: 1px solid var(--savi-border-subtle); display: flex; justify-content: flex-end;">
                                <a href="/admin/conversations/@conv.Id" class="savi-btn savi-btn-sm" style="text-decoration: none;">
                                    Inspect Transcript &rarr;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <!-- Memory Tab -->
        @if (ActiveTab == "memory")
        {
            @if (Details.MemoryItems.Count == 0)
            {
                <div class="savi-glass-panel" style="padding: 40px; text-align: center; color: var(--savi-text-dim); font-size: 0.85rem;">
                    No memory items stored for this operator.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var mem in Details.MemoryItems)
                    {
                        <div class="savi-glass-panel" style="padding: 16px; border-color: var(--savi-border-subtle);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <span class="savi-badge" style="color: #b784f6; border-color: rgba(183, 132, 246, 0.4); background: rgba(183, 132, 246, 0.1); font-size: 0.65rem;">
                                    @mem.Type
                                </span>
                                <span style="font-size: 0.72rem; color: var(--savi-text-dim);">@mem.CreatedAt.ToString("g")</span>
                            </div>
                            <div style="font-size: 0.85rem; color: var(--savi-text-primary); line-height: 1.5; margin-bottom: 8px;">@mem.Content</div>
                            <div style="font-size: 0.7rem; color: var(--savi-text-dim);">Importance: @mem.Importance | Confidence: @mem.Confidence</div>
                        </div>
                    }
                </div>
            }
        }

        <!-- Tasks Tab -->
        @if (ActiveTab == "tasks")
        {
            @if (Details.Tasks.Count == 0)
            {
                <div class="savi-glass-panel" style="padding: 40px; text-align: center; color: var(--savi-text-dim); font-size: 0.85rem;">
                    No tasks registered for this operator.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var task in Details.Tasks)
                    {
                        <div class="savi-glass-panel" style="padding: 16px; border-color: var(--savi-border-subtle);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                <span style="font-weight: 700; color: var(--savi-text-primary); font-size: 0.92rem;">@task.Title</span>
                                <span class="savi-badge" style="font-size: 0.65rem;">
                                    @task.State
                                </span>
                            </div>
                            <div style="font-size: 0.8rem; color: var(--savi-text-secondary); margin-bottom: 8px;">@task.Description</div>
                            <div style="font-size: 0.7rem; color: var(--savi-text-dim);">Progress: @task.ProgressPercentage% | Created: @task.CreatedAt.ToString("g")</div>
                        </div>
                    }
                </div>
            }
        }

        <!-- Audit Tab -->
        @if (ActiveTab == "audit")
        {
            @if (Details.RecentAuditLogs.Count == 0)
            {
                <div class="savi-glass-panel" style="padding: 40px; text-align: center; color: var(--savi-text-dim); font-size: 0.85rem;">
                    No specific audit trail entries for this operator.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    @foreach (var audit in Details.RecentAuditLogs)
                    {
                        <div class="savi-glass-panel" style="padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; border-color: var(--savi-border-subtle); background: rgba(7, 11, 20, 0.5);">
                            <div>
                                <span style="color: var(--savi-cyan); font-weight: 700; font-size: 0.8rem;">@audit.Action</span>
                                <span style="color: var(--savi-text-secondary); margin-left: 10px; font-size: 0.78rem;">@audit.Details</span>
                            </div>
                            <span style="font-size: 0.7rem; color: var(--savi-text-dim); white-space: nowrap; margin-left: 16px;">@audit.Timestamp.ToString("g")</span>
                        </div>
                    }
                </div>
            }
        }
    }
</div>

@code {
    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private AdminUserDetailsDto? Details;
    private bool IsLoading = true;
    private string ActiveTab = "conversations";

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        try
        {
            Details = await AdminService.GetUserDetailsAsync(UserId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching user details: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }
}
