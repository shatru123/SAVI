@page "/admin/conversations/{ConversationId}"
@attribute [Authorize(Roles = "Owner")]
@inject IAdminService AdminService
@inject NavigationManager Navigation

<PageTitle>SAVI — Transcript Inspection [@ConversationId]</PageTitle>

<div class="savi-glass-panel savi-hud-bracket" style="padding: 24px; min-height: calc(100vh - 80px); box-sizing: border-box;">
    <!-- Header Navigation -->
    <div style="border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 18px; margin-bottom: 22px;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <a href="/admin/users" style="font-size: 0.75rem; color: var(--savi-cyan); text-decoration: none; font-family: var(--savi-font);">&larr; Operators</a>
            @if (Conversation?.UserId != null)
            {
                <span style="color: var(--savi-text-dim); font-size: 0.75rem;">/</span>
                <a href="/admin/users/@Conversation.UserId" style="font-size: 0.75rem; color: var(--savi-text-secondary); text-decoration: none; font-family: var(--savi-font);">@(Conversation.UserDisplayName ?? "Operator")</a>
            }
            <span style="color: var(--savi-text-dim); font-size: 0.75rem;">/</span>
            <span style="font-size: 0.75rem; color: var(--savi-text-secondary); font-family: var(--savi-font);">Transcript</span>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
            <div>
                <h1 class="savi-glow-text" style="margin: 0; font-size: 1.35rem; font-weight: 800; letter-spacing: 2px;">
                    @(Conversation?.Title ?? "Conversation Inspection")
                </h1>
                <div style="font-size: 0.78rem; color: var(--savi-text-secondary); margin-top: 6px; font-family: var(--savi-font);">
                    Operator: <span style="color: var(--savi-cyan); font-weight: 700;">@(Conversation?.UserDisplayName ?? "Unknown")</span> | 
                    Session ID: <span style="color: var(--savi-text-dim);">@ConversationId</span> |
                    Created: <span style="color: var(--savi-text-primary);">@(Conversation?.CreatedAt.ToString("g") ?? "-")</span>
                </div>
            </div>

            <!-- Prominent Read-Only Banner -->
            <div class="savi-glass-panel" style="padding: 10px 16px; border-color: rgba(255, 170, 0, 0.4); background: rgba(255, 170, 0, 0.08); display: flex; align-items: center; gap: 10px; color: #ffaa00;">
                <span style="font-size: 1.2rem;">⚠️</span>
                <div>
                    <div style="font-size: 0.76rem; font-weight: 800; letter-spacing: 1px;">READ-ONLY INSPECTION CONTEXT</div>
                    <div style="font-size: 0.68rem; color: rgba(255, 170, 0, 0.8);">Input submission &amp; voice controls strictly disabled</div>
                </div>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div style="text-align: center; padding: 60px 20px; color: var(--savi-cyan); font-family: var(--savi-font);">
            <div style="display: inline-block; width: 28px; height: 28px; border: 2px solid var(--savi-cyan); border-top-color: transparent; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 12px;"></div>
            <div style="font-size: 0.85rem; letter-spacing: 1.5px;">DECRYPTING SESSION TRANSCRIPT...</div>
        </div>
    }
    else if (Conversation == null)
    {
        <div class="savi-glass-panel" style="padding: 40px; text-align: center; border-color: rgba(255, 0, 85, 0.4); background: rgba(255, 0, 85, 0.05);">
            <p style="color: #ff6688; font-size: 0.88rem; margin-bottom: 12px;">Conversation transcript could not be located.</p>
            <a href="/admin/users" class="savi-btn savi-btn-sm" style="text-decoration: none;">Return to Operator Registry</a>
        </div>
    }
    else if (Conversation.Messages.Count == 0)
    {
        <div class="savi-glass-panel" style="padding: 40px; text-align: center; color: var(--savi-text-dim); font-size: 0.85rem;">
            This session contains no conversational turns.
        </div>
    }
    else
    {
        <!-- Transcript Feed -->
        <div style="display: flex; flex-direction: column; gap: 16px; max-width: 900px; margin: 0 auto; padding-bottom: 24px;">
            @foreach (var msg in Conversation.Messages)
            {
                <div style="display: flex; justify-content: @(msg.Role == MessageRole.User ? "flex-end" : "flex-start");">
                    <div class="savi-glass-panel" style="max-width: 85%; padding: 16px 20px; border-radius: var(--savi-radius-md); @(msg.Role == MessageRole.User 
                        ? "background: rgba(0, 153, 255, 0.12); border-color: rgba(0, 153, 255, 0.35); border-bottom-right-radius: 2px;" 
                        : "background: var(--savi-bg-glass); border-color: var(--savi-border-subtle); border-bottom-left-radius: 2px;")">
                        
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px solid @(msg.Role == MessageRole.User ? "rgba(0, 153, 255, 0.25)" : "var(--savi-border-subtle)");">
                            <span style="font-size: 0.72rem; font-family: var(--savi-font); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: @(msg.Role == MessageRole.User ? "var(--savi-cyan)" : "#b784f6");">
                                @(msg.Role == MessageRole.User ? (Conversation.UserDisplayName ?? "Operator") : "SAVI Core Intelligence")
                            </span>
                            <span style="font-size: 0.68rem; color: var(--savi-text-dim); font-family: var(--savi-font);">
                                @msg.Timestamp.ToLocalTime().ToString("t")
                            </span>
                        </div>

                        <!-- Content -->
                        <div style="font-size: 0.88rem; font-family: var(--savi-font); white-space: pre-wrap; line-height: 1.6; color: var(--savi-text-primary);">
                            @msg.Content
                        </div>

                        <!-- Tool Executions Inspection -->
                        @if (msg.ToolExecutions != null && msg.ToolExecutions.Count > 0)
                        {
                            <div style="margin-top: 12px; padding-top: 8px; border-top: 1px solid var(--savi-border-subtle);">
                                <span style="font-size: 0.68rem; color: var(--savi-text-dim); text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 6px;">Tools Invoked:</span>
                                <div style="display: flex; flex-direction: column; gap: 4px;">
                                    @foreach (var tool in msg.ToolExecutions)
                                    {
                                        <div style="font-size: 0.72rem; font-family: var(--savi-font); color: var(--savi-text-secondary); background: rgba(7, 11, 20, 0.6); padding: 4px 8px; border-radius: var(--savi-radius-sm); border: 1px solid var(--savi-border-subtle); display: flex; justify-content: space-between;">
                                            <span style="color: var(--savi-cyan); font-weight: 700;">@tool.ToolName</span>
                                            <span style="color: @(tool.Success ? "var(--savi-success)" : "var(--savi-danger)");">@(tool.Success ? "SUCCESS" : "FAILED")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Sources Inspection -->
                        @if (msg.Sources != null && msg.Sources.Count > 0)
                        {
                            <div style="margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--savi-border-subtle);">
                                <span style="font-size: 0.68rem; color: var(--savi-text-dim); text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 6px;">Verified Sources:</span>
                                <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                    @foreach (var src in msg.Sources)
                                    {
                                        <span class="savi-badge" style="font-size: 0.65rem; color: #00bbff; border-color: rgba(0, 187, 255, 0.3); background: rgba(0, 187, 255, 0.08);">
                                            @src.Title
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string ConversationId { get; set; } = string.Empty;

    private AdminConversationDetailDto? Conversation;
    private bool IsLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        try
        {
            Conversation = await AdminService.GetConversationDetailsForAdminAsync(ConversationId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching conversation details: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }
}
