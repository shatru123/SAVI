@page "/admin/conversations/{ConversationId}"
@attribute [Authorize(Roles = "Owner")]
@inject IAdminService AdminService
@inject NavigationManager Navigation

<PageTitle>SAVI — Transcript Inspection [@ConversationId]</PageTitle>

<div class="space-y-6">
    <!-- Header Navigation -->
    <div class="border-b border-cyber-border/40 pb-4">
        <div class="flex items-center gap-2 mb-2">
            <a href="/admin/users" class="text-xs font-mono text-cyber-cyan hover:underline">&larr; Operators</a>
            @if (Conversation?.UserId != null)
            {
                <span class="text-gray-500 font-mono text-xs">/</span>
                <a href="/admin/users/@Conversation.UserId" class="text-xs font-mono text-gray-400 hover:text-white">@(Conversation.UserDisplayName ?? "Operator")</a>
            }
            <span class="text-gray-500 font-mono text-xs">/</span>
            <span class="text-xs font-mono text-gray-400">Transcript</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold font-rajdhani text-white tracking-wide">
                    @(Conversation?.Title ?? "Conversation Inspection")
                </h1>
                <p class="text-xs font-mono text-gray-400 mt-1">
                    Operator: <span class="text-cyber-cyan font-semibold">@(Conversation?.UserDisplayName ?? "Unknown")</span> | 
                    Session ID: <span class="text-gray-500">@ConversationId</span> |
                    Created: <span class="text-gray-300">@(Conversation?.CreatedAt.ToString("g") ?? "-")</span>
                </p>
            </div>

            <!-- Prominent Read-Only Banner -->
            <div class="px-4 py-2 rounded-xl border border-amber-500/50 bg-amber-950/30 text-amber-300 text-xs font-mono flex items-center gap-2 shadow-lg shadow-amber-950/20">
                <svg class="w-5 h-5 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <div>
                    <div class="font-bold tracking-wider">READ-ONLY INSPECTION CONTEXT</div>
                    <div class="text-[10px] text-amber-400/80">Input submission & voice controls strictly disabled</div>
                </div>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="p-12 text-center text-cyber-cyan font-mono text-sm">
            <div class="inline-block animate-spin h-6 w-6 border-2 border-cyber-cyan border-t-transparent rounded-full mb-3"></div>
            <div>DECRYPTING SESSION TRANSCRIPT...</div>
        </div>
    }
    else if (Conversation == null)
    {
        <div class="p-8 text-center border border-red-500/40 bg-red-950/20 rounded-xl">
            <p class="text-red-300 font-mono text-sm">Conversation transcript could not be located.</p>
            <a href="/admin/users" class="mt-4 inline-block text-xs font-mono text-cyber-cyan underline">Return to Operator Registry</a>
        </div>
    }
    else if (Conversation.Messages.Count == 0)
    {
        <div class="p-8 text-center border border-cyber-border/40 rounded-xl bg-cyber-card/30 text-gray-400 font-mono text-xs">
            This session contains no conversational turns.
        </div>
    }
    else
    {
        <!-- Transcript Feed -->
        <div class="space-y-4 max-w-4xl mx-auto pb-12">
            @foreach (var msg in Conversation.Messages)
            {
                <div class="flex @(msg.Role == MessageRole.User ? "justify-end" : "justify-start")">
                    <div class="max-w-[85%] rounded-2xl p-4 @(msg.Role == MessageRole.User 
                        ? "bg-cyber-cyan/10 border border-cyber-cyan/30 text-white rounded-br-sm" 
                        : "bg-cyber-card border border-cyber-border text-gray-200 rounded-bl-sm")">
                        
                        <div class="flex items-center justify-between gap-4 mb-2 pb-1 border-b @(msg.Role == MessageRole.User ? "border-cyber-cyan/20" : "border-cyber-border/30")">
                            <span class="text-[11px] font-mono font-bold uppercase @(msg.Role == MessageRole.User ? "text-cyber-cyan" : "text-purple-400")">
                                @(msg.Role == MessageRole.User ? (Conversation.UserDisplayName ?? "Operator") : "SAVI Core Intelligence")
                            </span>
                            <span class="text-[10px] font-mono text-gray-500">
                                @msg.Timestamp.ToLocalTime().ToString("t")
                            </span>
                        </div>

                        <!-- Content -->
                        <div class="text-sm font-mono whitespace-pre-wrap leading-relaxed">
                            @msg.Content
                        </div>

                        <!-- Tool Executions Inspection -->
                        @if (msg.ToolExecutions != null && msg.ToolExecutions.Count > 0)
                        {
                            <div class="mt-3 pt-2 border-t border-cyber-border/30 space-y-1">
                                <span class="text-[10px] font-mono text-gray-500 uppercase tracking-wider block">Tools Invoked:</span>
                                @foreach (var tool in msg.ToolExecutions)
                                {
                                    <div class="text-[11px] font-mono text-gray-400 bg-cyber-darker/60 px-2 py-1 rounded border border-cyber-border/30">
                                        <span class="text-cyber-cyan font-semibold">@tool.ToolName</span>: @(tool.Success ? "Success" : "Failed")
                                    </div>
                                }
                            </div>
                        }

                        <!-- Sources Inspection -->
                        @if (msg.Sources != null && msg.Sources.Count > 0)
                        {
                            <div class="mt-2 pt-2 border-t border-cyber-border/30 flex flex-wrap gap-1">
                                <span class="text-[10px] font-mono text-gray-500 uppercase tracking-wider block w-full">Verified Sources:</span>
                                @foreach (var src in msg.Sources)
                                {
                                    <span class="text-[10px] font-mono text-blue-400 bg-blue-950/40 px-2 py-0.5 rounded border border-blue-500/20">
                                        @src.Title
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string ConversationId { get; set; } = string.Empty;

    private AdminConversationDetailDto? Conversation;
    private bool IsLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        try
        {
            Conversation = await AdminService.GetConversationDetailsForAdminAsync(ConversationId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching conversation details: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }
}
