@page "/admin"
@attribute [Authorize(Roles = "Owner")]
@inject IAdminService AdminService
@inject NavigationManager Navigation

<PageTitle>SAVI — Owner Command Console</PageTitle>

<div class="savi-glass-panel savi-hud-bracket" style="padding: 24px; min-height: calc(100vh - 80px); box-sizing: border-box;">
    <!-- Top Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 18px; margin-bottom: 22px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--savi-cyan); box-shadow: 0 0 8px var(--savi-cyan);"></span>
                <span class="savi-badge" style="color: var(--savi-cyan); border-color: var(--savi-border-glow); font-size: 0.65rem; letter-spacing: 1px;">
                    CLEARANCE: LEVEL 1 (OWNER)
                </span>
            </div>
            <h1 class="savi-glow-text" style="margin: 0; font-size: 1.45rem; font-weight: 800; letter-spacing: 2px;">
                SYSTEM COMMAND CONSOLE
            </h1>
            <div style="font-size: 0.78rem; color: var(--savi-text-secondary); margin-top: 4px;">
                Autonomous multi-agent platform telemetry, operator governance, and audit records.
            </div>
        </div>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <a href="/admin/users" class="savi-btn" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                <span>👥</span>
                <span>Manage Operators</span>
            </a>
            <a href="/admin/audit" class="savi-btn" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                <span>🛡️</span>
                <span>Security Audit</span>
            </a>
        </div>
    </div>

    @if (IsLoading)
    {
        <div style="text-align: center; padding: 60px 20px; color: var(--savi-cyan); font-family: var(--savi-font);">
            <div class="inline-block animate-spin" style="display: inline-block; width: 28px; height: 28px; border: 2px solid var(--savi-cyan); border-top-color: transparent; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 12px;"></div>
            <div style="font-size: 0.85rem; letter-spacing: 1.5px;">SYNCHRONIZING PLATFORM TELEMETRY...</div>
        </div>
    }
    else if (Metrics != null)
    {
        <!-- Metrics 4-Card HUD Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px;">
            <!-- Registered Operators -->
            <div class="savi-glass-panel" style="padding: 18px 20px; border-color: var(--savi-border-subtle); display: flex; flex-direction: column; justify-content: space-between;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <span style="font-size: 0.68rem; color: var(--savi-text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">
                        Registered Operators
                    </span>
                    <span style="font-size: 1.2rem;">👤</span>
                </div>
                <div class="savi-glow-text" style="font-size: 2.2rem; font-weight: 800; line-height: 1;">
                    @Metrics.TotalUsers
                </div>
                <div style="font-size: 0.72rem; color: var(--savi-success); margin-top: 10px; display: flex; align-items: center; gap: 6px;">
                    <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--savi-success);"></span>
                    <span>@Metrics.ActiveUsers active accounts</span>
                </div>
            </div>

            <!-- Conversations -->
            <div class="savi-glass-panel" style="padding: 18px 20px; border-color: var(--savi-border-subtle); display: flex; flex-direction: column; justify-content: space-between;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <span style="font-size: 0.68rem; color: var(--savi-text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">
                        Conversations
                    </span>
                    <span style="font-size: 1.2rem;">💬</span>
                </div>
                <div class="savi-glow-text" style="font-size: 2.2rem; font-weight: 800; line-height: 1; color: #b784f6; text-shadow: 0 0 10px rgba(183, 132, 246, 0.5);">
                    @Metrics.TotalConversations
                </div>
                <div style="font-size: 0.72rem; color: var(--savi-text-secondary); margin-top: 10px;">
                    <span>@Metrics.TotalMessages turns recorded</span>
                </div>
            </div>

            <!-- Memory Subsystem -->
            <div class="savi-glass-panel" style="padding: 18px 20px; border-color: var(--savi-border-subtle); display: flex; flex-direction: column; justify-content: space-between;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <span style="font-size: 0.68rem; color: var(--savi-text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">
                        Memory Nodes
                    </span>
                    <span style="font-size: 1.2rem;">🧠</span>
                </div>
                <div class="savi-glow-text" style="font-size: 2.2rem; font-weight: 800; line-height: 1; color: #00bbff; text-shadow: 0 0 10px rgba(0, 187, 255, 0.5);">
                    @Metrics.TotalMemoryItems
                </div>
                <div style="font-size: 0.72rem; color: var(--savi-text-secondary); margin-top: 10px;">
                    <span>Cross-session knowledge facts</span>
                </div>
            </div>

            <!-- System Status -->
            <div class="savi-glass-panel" style="padding: 18px 20px; border-color: var(--savi-border-subtle); display: flex; flex-direction: column; justify-content: space-between;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <span style="font-size: 0.68rem; color: var(--savi-text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">
                        Agent Engine
                    </span>
                    <span style="font-size: 1.2rem;">⚡</span>
                </div>
                <div class="savi-glow-text" style="font-size: 2rem; font-weight: 800; line-height: 1; color: var(--savi-success); text-shadow: 0 0 10px rgba(0, 255, 170, 0.5);">
                    @Metrics.SystemStatus
                </div>
                <div style="font-size: 0.72rem; color: var(--savi-text-secondary); margin-top: 10px;">
                    <span>@Metrics.ProviderCount deterministic providers</span>
                </div>
            </div>
        </div>

        <!-- 2-Column Section: Recent Operators & Recent Audits -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px;">
            <!-- Recent Operators List -->
            <div class="savi-glass-panel" style="padding: 18px;">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 10px; margin-bottom: 14px;">
                    <div style="font-weight: 700; font-size: 0.95rem; color: var(--savi-text-primary); display: flex; align-items: center; gap: 8px;">
                        <span>👥</span>
                        <span>RECENT OPERATORS</span>
                    </div>
                    <a href="/admin/users" style="font-size: 0.72rem; color: var(--savi-cyan); text-decoration: none;">
                        View All &rarr;
                    </a>
                </div>

                @if (RecentUsers.Count == 0)
                {
                    <div style="text-align: center; padding: 24px; color: var(--savi-text-dim); font-size: 0.78rem;">
                        No operators registered yet.
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        @foreach (var user in RecentUsers)
                        {
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: rgba(7, 11, 20, 0.5); border: 1px solid var(--savi-border-subtle); border-radius: var(--savi-radius-sm); transition: all 0.2s;">
                                <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
                                    <div style="width: 32px; height: 32px; border-radius: 50%; background: rgba(0, 240, 255, 0.1); border: 1px solid var(--savi-cyan); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold; color: var(--savi-cyan); flex-shrink: 0;">
                                        @(user.DisplayName.FirstOrDefault())
                                    </div>
                                    <div style="min-width: 0;">
                                        <div style="font-size: 0.82rem; font-weight: 700; color: var(--savi-text-primary); display: flex; align-items: center; gap: 8px;">
                                            <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@user.DisplayName</span>
                                            <span class="savi-badge" style="font-size: 0.58rem; padding: 1px 5px; @(user.Role == "Owner" ? "color: #ffaa00; border-color: rgba(255,170,0,0.4);" : "color: var(--savi-cyan); border-color: var(--savi-border-subtle);")">
                                                @user.Role
                                            </span>
                                        </div>
                                        <div style="font-size: 0.7rem; color: var(--savi-text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            @user.Email
                                        </div>
                                    </div>
                                </div>

                                <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                                    <span style="font-size: 0.68rem; color: var(--savi-text-dim);">@user.ConversationCount chats</span>
                                    <a href="/admin/users/@user.Id" class="savi-btn savi-btn-sm" style="padding: 3px 8px; font-size: 0.7rem; text-decoration: none;" title="Inspect Operator">
                                        Inspect
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Recent Security Audit Trail -->
            <div class="savi-glass-panel" style="padding: 18px;">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 10px; margin-bottom: 14px;">
                    <div style="font-weight: 700; font-size: 0.95rem; color: var(--savi-text-primary); display: flex; align-items: center; gap: 8px;">
                        <span>🛡️</span>
                        <span>SECURITY &amp; AUDIT TRAIL</span>
                    </div>
                    <a href="/admin/audit" style="font-size: 0.72rem; color: var(--savi-cyan); text-decoration: none;">
                        View All &rarr;
                    </a>
                </div>

                @if (RecentAudits.Count == 0)
                {
                    <div style="text-align: center; padding: 24px; color: var(--savi-text-dim); font-size: 0.78rem;">
                        No audit events recorded yet.
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        @foreach (var audit in RecentAudits)
                        {
                            <div style="padding: 10px 12px; background: rgba(7, 11, 20, 0.5); border: 1px solid var(--savi-border-subtle); border-radius: var(--savi-radius-sm); font-size: 0.74rem;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <span style="color: var(--savi-cyan); font-weight: 700;">@audit.Action</span>
                                    <span style="color: var(--savi-text-dim); font-size: 0.65rem;">@audit.Timestamp.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                                </div>
                                <div style="color: var(--savi-text-secondary); font-size: 0.72rem; line-height: 1.3;">
                                    @audit.Details
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
@@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
</style>

@code {
    private PlatformMetricsDto? Metrics;
    private List<AdminUserSummaryDto> RecentUsers = new();
    private List<AuditLogEntry> RecentAudits = new();
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Metrics = await AdminService.GetPlatformMetricsAsync();
            var users = await AdminService.GetUsersAsync(null, 1, 5);
            RecentUsers = users.ToList();
            var logs = await AdminService.GetAuditLogsAsync(5);
            RecentAudits = logs.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading admin metrics: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }
}
