@page "/admin/audit"
@attribute [Authorize(Roles = "Owner")]
@inject IAdminService AdminService
@inject NavigationManager Navigation

<PageTitle>SAVI — Security Audit Logs</PageTitle>

<div class="savi-glass-panel savi-hud-bracket" style="padding: 24px; min-height: calc(100vh - 80px); box-sizing: border-box;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 18px; margin-bottom: 22px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                <a href="/admin" style="font-size: 0.75rem; color: var(--savi-cyan); text-decoration: none; font-family: var(--savi-font);">&larr; Console</a>
                <span style="color: var(--savi-text-dim); font-size: 0.75rem;">/</span>
                <span style="font-size: 0.75rem; color: var(--savi-text-secondary); font-family: var(--savi-font);">Security Audit</span>
            </div>
            <h1 class="savi-glow-text" style="margin: 0; font-size: 1.45rem; font-weight: 800; letter-spacing: 2px;">
                SECURITY &amp; SYSTEM AUDIT TRAIL
            </h1>
            <div style="font-size: 0.78rem; color: var(--savi-text-secondary); margin-top: 4px;">
                Cryptographically immutable log of user activity, privilege escalation checks, and administrative interventions.
            </div>
        </div>

        <button @onclick="LoadLogs" class="savi-btn" style="display: inline-flex; align-items: center; gap: 8px;">
            <span>🔄</span>
            <span>Refresh Log</span>
        </button>
    </div>

    @if (IsLoading)
    {
        <div style="text-align: center; padding: 60px 20px; color: var(--savi-cyan); font-family: var(--savi-font);">
            <div style="display: inline-block; width: 28px; height: 28px; border: 2px solid var(--savi-cyan); border-top-color: transparent; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 12px;"></div>
            <div style="font-size: 0.85rem; letter-spacing: 1.5px;">RETRIEVING AUDIT ARCHIVE...</div>
        </div>
    }
    else if (Logs.Count == 0)
    {
        <div class="savi-glass-panel" style="text-align: center; padding: 48px 24px; color: var(--savi-text-dim); font-size: 0.85rem;">
            No security audit entries recorded.
        </div>
    }
    else
    {
        <div class="savi-glass-panel" style="overflow-x: auto; border-color: var(--savi-border-subtle);">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.78rem; font-family: var(--savi-font);">
                <thead>
                    <tr style="background: rgba(7, 11, 20, 0.85); border-bottom: 1px solid var(--savi-border-subtle); color: var(--savi-text-dim); text-transform: uppercase; letter-spacing: 1px; font-size: 0.7rem;">
                        <th style="padding: 12px 16px;">Timestamp</th>
                        <th style="padding: 12px 16px;">Action</th>
                        <th style="padding: 12px 16px;">Subsystem</th>
                        <th style="padding: 12px 16px;">Clearance</th>
                        <th style="padding: 12px 16px;">Status</th>
                        <th style="padding: 12px 16px;">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Logs)
                    {
                        <tr style="border-bottom: 1px solid rgba(0, 240, 255, 0.08); transition: background 0.15s;" onmouseover="this.style.background='rgba(0, 240, 255, 0.04)'" onmouseout="this.style.background='transparent'">
                            <td style="padding: 12px 16px; color: var(--savi-text-dim); white-space: nowrap;">
                                @log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                            </td>
                            <td style="padding: 12px 16px; font-weight: 700; color: var(--savi-cyan);">
                                @log.Action
                            </td>
                            <td style="padding: 12px 16px; color: var(--savi-text-secondary);">
                                @(string.IsNullOrEmpty(log.ToolName) ? "System" : log.ToolName)
                            </td>
                            <td style="padding: 12px 16px;">
                                <span class="savi-badge" style="font-size: 0.62rem; padding: 2px 6px; @(log.PermissionLevel == PermissionLevel.Dangerous ? "color: #ff6688; border-color: rgba(255, 0, 85, 0.4); background: rgba(255, 0, 85, 0.1);" : "color: var(--savi-cyan); border-color: var(--savi-border-subtle);")">
                                    @log.PermissionLevel
                                </span>
                            </td>
                            <td style="padding: 12px 16px;">
                                <span class="savi-badge" style="font-size: 0.62rem; padding: 2px 6px; @(log.Status == "Success" || log.Status == "Executed" ? "color: var(--savi-success); border-color: rgba(0, 255, 170, 0.3); background: rgba(0, 255, 170, 0.08);" : "color: var(--savi-warning); border-color: rgba(255, 170, 0, 0.3); background: rgba(255, 170, 0, 0.08);")">
                                    @log.Status
                                </span>
                            </td>
                            <td style="padding: 12px 16px; color: var(--savi-text-primary); max-width: 420px; word-break: break-word;">
                                @log.Details
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<AuditLogEntry> Logs = new();
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        IsLoading = true;
        try
        {
            var results = await AdminService.GetAuditLogsAsync(100);
            Logs = results.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading audit logs: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }
}
