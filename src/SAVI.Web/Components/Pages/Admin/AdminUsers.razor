@page "/admin/users"
@attribute [Authorize(Roles = "Owner")]
@inject IAdminService AdminService
@inject NavigationManager Navigation

<PageTitle>SAVI — Operator Directory</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-cyber-border/40 pb-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/admin" class="text-xs font-mono text-cyber-cyan hover:underline">&larr; Console</a>
                <span class="text-gray-500 font-mono text-xs">/</span>
                <span class="text-xs font-mono text-gray-400">Operators</span>
            </div>
            <h1 class="text-3xl font-bold font-rajdhani text-white tracking-wide">
                OPERATOR REGISTRY
            </h1>
            <p class="text-sm font-mono text-gray-400">
                Directory of registered users, workspace isolation status, and credentials governance.
            </p>
        </div>

        <!-- Search Bar -->
        <div class="relative w-full sm:w-72">
            <input type="text"
                   @bind="SearchQuery"
                   @bind:event="oninput"
                   @bind:after="OnSearchChanged"
                   placeholder="Filter by name, email, or ID..."
                   class="w-full pl-9 pr-4 py-2 rounded-lg bg-cyber-card border border-cyber-border focus:border-cyber-cyan focus:outline-none text-white text-xs font-mono placeholder-gray-500" />
            <svg class="w-4 h-4 text-gray-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ActionMessage))
    {
        <div class="p-3 rounded-lg border border-cyber-cyan/40 bg-cyber-cyan/10 text-cyber-cyan text-xs font-mono flex items-center justify-between">
            <span>@ActionMessage</span>
            <button @onclick="() => ActionMessage = null" class="text-cyber-cyan hover:text-white">&times;</button>
        </div>
    }

    @if (IsLoading)
    {
        <div class="p-12 text-center text-cyber-cyan font-mono text-sm">
            <div class="inline-block animate-spin h-6 w-6 border-2 border-cyber-cyan border-t-transparent rounded-full mb-3"></div>
            <div>QUERYING USER REGISTRY...</div>
        </div>
    }
    else if (Users.Count == 0)
    {
        <div class="p-12 text-center border border-cyber-border/40 rounded-xl bg-cyber-card/30">
            <p class="text-gray-400 font-mono text-sm">No operators match the query "@SearchQuery".</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto border border-cyber-border/40 rounded-xl bg-cyber-card/40">
            <table class="w-full text-left font-mono text-xs">
                <thead class="bg-cyber-darker/80 text-gray-400 uppercase tracking-wider border-b border-cyber-border/40">
                    <tr>
                        <th class="p-3.5">Operator</th>
                        <th class="p-3.5">Role</th>
                        <th class="p-3.5">Status</th>
                        <th class="p-3.5">Conversations</th>
                        <th class="p-3.5">Memory</th>
                        <th class="p-3.5">Tasks</th>
                        <th class="p-3.5">Registered</th>
                        <th class="p-3.5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-cyber-border/20">
                    @foreach (var user in Users)
                    {
                        <tr class="hover:bg-cyber-darker/40 transition-colors">
                            <td class="p-3.5">
                                <div class="font-bold text-white text-sm font-rajdhani">@user.DisplayName</div>
                                <div class="text-gray-400 text-[11px]">@user.Email</div>
                                <div class="text-gray-600 text-[10px]">ID: @user.Id[..Math.Min(8, user.Id.Length)]...</div>
                            </td>
                            <td class="p-3.5">
                                <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold @(user.Role == "Owner" ? "bg-amber-500/20 text-amber-300 border border-amber-500/40" : "bg-blue-500/20 text-blue-300 border border-blue-500/40")">
                                    @user.Role
                                </span>
                            </td>
                            <td class="p-3.5">
                                @if (user.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] text-emerald-400 bg-emerald-500/10 border border-emerald-500/30">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] text-red-400 bg-red-500/10 border border-red-500/30">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span> Deactivated
                                    </span>
                                }
                            </td>
                            <td class="p-3.5 text-gray-300">@user.ConversationCount</td>
                            <td class="p-3.5 text-gray-300">@user.MemoryCount</td>
                            <td class="p-3.5 text-gray-300">@user.TaskCount</td>
                            <td class="p-3.5 text-gray-400">@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="p-3.5 text-right space-x-2">
                                <a href="/admin/users/@user.Id" class="inline-block px-2.5 py-1 rounded bg-cyber-card border border-cyber-border hover:border-cyber-cyan text-white hover:text-cyber-cyan transition-colors" title="Inspect user workspace">
                                    Inspect &rarr;
                                </a>

                                @if (user.Role != "Owner")
                                {
                                    @if (user.IsActive)
                                    {
                                        <button @onclick="() => ToggleUserStatus(user.Id, false)" class="px-2.5 py-1 rounded bg-red-500/10 border border-red-500/30 text-red-300 hover:bg-red-500/20 transition-colors" title="Disable user access">
                                            Disable
                                        </button>
                                    }
                                    else
                                    {
                                        <button @onclick="() => ToggleUserStatus(user.Id, true)" class="px-2.5 py-1 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 hover:bg-emerald-500/20 transition-colors" title="Reactivate user access">
                                            Activate
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<AdminUserSummaryDto> Users = new();
    private string SearchQuery = string.Empty;
    private bool IsLoading = true;
    private string? ActionMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task OnSearchChanged()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        IsLoading = true;
        try
        {
            var result = await AdminService.GetUsersAsync(SearchQuery, 1, 50);
            Users = result.ToList();
        }
        catch (Exception ex)
        {
            ActionMessage = $"Error loading operators: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ToggleUserStatus(string userId, bool active)
    {
        try
        {
            var success = await AdminService.SetUserStatusAsync(userId, active);
            if (success)
            {
                ActionMessage = $"User status successfully updated to {(active ? "Active" : "Deactivated")}.";
                await LoadUsers();
            }
        }
        catch (Exception ex)
        {
            ActionMessage = $"Failed to update status: {ex.Message}";
        }
    }
}
