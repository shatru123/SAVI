@page "/admin/users"
@attribute [Authorize(Roles = "Owner")]
@inject IAdminService AdminService
@inject NavigationManager Navigation

<PageTitle>SAVI — Operator Directory</PageTitle>

<div class="savi-glass-panel savi-hud-bracket" style="padding: 24px; min-height: calc(100vh - 80px); box-sizing: border-box;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 18px; margin-bottom: 22px; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                <a href="/admin" style="font-size: 0.75rem; color: var(--savi-cyan); text-decoration: none; font-family: var(--savi-font);">&larr; Console</a>
                <span style="color: var(--savi-text-dim); font-size: 0.75rem;">/</span>
                <span style="font-size: 0.75rem; color: var(--savi-text-secondary); font-family: var(--savi-font);">Operators</span>
            </div>
            <h1 class="savi-glow-text" style="margin: 0; font-size: 1.45rem; font-weight: 800; letter-spacing: 2px;">
                OPERATOR REGISTRY
            </h1>
            <div style="font-size: 0.78rem; color: var(--savi-text-secondary); margin-top: 4px;">
                Directory of registered users, workspace isolation status, and credentials governance.
            </div>
        </div>

        <!-- Search Bar -->
        <div style="position: relative; width: 100%; max-width: 320px;">
            <div style="display: flex; align-items: center; background: rgba(7, 11, 20, 0.7); border: 1px solid var(--savi-border-subtle); border-radius: var(--savi-radius-sm); padding: 6px 12px; gap: 8px; transition: border-color 0.2s;">
                <span style="color: var(--savi-cyan); font-size: 0.85rem;">🔍</span>
                <input type="text"
                       @bind="SearchQuery"
                       @bind:event="oninput"
                       @bind:after="OnSearchChanged"
                       placeholder="Filter by name, email, or ID..."
                       class="savi-input-field"
                       style="font-size: 0.78rem; width: 100%;" />
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ActionMessage))
    {
        <div class="savi-glass-panel" style="padding: 10px 16px; margin-bottom: 20px; border-color: var(--savi-border-glow); background: rgba(0, 240, 255, 0.08); display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; color: var(--savi-cyan);">
            <span>@ActionMessage</span>
            <button @onclick="() => ActionMessage = null" style="background: none; border: none; color: var(--savi-cyan); font-size: 1.1rem; cursor: pointer; line-height: 1;">&times;</button>
        </div>
    }

    @if (IsLoading)
    {
        <div style="text-align: center; padding: 60px 20px; color: var(--savi-cyan); font-family: var(--savi-font);">
            <div style="display: inline-block; width: 28px; height: 28px; border: 2px solid var(--savi-cyan); border-top-color: transparent; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 12px;"></div>
            <div style="font-size: 0.85rem; letter-spacing: 1.5px;">QUERYING USER REGISTRY...</div>
        </div>
    }
    else if (Users.Count == 0)
    {
        <div class="savi-glass-panel" style="text-align: center; padding: 48px 24px; color: var(--savi-text-dim); font-size: 0.85rem;">
            No operators match the query "@SearchQuery".
        </div>
    }
    else
    {
        <div class="savi-glass-panel" style="overflow-x: auto; border-color: var(--savi-border-subtle);">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.78rem; font-family: var(--savi-font);">
                <thead>
                    <tr style="background: rgba(7, 11, 20, 0.85); border-bottom: 1px solid var(--savi-border-subtle); color: var(--savi-text-dim); text-transform: uppercase; letter-spacing: 1px; font-size: 0.7rem;">
                        <th style="padding: 12px 16px;">Operator</th>
                        <th style="padding: 12px 16px;">Role</th>
                        <th style="padding: 12px 16px;">Status</th>
                        <th style="padding: 12px 16px;">Conversations</th>
                        <th style="padding: 12px 16px;">Memory</th>
                        <th style="padding: 12px 16px;">Tasks</th>
                        <th style="padding: 12px 16px;">Registered</th>
                        <th style="padding: 12px 16px; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Users)
                    {
                        <tr style="border-bottom: 1px solid rgba(0, 240, 255, 0.08); transition: background 0.15s;" onmouseover="this.style.background='rgba(0, 240, 255, 0.04)'" onmouseout="this.style.background='transparent'">
                            <td style="padding: 12px 16px;">
                                <div style="font-weight: 700; color: var(--savi-text-primary); font-size: 0.85rem;">@user.DisplayName</div>
                                <div style="color: var(--savi-text-secondary); font-size: 0.72rem;">@user.Email</div>
                                <div style="color: var(--savi-text-dim); font-size: 0.65rem;">ID: @user.Id[..Math.Min(8, user.Id.Length)]...</div>
                            </td>
                            <td style="padding: 12px 16px;">
                                <span class="savi-badge" style="font-size: 0.62rem; padding: 2px 6px; @(user.Role == "Owner" ? "color: #ffaa00; border-color: rgba(255, 170, 0, 0.4); background: rgba(255, 170, 0, 0.1);" : "color: var(--savi-cyan); border-color: var(--savi-border-subtle);")">
                                    @user.Role
                                </span>
                            </td>
                            <td style="padding: 12px 16px;">
                                @if (user.IsActive)
                                {
                                    <span style="display: inline-flex; align-items: center; gap: 6px; color: var(--savi-success); font-size: 0.72rem;">
                                        <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--savi-success); box-shadow: 0 0 6px var(--savi-success);"></span>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span style="display: inline-flex; align-items: center; gap: 6px; color: var(--savi-danger); font-size: 0.72rem;">
                                        <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--savi-danger); box-shadow: 0 0 6px var(--savi-danger);"></span>
                                        Deactivated
                                    </span>
                                }
                            </td>
                            <td style="padding: 12px 16px; color: var(--savi-text-secondary);">@user.ConversationCount</td>
                            <td style="padding: 12px 16px; color: var(--savi-text-secondary);">@user.MemoryCount</td>
                            <td style="padding: 12px 16px; color: var(--savi-text-secondary);">@user.TaskCount</td>
                            <td style="padding: 12px 16px; color: var(--savi-text-dim);">@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td style="padding: 12px 16px; text-align: right;">
                                <div style="display: inline-flex; gap: 6px; align-items: center;">
                                    <a href="/admin/users/@user.Id" class="savi-btn savi-btn-sm" style="text-decoration: none;" title="Inspect user workspace">
                                        Inspect &rarr;
                                    </a>

                                    @if (user.Role != "Owner")
                                    {
                                        @if (user.IsActive)
                                        {
                                            <button @onclick="() => ToggleUserStatus(user.Id, false)" class="savi-btn savi-btn-sm savi-btn-danger" title="Disable user access">
                                                Disable
                                            </button>
                                        }
                                        else
                                        {
                                            <button @onclick="() => ToggleUserStatus(user.Id, true)" class="savi-btn savi-btn-sm" style="border-color: rgba(0, 255, 170, 0.4); color: var(--savi-success); background: rgba(0, 255, 170, 0.08);" title="Reactivate user access">
                                                Activate
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<AdminUserSummaryDto> Users = new();
    private string SearchQuery = string.Empty;
    private bool IsLoading = true;
    private string? ActionMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task OnSearchChanged()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        IsLoading = true;
        try
        {
            var result = await AdminService.GetUsersAsync(SearchQuery, 1, 50);
            Users = result.ToList();
        }
        catch (Exception ex)
        {
            ActionMessage = $"Error loading operators: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ToggleUserStatus(string userId, bool active)
    {
        try
        {
            var success = await AdminService.SetUserStatusAsync(userId, active);
            if (success)
            {
                ActionMessage = $"User status successfully updated to {(active ? "Active" : "Deactivated")}.";
                await LoadUsers();
            }
        }
        catch (Exception ex)
        {
            ActionMessage = $"Failed to update status: {ex.Message}";
        }
    }
}
