@page "/register"
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>SAVI — Operator Onboarding</PageTitle>

<div class="savi-auth-container" style="min-height: 85vh; display: flex; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;">
    <div class="savi-glass-panel savi-hud-bracket" style="width: 100%; max-width: 520px; padding: 32px 28px; box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6), inset 0 0 20px rgba(0, 240, 255, 0.08); border-color: var(--savi-border-glow); position: relative; overflow: hidden;">
        
        <!-- Top Holographic Ambient Light -->
        <div style="position: absolute; top: -60px; left: 50%; transform: translateX(-50%); width: 240px; height: 120px; background: radial-gradient(circle, rgba(0, 240, 255, 0.25) 0%, transparent 70%); pointer-events: none;"></div>

        <!-- Brand Header -->
        <div style="text-align: center; margin-bottom: 24px; position: relative; z-index: 1;">
            <div style="display: inline-flex; justify-content: center; margin-bottom: 12px;">
                <SaviLogo Size="48" Animated="true" />
            </div>
            <h1 class="savi-glow-text" style="font-size: 1.5rem; font-weight: 800; letter-spacing: 3px; margin: 0; font-family: var(--savi-font);">
                OPERATOR ONBOARDING
            </h1>
            <div style="font-size: 0.68rem; color: var(--savi-text-dim); letter-spacing: 1.5px; margin-top: 4px; text-transform: uppercase;">
                Provision Sovereign Personal Assistant Workspace
            </div>
        </div>

        <!-- Auth Navigation Tabs -->
        <div style="display: flex; border-bottom: 1px solid var(--savi-border-subtle); margin-bottom: 22px; font-size: 0.78rem;">
            <a href="/login" style="flex: 1; text-align: center; padding-bottom: 10px; color: var(--savi-text-dim); text-decoration: none; letter-spacing: 1px; transition: color 0.2s;" onmouseover="this.style.color='var(--savi-text-primary)'" onmouseout="this.style.color='var(--savi-text-dim)'">
                SIGN IN
            </a>
            <div style="flex: 1; text-align: center; padding-bottom: 10px; border-bottom: 2px solid var(--savi-cyan); color: var(--savi-cyan); font-weight: bold; letter-spacing: 1px;">
                NEW OPERATOR
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div style="margin-bottom: 18px; padding: 10px 14px; border-radius: var(--savi-radius-sm); background: rgba(255, 0, 85, 0.12); border: 1px solid rgba(255, 0, 85, 0.4); color: #ff80a0; font-size: 0.75rem; display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 1rem; line-height: 1;">⚠️</span>
                <span style="flex: 1;">@ErrorMessage</span>
            </div>
        }

        <!-- Registration Form -->
        <form @onsubmit="HandleRegister" style="display: flex; flex-direction: column; gap: 14px;">
            <div>
                <label style="display: block; font-size: 0.68rem; color: var(--savi-text-secondary); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 5px;">
                    Operator Full Name / Call Sign
                </label>
                <div style="position: relative;">
                    <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 0.85rem; color: var(--savi-text-dim);">👤</span>
                    <input type="text"
                           @bind="DisplayName"
                           required
                           autocomplete="name"
                           placeholder="e.g. Rahul Sharma or Shatrughna Ambhore"
                           style="width: 100%; box-sizing: border-box; padding: 10px 12px 10px 36px; background: rgba(7, 11, 20, 0.7); border: 1px solid var(--savi-border-subtle); border-radius: var(--savi-radius-sm); color: var(--savi-text-primary); font-family: var(--savi-font); font-size: 0.82rem; outline: none; transition: all 0.2s;"
                           onfocus="this.style.borderColor='var(--savi-cyan)'; this.style.boxShadow='0 0 10px rgba(0, 240, 255, 0.3)';"
                           onblur="this.style.borderColor='var(--savi-border-subtle)'; this.style.boxShadow='none';" />
                </div>
            </div>

            <div>
                <label style="display: block; font-size: 0.68rem; color: var(--savi-text-secondary); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 5px;">
                    Email Address
                </label>
                <div style="position: relative;">
                    <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 0.85rem; color: var(--savi-text-dim);">✉</span>
                    <input type="email"
                           @bind="Email"
                           required
                           autocomplete="email"
                           placeholder="operator@savi.net"
                           style="width: 100%; box-sizing: border-box; padding: 10px 12px 10px 36px; background: rgba(7, 11, 20, 0.7); border: 1px solid var(--savi-border-subtle); border-radius: var(--savi-radius-sm); color: var(--savi-text-primary); font-family: var(--savi-font); font-size: 0.82rem; outline: none; transition: all 0.2s;"
                           onfocus="this.style.borderColor='var(--savi-cyan)'; this.style.boxShadow='0 0 10px rgba(0, 240, 255, 0.3)';"
                           onblur="this.style.borderColor='var(--savi-border-subtle)'; this.style.boxShadow='none';" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div>
                    <label style="display: block; font-size: 0.68rem; color: var(--savi-text-secondary); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 5px;">
                        Passcode (min. 6)
                    </label>
                    <div style="position: relative;">
                        <input type="password"
                               @bind="Password"
                               required
                               minlength="6"
                               autocomplete="new-password"
                               placeholder="••••••••"
                               style="width: 100%; box-sizing: border-box; padding: 10px 12px; background: rgba(7, 11, 20, 0.7); border: 1px solid var(--savi-border-subtle); border-radius: var(--savi-radius-sm); color: var(--savi-text-primary); font-family: var(--savi-font); font-size: 0.82rem; outline: none; transition: all 0.2s;"
                               onfocus="this.style.borderColor='var(--savi-cyan)'; this.style.boxShadow='0 0 10px rgba(0, 240, 255, 0.3)';"
                               onblur="this.style.borderColor='var(--savi-border-subtle)'; this.style.boxShadow='none';" />
                    </div>
                </div>

                <div>
                    <label style="display: block; font-size: 0.68rem; color: var(--savi-text-secondary); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 5px;">
                        Confirm Passcode
                    </label>
                    <div style="position: relative;">
                        <input type="password"
                               @bind="ConfirmPassword"
                               required
                               minlength="6"
                               autocomplete="new-password"
                               placeholder="••••••••"
                               style="width: 100%; box-sizing: border-box; padding: 10px 12px; background: rgba(7, 11, 20, 0.7); border: 1px solid var(--savi-border-subtle); border-radius: var(--savi-radius-sm); color: var(--savi-text-primary); font-family: var(--savi-font); font-size: 0.82rem; outline: none; transition: all 0.2s;"
                               onfocus="this.style.borderColor='var(--savi-cyan)'; this.style.boxShadow='0 0 10px rgba(0, 240, 255, 0.3)';"
                               onblur="this.style.borderColor='var(--savi-border-subtle)'; this.style.boxShadow='none';" />
                    </div>
                </div>
            </div>

            <!-- Admin / Owner Setup Option -->
            <div style="margin-top: 4px; border: 1px solid @(IsAdminRegistration ? "rgba(255, 170, 0, 0.5)" : "var(--savi-border-subtle)"); border-radius: var(--savi-radius-sm); padding: 12px; background: @(IsAdminRegistration ? "rgba(255, 170, 0, 0.08)" : "rgba(11, 19, 34, 0.4)"); transition: all 0.2s;">
                <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 0.95rem;">@(IsAdminRegistration ? "🛡️" : "⚙️")</span>
                        <div>
                            <div style="font-size: 0.74rem; font-weight: bold; color: @(IsAdminRegistration ? "#ffaa00" : "var(--savi-text-primary)");">
                                Register as System Owner / Admin
                            </div>
                            <div style="font-size: 0.65rem; color: var(--savi-text-dim);">
                                Requires platform Master Setup Key
                            </div>
                        </div>
                    </div>
                    <input type="checkbox" @bind="IsAdminRegistration" style="accent-color: #ffaa00;" />
                </label>

                @if (IsAdminRegistration)
                {
                    <div style="margin-top: 10px; padding-top: 10px; border-top: 1px dashed rgba(255, 170, 0, 0.3);">
                        <label style="display: block; font-size: 0.65rem; color: #ffaa00; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">
                            Master Setup Key / Passkey
                        </label>
                        <input type="password"
                               @bind="AdminKey"
                               placeholder="Default: SaviOwner@2026 or SAVI_OWNER_KEY"
                               style="width: 100%; box-sizing: border-box; padding: 8px 10px; background: rgba(7, 11, 20, 0.85); border: 1px solid rgba(255, 170, 0, 0.4); border-radius: var(--savi-radius-sm); color: #ffcc66; font-family: var(--savi-font); font-size: 0.78rem; outline: none;" />
                        <div style="font-size: 0.62rem; color: var(--savi-text-dim); margin-top: 4px;">
                            * Grants access to Platform Telemetry, Operator Registry &amp; Diagnostics.
                        </div>
                    </div>
                }
            </div>

            <button type="submit"
                    disabled="@IsSubmitting"
                    class="savi-btn savi-btn-primary"
                    style="width: 100%; padding: 12px; font-size: 0.88rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin-top: 6px; display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer;">
                @if (IsSubmitting)
                {
                    <span class="inline-block animate-spin" style="display: inline-block; animation: spin 1s linear infinite;">↻</span>
                    <span>CREATING WORKSPACE...</span>
                }
                else
                {
                    <span>CREATE OPERATOR ACCOUNT &rarr;</span>
                }
            </button>
        </form>

        <!-- System Architecture Footnote -->
        <div style="margin-top: 24px; padding-top: 14px; border-top: 1px solid var(--savi-border-subtle); display: flex; justify-content: space-between; align-items: center; font-size: 0.65rem; color: var(--savi-text-dim);">
            <span>SAVI v1.0 • .NET 10</span>
            <span>END-TO-END DATA ISOLATION</span>
        </div>
    </div>
</div>

<style>
@@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
</style>

@code {
    private string DisplayName { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;
    private bool IsAdminRegistration { get; set; } = false;
    private string AdminKey { get; set; } = string.Empty;
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task HandleRegister()
    {
        if (IsSubmitting) return;

        if (Password != ConfirmPassword)
        {
            ErrorMessage = "Passwords do not match.";
            return;
        }

        if (Password.Length < 6)
        {
            ErrorMessage = "Password must be at least 6 characters long.";
            return;
        }

        if (IsAdminRegistration && string.IsNullOrWhiteSpace(AdminKey))
        {
            ErrorMessage = "Master Setup Key is required for Admin registration.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            var result = await JS.InvokeAsync<AuthResponse>("saviAuthRegister", new
            {
                displayName = DisplayName,
                email = Email,
                password = Password,
                confirmPassword = ConfirmPassword,
                adminKey = IsAdminRegistration ? AdminKey : null
            });

            if (result != null && result.Success)
            {
                await JS.InvokeVoidAsync("saviNavigateTo", "/");
            }
            else
            {
                ErrorMessage = result?.Message ?? "Registration failed. Please review your input.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Registration failed: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private class AuthResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public string? Redirect { get; set; }
    }
}
