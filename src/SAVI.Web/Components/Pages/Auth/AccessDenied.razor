@page "/access-denied"

<PageTitle>SAVI — Access Denied</PageTitle>

<div style="display: flex; align-items: center; justify-content: center; min-height: calc(100vh - 120px); padding: 20px; box-sizing: border-box;">
    <div class="savi-glass-panel savi-hud-bracket" style="max-width: 480px; width: 100%; padding: 36px 28px; text-align: center; border-color: rgba(255, 0, 85, 0.4); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6), inset 0 0 20px rgba(255, 0, 85, 0.08);">
        <!-- Icon -->
        <div style="width: 64px; height: 64px; margin: 0 auto 20px; border-radius: 50%; border: 1px solid rgba(255, 0, 85, 0.5); background: rgba(255, 0, 85, 0.1); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; box-shadow: 0 0 16px rgba(255, 0, 85, 0.25);">
            🔒
        </div>

        <div style="margin-bottom: 14px;">
            <span class="savi-badge" style="color: #ff6688; border-color: rgba(255, 0, 85, 0.4); background: rgba(255, 0, 85, 0.1); font-size: 0.68rem; letter-spacing: 1.5px;">
                CLEARANCE LEVEL 0
            </span>
        </div>

        <h1 style="margin: 0 0 12px; font-size: 1.5rem; font-weight: 800; letter-spacing: 2px; color: var(--savi-danger); text-shadow: 0 0 14px rgba(255, 0, 85, 0.6);">
            ACCESS RESTRICTED
        </h1>

        <p style="color: var(--savi-text-secondary); font-size: 0.85rem; font-family: var(--savi-font); line-height: 1.6; margin: 0 0 28px;">
            The requested operational sector requires elevated <span style="color: #ff6688; font-weight: 700;">OWNER / ADMINISTRATOR</span> clearance. Your current account does not have permission to inspect or modify these assets.
        </p>

        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a href="/" class="savi-btn" style="flex: 1; min-width: 140px; text-decoration: none;">
                Return to Terminal
            </a>
            <a href="/login" class="savi-btn savi-btn-danger" style="flex: 1; min-width: 140px; text-decoration: none;">
                Switch Account
            </a>
        </div>
    </div>
</div>

