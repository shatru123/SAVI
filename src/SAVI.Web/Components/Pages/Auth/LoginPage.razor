@page "/login"
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>SAVI — Terminal Authentication</PageTitle>

<div class="min-h-[85vh] flex items-center justify-center p-4">
    <div class="max-w-md w-full border border-cyber-cyan/30 bg-cyber-darker/95 backdrop-blur-md rounded-xl p-8 shadow-2xl shadow-cyan-950/20 relative overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-cyber-cyan/10 via-transparent to-transparent pointer-events-none"></div>

        <div class="relative z-10">
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="w-14 h-14 mx-auto mb-4 rounded-xl border border-cyber-cyan/50 bg-cyber-cyan/10 flex items-center justify-center text-cyber-cyan shadow-lg shadow-cyber-cyan/20">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.099.99-4.328.99-6.632 0-6.075-4.925-11-11-11S-2 5.425-2 11.5" />
                    </svg>
                </div>
                <h1 class="text-2xl font-bold font-rajdhani text-white tracking-wider">
                    SAVI AUTHENTICATION
                </h1>
                <p class="text-xs font-mono text-gray-400 mt-1 uppercase tracking-widest">
                    Identity Verification Protocol
                </p>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="mb-6 p-3 rounded-lg border border-red-500/40 bg-red-950/40 text-red-300 text-xs font-mono flex items-center gap-2">
                    <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span>@ErrorMessage</span>
                </div>
            }

            <form @onsubmit="HandleLogin" class="space-y-4">
                <div>
                    <label class="block text-xs font-mono text-gray-300 uppercase tracking-wider mb-1.5">
                        Email Address
                    </label>
                    <input type="email" 
                           @bind="Email" 
                           required 
                           autocomplete="email"
                           placeholder="user@example.com"
                           class="w-full px-4 py-2.5 rounded-lg bg-cyber-card border border-cyber-border focus:border-cyber-cyan focus:outline-none text-white text-sm font-mono placeholder-gray-500 transition-colors" />
                </div>

                <div>
                    <label class="block text-xs font-mono text-gray-300 uppercase tracking-wider mb-1.5">
                        Password
                    </label>
                    <input type="password" 
                           @bind="Password" 
                           required 
                           autocomplete="current-password"
                           placeholder="••••••••••••"
                           class="w-full px-4 py-2.5 rounded-lg bg-cyber-card border border-cyber-border focus:border-cyber-cyan focus:outline-none text-white text-sm font-mono placeholder-gray-500 transition-colors" />
                </div>

                <div class="flex items-center justify-between pt-1">
                    <label class="flex items-center gap-2 text-xs font-mono text-gray-400 cursor-pointer">
                        <input type="checkbox" @bind="RememberMe" class="rounded bg-cyber-card border-cyber-border text-cyber-cyan focus:ring-0" />
                        Remember device
                    </label>
                </div>

                <button type="submit" 
                        disabled="@IsSubmitting"
                        class="w-full mt-2 py-3 px-4 rounded-lg bg-cyber-cyan text-cyber-dark font-rajdhani font-bold text-base tracking-wider uppercase hover:bg-cyan-300 transition-all shadow-lg shadow-cyber-cyan/20 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2">
                    @if (IsSubmitting)
                    {
                        <svg class="animate-spin h-4 w-4 text-cyber-dark" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                        </svg>
                        <span>Authenticating...</span>
                    }
                    else
                    {
                        <span>Initialize Session</span>
                    }
                </button>
            </form>

            <div class="mt-8 pt-6 border-t border-cyber-border/40 text-center">
                <p class="text-xs font-mono text-gray-400">
                    New operator? 
                    <a href="/register" class="text-cyber-cyan hover:underline font-semibold ml-1">
                        Register Account &rarr;
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private bool RememberMe { get; set; } = true;
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task HandleLogin()
    {
        if (IsSubmitting) return;

        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            var result = await JS.InvokeAsync<AuthResponse>("saviAuthLogin", new
            {
                email = Email,
                password = Password,
                rememberMe = RememberMe
            });

            if (result != null && result.Success)
            {
                var target = !string.IsNullOrEmpty(ReturnUrl) ? ReturnUrl : "/";
                await JS.InvokeVoidAsync("saviNavigateTo", target);
            }
            else
            {
                ErrorMessage = result?.Message ?? "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Authentication failed: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private class AuthResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public string? Redirect { get; set; }
    }
}
