@page "/login"
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>SAVI — Terminal Authentication</PageTitle>

<div class="savi-auth-container" style="min-height: 85vh; display: flex; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;">
    <div class="savi-glass-panel savi-hud-bracket" style="width: 100%; max-width: 480px; padding: 32px 28px; box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6), inset 0 0 20px rgba(0, 240, 255, 0.08); border-color: var(--savi-border-glow); position: relative; overflow: hidden;">
        
        <!-- Top Holographic Ambient Light -->
        <div style="position: absolute; top: -60px; left: 50%; transform: translateX(-50%); width: 240px; height: 120px; background: radial-gradient(circle, rgba(0, 240, 255, 0.25) 0%, transparent 70%); pointer-events: none;"></div>

        <!-- Brand Header -->
        <div style="text-align: center; margin-bottom: 24px; position: relative; z-index: 1;">
            <div style="display: inline-flex; justify-content: center; margin-bottom: 12px;">
                <SaviLogo Size="48" Animated="true" />
            </div>
            <h1 class="savi-glow-text" style="font-size: 1.5rem; font-weight: 800; letter-spacing: 3px; margin: 0; font-family: var(--savi-font);">
                SAVI TERMINAL ACCESS
            </h1>
            <div style="font-size: 0.68rem; color: var(--savi-text-dim); letter-spacing: 1.5px; margin-top: 4px; text-transform: uppercase;">
                Neural Interface • Identity Verification
            </div>
        </div>

        <!-- Auth Navigation Tabs -->
        <div style="display: flex; border-bottom: 1px solid var(--savi-border-subtle); margin-bottom: 22px; font-size: 0.78rem;">
            <div style="flex: 1; text-align: center; padding-bottom: 10px; border-bottom: 2px solid var(--savi-cyan); color: var(--savi-cyan); font-weight: bold; letter-spacing: 1px;">
                SIGN IN
            </div>
            <a href="/register" style="flex: 1; text-align: center; padding-bottom: 10px; color: var(--savi-text-dim); text-decoration: none; letter-spacing: 1px; transition: color 0.2s;" onmouseover="this.style.color='var(--savi-text-primary)'" onmouseout="this.style.color='var(--savi-text-dim)'">
                NEW OPERATOR
            </a>
        </div>

        <!-- Owner Quick Fill Access Banner -->
        <div style="background: rgba(0, 240, 255, 0.05); border: 1px dashed var(--savi-border-subtle); border-radius: var(--savi-radius-sm); padding: 10px 12px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
            <div style="font-size: 0.7rem; color: var(--savi-text-secondary); line-height: 1.4;">
                <span style="color: var(--savi-cyan); font-weight: bold;">⚡ Owner Access:</span>
                <span style="color: var(--savi-text-dim); display: block;">Default administrator credentials</span>
            </div>
            <button type="button" @onclick="FillOwnerCredentials" class="savi-btn savi-btn-sm" style="padding: 4px 10px; font-size: 0.68rem; letter-spacing: 0.5px; color: var(--savi-cyan); border-color: var(--savi-cyan);" title="Auto-fill default owner credentials">
                Auto-Fill Owner
            </button>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div style="margin-bottom: 18px; padding: 10px 14px; border-radius: var(--savi-radius-sm); background: rgba(255, 0, 85, 0.12); border: 1px solid rgba(255, 0, 85, 0.4); color: #ff80a0; font-size: 0.75rem; display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 1rem; line-height: 1;">⚠️</span>
                <span style="flex: 1;">@ErrorMessage</span>
            </div>
        }

        <!-- Form -->
        <form @onsubmit="HandleLogin" style="display: flex; flex-direction: column; gap: 16px;">
            <div>
                <label style="display: block; font-size: 0.68rem; color: var(--savi-text-secondary); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 6px;">
                    Operator Email
                </label>
                <div style="position: relative;">
                    <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 0.85rem; color: var(--savi-text-dim);">✉</span>
                    <input type="email"
                           @bind="Email"
                           required
                           autocomplete="email"
                           placeholder="operator@savi.net"
                           style="width: 100%; box-sizing: border-box; padding: 10px 12px 10px 36px; background: rgba(7, 11, 20, 0.7); border: 1px solid var(--savi-border-subtle); border-radius: var(--savi-radius-sm); color: var(--savi-text-primary); font-family: var(--savi-font); font-size: 0.82rem; outline: none; transition: all 0.2s;"
                           onfocus="this.style.borderColor='var(--savi-cyan)'; this.style.boxShadow='0 0 10px rgba(0, 240, 255, 0.3)';"
                           onblur="this.style.borderColor='var(--savi-border-subtle)'; this.style.boxShadow='none';" />
                </div>
            </div>

            <div>
                <label style="display: block; font-size: 0.68rem; color: var(--savi-text-secondary); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 6px;">
                    Passcode / Credential Key
                </label>
                <div style="position: relative;">
                    <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 0.85rem; color: var(--savi-text-dim);">🔑</span>
                    <input type="@(ShowPassword ? "text" : "password")"
                           @bind="Password"
                           required
                           autocomplete="current-password"
                           placeholder="••••••••••••"
                           style="width: 100%; box-sizing: border-box; padding: 10px 40px 10px 36px; background: rgba(7, 11, 20, 0.7); border: 1px solid var(--savi-border-subtle); border-radius: var(--savi-radius-sm); color: var(--savi-text-primary); font-family: var(--savi-font); font-size: 0.82rem; outline: none; transition: all 0.2s;"
                           onfocus="this.style.borderColor='var(--savi-cyan)'; this.style.boxShadow='0 0 10px rgba(0, 240, 255, 0.3)';"
                           onblur="this.style.borderColor='var(--savi-border-subtle)'; this.style.boxShadow='none';" />
                    <button type="button" 
                            @onclick="() => ShowPassword = !ShowPassword" 
                            style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--savi-text-dim); cursor: pointer; font-size: 0.8rem; padding: 4px;"
                            title="@(ShowPassword ? "Hide Passcode" : "Show Passcode")">
                        @(ShowPassword ? "🙈" : "👁️")
                    </button>
                </div>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.72rem;">
                <label style="display: flex; align-items: center; gap: 6px; color: var(--savi-text-secondary); cursor: pointer;">
                    <input type="checkbox" @bind="RememberMe" style="accent-color: var(--savi-cyan);" />
                    <span>Persist session on this terminal</span>
                </label>
            </div>

            <button type="submit"
                    disabled="@IsSubmitting"
                    class="savi-btn savi-btn-primary"
                    style="width: 100%; padding: 12px; font-size: 0.88rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin-top: 6px; display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer;">
                @if (IsSubmitting)
                {
                    <span class="inline-block animate-spin" style="display: inline-block; animation: spin 1s linear infinite;">↻</span>
                    <span>AUTHENTICATING OPERATOR...</span>
                }
                else
                {
                    <span>INITIALIZE SESSION &rarr;</span>
                }
            </button>
        </form>

        <!-- System Architecture Footnote -->
        <div style="margin-top: 24px; padding-top: 14px; border-top: 1px solid var(--savi-border-subtle); display: flex; justify-content: space-between; align-items: center; font-size: 0.65rem; color: var(--savi-text-dim);">
            <span>SAVI v1.0 • .NET 10</span>
            <span>PROTECTED PROTOCOL</span>
        </div>
    </div>
</div>

<style>
@@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
</style>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private bool RememberMe { get; set; } = true;
    private bool ShowPassword { get; set; } = false;
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }

    private void FillOwnerCredentials()
    {
        Email = "ambhoreshatrughna@gmail.com";
        Password = "SaviOwner@2026";
        ErrorMessage = null;
    }

    private async Task HandleLogin()
    {
        if (IsSubmitting) return;

        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            var result = await JS.InvokeAsync<AuthResponse>("saviAuthLogin", new
            {
                email = Email,
                password = Password,
                rememberMe = RememberMe
            });

            if (result != null && result.Success)
            {
                var target = !string.IsNullOrEmpty(ReturnUrl) ? ReturnUrl : "/";
                await JS.InvokeVoidAsync("saviNavigateTo", target);
            }
            else
            {
                ErrorMessage = result?.Message ?? "Invalid credentials. Please verify your email and passcode.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Authentication error: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private class AuthResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public string? Redirect { get; set; }
    }
}
