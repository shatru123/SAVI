@page "/providers"
@using SAVI.Core.Enums
@inject IProviderRegistry ProviderRegistry
@inject IProviderDefinitionRepository ProviderDefinitionRepo
@inject HttpClient HttpClient

<PageTitle>SAVI — Provider Matrix & Intelligence</PageTitle>

<div class="savi-glass-panel savi-hud-bracket" style="padding: 24px; min-height: calc(100vh - 80px);">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 16px; margin-bottom: 20px; flex-wrap: wrap; gap: 14px;">
        <div style="flex: 1; min-width: 240px;">
            <h2 class="savi-glow-text" style="margin: 0; font-size: 1.25rem;">CAPABILITY PROVIDER REGISTRY & TELEMETRY</h2>
            <div style="font-size: 0.8rem; color: var(--savi-text-secondary); margin-top: 4px;">
                Model-independent capability architecture with dynamic scoring, circuit breaking, and parallel execution. Built-in providers are 100% free with zero mandatory cost.
            </div>
        </div>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <button class="savi-btn" @onclick="BenchmarkAllProviders" disabled="@_isBenchmarking">
                @(_isBenchmarking ? "⚡ Benchmarking..." : "⚡ Run Benchmark")
            </button>
            <button class="savi-btn" @onclick="RefreshHealth">⟳ Refresh</button>
            <button class="savi-btn" @onclick="() => _showAddModal = true">+ Add API</button>
        </div>
    </div>

    <!-- Provider Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 16px;">
        @foreach (var p in _providers)
        {
            <div class="savi-glass-panel" style="padding: 16px; border-color: @GetBorderColor(p); cursor: pointer; transition: transform 0.15s ease;"
                 @onclick="() => SelectProviderDetails(p)">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                    <div>
                        <div style="font-weight: bold; font-size: 0.95rem; color: var(--savi-text-primary);">@p.Name</div>
                        <div style="font-size: 0.72rem; color: var(--savi-text-dim); margin-top: 2px;">ID: @p.Id</div>
                    </div>

                    <span class="savi-badge" style="color: @GetStatusColor(p.CircuitState); border-color: @GetStatusBorder(p.CircuitState);">
                        ● @p.CircuitState
                    </span>
                </div>

                <!-- Classification Tags -->
                <div style="display: flex; gap: 6px; margin-bottom: 10px; flex-wrap: wrap;">
                    <span class="savi-badge" style="font-size: 0.65rem; background: rgba(0, 240, 255, 0.12); color: var(--savi-cyan); border-color: var(--savi-cyan);">
                        @GetCostClassificationBadge(p)
                    </span>
                    <span class="savi-badge" style="font-size: 0.65rem; background: rgba(0, 255, 170, 0.1); color: var(--savi-success); border-color: var(--savi-success);">
                        @p.Category
                    </span>
                </div>

                <!-- Metrics Grid -->
                <div style="font-size: 0.76rem; color: var(--savi-text-secondary); display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin: 8px 0; background: rgba(0,0,0,0.3); padding: 10px; border-radius: 4px;">
                    <div><strong>Capability:</strong> @p.Capability</div>
                    <div><strong>Authority:</strong> @(p.AuthorityLevel * 100)%</div>
                    <div><strong>Latency:</strong> @p.Latency.TotalMilliseconds.ToString("F0") ms</div>
                    <div><strong>Success:</strong> @((p.RollingSuccessRate * 100).ToString("F0"))%</div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
                    <span style="font-size: 0.7rem; color: var(--savi-text-dim);">Click for telemetry & details</span>
                    <button class="savi-btn" style="padding: 3px 10px; font-size: 0.75rem;" @onclick="() => TestProvider(p.Id)" @onclick:stopPropagation="true">
                        Test Ping
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Provider Details Modal -->
@if (_selectedDetail != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 9999;"
         @onclick="() => _selectedDetail = null">
        <div class="savi-glass-panel savi-hud-bracket" style="width: 550px; max-width: 90%; padding: 24px;" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--savi-border-subtle); padding-bottom: 12px; margin-bottom: 16px;">
                <div>
                    <h3 class="savi-glow-text" style="margin: 0; font-size: 1.15rem;">@_selectedDetail.Name</h3>
                    <div style="font-size: 0.75rem; color: var(--savi-text-dim); margin-top: 2px;">@_selectedDetail.Id</div>
                </div>
                <button class="savi-btn" style="padding: 2px 8px;" @onclick="() => _selectedDetail = null">✕</button>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; font-size: 0.82rem; margin-bottom: 16px;">
                <div><strong>Status:</strong> <span style="color: @GetStatusColor(_selectedDetail.CircuitState)">● @_selectedDetail.CircuitState</span></div>
                <div><strong>Classification:</strong> @GetCostClassificationBadge(_selectedDetail)</div>
                <div><strong>Category:</strong> @_selectedDetail.Category</div>
                <div><strong>Authority Level:</strong> @(_selectedDetail.AuthorityLevel * 100)%</div>
                <div><strong>Accuracy Rating:</strong> @(_selectedDetail.AccuracyScore * 100)%</div>
                <div><strong>Reliability Score:</strong> @(_selectedDetail.ReliabilityScore * 100)%</div>
                <div><strong>Typical Latency:</strong> @_selectedDetail.TypicalLatency.TotalMilliseconds.ToString("F0") ms</div>
                <div><strong>Rolling P95 Latency:</strong> @_selectedDetail.RollingP95Latency.TotalMilliseconds.ToString("F0") ms</div>
                <div><strong>Rolling Success Rate:</strong> @((_selectedDetail.RollingSuccessRate * 100).ToString("F0"))%</div>
                <div><strong>Timeout Limit:</strong> @_selectedDetail.Timeout.TotalMilliseconds.ToString("F0") ms</div>
                <div><strong>Supports Caching:</strong> @(_selectedDetail.SupportsCaching ? "✓ Yes" : "✗ No")</div>
                <div><strong>Supports Verification:</strong> @(_selectedDetail.SupportsVerification ? "✓ Yes" : "✗ No")</div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button class="savi-btn" @onclick="() => TestProvider(_selectedDetail.Id)">Run Diagnostic Ping</button>
                <button class="savi-btn" style="border-color: var(--savi-text-dim); color: var(--savi-text-secondary);" @onclick="() => _selectedDetail = null">Close</button>
            </div>
        </div>
    </div>
}

<!-- Add Generic Provider Modal -->
@if (_showAddModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 9999;">
        <div class="savi-glass-panel savi-hud-bracket" style="width: 520px; max-width: 90%; padding: 24px;">
            <h3 class="savi-glow-text" style="margin-top: 0;">Register Generic API Provider</h3>

            <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px;">
                <div>
                    <label style="font-size: 0.8rem; color: var(--savi-text-secondary); display: block; margin-bottom: 4px;">Provider Name</label>
                    <input type="text" class="savi-input-field" style="width: 100%; padding: 8px; border: 1px solid var(--savi-border-subtle); border-radius: 4px;"
                           @bind="_newName" placeholder="e.g. Open News Feed" />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <div>
                        <label style="font-size: 0.8rem; color: var(--savi-text-secondary); display: block; margin-bottom: 4px;">Capability</label>
                        <input type="text" class="savi-input-field" style="width: 100%; padding: 8px; border: 1px solid var(--savi-border-subtle); border-radius: 4px;"
                               @bind="_newCapability" placeholder="e.g. news" />
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: var(--savi-text-secondary); display: block; margin-bottom: 4px;">Method</label>
                        <select class="savi-input-field" style="width: 100%; padding: 8px; background: var(--savi-bg-surface); border: 1px solid var(--savi-border-subtle); border-radius: 4px;"
                                @bind="_newMethod">
                            <option value="GET">GET</option>
                            <option value="POST">POST</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label style="font-size: 0.8rem; color: var(--savi-text-secondary); display: block; margin-bottom: 4px;">Endpoint URL (SSRF Protected)</label>
                    <input type="text" class="savi-input-field" style="width: 100%; padding: 8px; border: 1px solid var(--savi-border-subtle); border-radius: 4px;"
                           @bind="_newEndpoint" placeholder="https://api.example.com/data?query={query}" />
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button class="savi-btn" style="border-color: var(--savi-text-dim); color: var(--savi-text-secondary);" @onclick="() => _showAddModal = false">Cancel</button>
                <button class="savi-btn" @onclick="SaveGenericProvider" disabled="@(string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newEndpoint))">Save Provider</button>
            </div>
        </div>
    </div>
}

@code {
    private List<ProviderMetadata> _providers = new();
    private ProviderMetadata? _selectedDetail = null;
    private bool _showAddModal = false;
    private bool _isBenchmarking = false;
    private string _newName = string.Empty;
    private string _newCapability = "generic";
    private string _newMethod = "GET";
    private string _newEndpoint = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadProviders();
    }

    private async Task LoadProviders()
    {
        _providers = (await ProviderRegistry.GetMetadataAsync()).ToList();
    }

    private async Task RefreshHealth()
    {
        if (ProviderRegistry is SAVI.Infrastructure.Providers.ProviderRegistry pr)
        {
            await pr.RefreshHealthAsync();
        }
        await LoadProviders();
    }

    private async Task BenchmarkAllProviders()
    {
        _isBenchmarking = true;
        StateHasChanged();
        try
        {
            if (ProviderRegistry is SAVI.Infrastructure.Providers.ProviderRegistry pr)
            {
                await pr.RefreshHealthAsync();
            }
            await LoadProviders();
        }
        finally
        {
            _isBenchmarking = false;
            StateHasChanged();
        }
    }

    private void SelectProviderDetails(ProviderMetadata p)
    {
        _selectedDetail = p;
    }

    private async Task TestProvider(string id)
    {
        var provider = ProviderRegistry.GetById(id);
        if (provider != null)
        {
            var sw = System.Diagnostics.Stopwatch.StartNew();
            var isHealthy = await provider.HealthCheckAsync();
            sw.Stop();

            var meta = _providers.FirstOrDefault(p => p.Id == id);
            if (meta != null)
            {
                var idx = _providers.IndexOf(meta);
                _providers[idx] = meta with
                {
                    IsHealthy = isHealthy,
                    CircuitState = isHealthy ? CircuitBreakerState.Healthy : CircuitBreakerState.Degraded,
                    Latency = sw.Elapsed
                };
                if (_selectedDetail?.Id == id)
                {
                    _selectedDetail = _providers[idx];
                }
                StateHasChanged();
            }
        }
    }

    private static string GetCostClassificationBadge(ProviderMetadata p)
    {
        return p.CostType switch
        {
            ProviderCostType.LocalZeroCost => "LOCAL",
            ProviderCostType.FreePublic => "PUBLIC FREE",
            ProviderCostType.OptionalKey => "OPTIONAL KEY",
            ProviderCostType.OptionalPaid => "OPTIONAL PAID",
            _ => "PUBLIC"
        };
    }

    private static string GetBorderColor(ProviderMetadata p)
    {
        return p.CircuitState switch
        {
            CircuitBreakerState.Healthy => "var(--savi-border-subtle)",
            CircuitBreakerState.Degraded => "rgba(255, 170, 0, 0.5)",
            CircuitBreakerState.Open => "rgba(255, 0, 85, 0.5)",
            _ => "var(--savi-border-subtle)"
        };
    }

    private static string GetStatusColor(CircuitBreakerState state)
    {
        return state switch
        {
            CircuitBreakerState.Healthy => "var(--savi-success)",
            CircuitBreakerState.Degraded => "var(--savi-warning)",
            CircuitBreakerState.HalfOpen => "var(--savi-cyan)",
            CircuitBreakerState.Open => "rgba(255, 0, 85, 0.9)",
            _ => "var(--savi-text-dim)"
        };
    }

    private static string GetStatusBorder(CircuitBreakerState state)
    {
        return state switch
        {
            CircuitBreakerState.Healthy => "rgba(0,255,170,0.3)",
            CircuitBreakerState.Degraded => "rgba(255,170,0,0.3)",
            CircuitBreakerState.HalfOpen => "rgba(0,240,255,0.3)",
            CircuitBreakerState.Open => "rgba(255,0,85,0.3)",
            _ => "rgba(255,255,255,0.1)"
        };
    }

    private async Task SaveGenericProvider()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newEndpoint)) return;

        var def = new ApiProviderDefinition
        {
            Id = Guid.NewGuid().ToString(),
            Name = _newName.Trim(),
            Capability = _newCapability.Trim(),
            Method = _newMethod,
            Endpoint = _newEndpoint.Trim(),
            IsEnabled = true,
            Priority = 100
        };

        await ProviderDefinitionRepo.AddAsync(def);
        var genProvider = new SAVI.Infrastructure.Providers.Generic.GenericHttpApiProvider(HttpClient, def);
        ProviderRegistry.Register(genProvider);

        _showAddModal = false;
        _newName = string.Empty;
        _newEndpoint = string.Empty;
        await LoadProviders();
    }
}
